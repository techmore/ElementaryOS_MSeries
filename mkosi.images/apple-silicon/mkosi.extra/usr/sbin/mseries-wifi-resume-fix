#!/bin/bash
# Wi-Fi resume recovery for Apple Silicon Broadcom parts (ported from
# omarchy-mac install/hardware/apple/fix-wifi-resume.sh; the systemd unit is
# unchanged, this script is rewritten for Ubuntu: modprobe + NetworkManager,
# no pacman helpers).
#
# The Broadcom firmware on Apple Silicon Macs can wedge across s2idle: scans
# fail with -52 and associations are rejected with status_code=16, which
# NetworkManager reports as a wrong password. Toggling the radio does not
# reset the chip firmware — only a driver reload clears it.
# Upstream: https://github.com/AsahiLinux/linux/issues/439
#
# Gate: aarch64 + BCM4378 (14e4:4425) / BCM4387 (14e4:4433) on PCI.
# BCM4388 (14e4:4434, M2 Max/Ultra) is deliberately excluded: observed to
# ride out s2idle without the wedge signature. T2 Intel Macs carry some of
# the same IDs over a different suspend path — hence the architecture gate.
set -euo pipefail
export LC_ALL=C

[[ $(uname -m) == "aarch64" ]] || exit 0
lspci -nn 2>/dev/null | grep -E "14e4:(4425|4433)" >/dev/null || exit 0

# Association rejections come from wpa_supplicant, which logs under its own unit - they never appear in
# the kernel log (journalctl -k), so counting them there could never match. Count them in the window
# since resume instead.
recent_rejections() {
  journalctl -b -u wpa_supplicant -u NetworkManager --since "-40 sec" --no-pager 2>/dev/null \
    | grep -cE "ASSOC-REJECT.*status_code=16|status 16" || true
}

wifi_connected() {
  nmcli -t -f TYPE,STATE device 2>/dev/null | grep -q '^wifi:connected'
}

reload_driver() {
  # NetworkManager and wpa_supplicant hold brcmfmac open ("Module brcmfmac is in use"), so stop them
  # first, reload the stack (brcmfmac_wcc depends on brcmfmac), then bring them back.
  systemctl stop NetworkManager.service wpa_supplicant.service || true
  modprobe -r brcmfmac_wcc brcmfmac || modprobe -r brcmfmac || true
  modprobe brcmfmac || true
  systemctl start wpa_supplicant.service || true
  systemctl start NetworkManager.service || true
}

main() {
  # Short backstop: give the driver a moment to recover on its own.
  sleep 15
  # A slow reconnect is not a wedge. Only act when Wi-Fi is still not connected AND the firmware has
  # been rejecting associations with status 16 since resume.
  local rejections
  rejections=$(recent_rejections)
  if (( rejections > 0 )) && ! wifi_connected; then
    logger -t mseries-wifi-resume-fix "reloading brcmfmac after resume ($rejections association rejections, Wi-Fi not connected)"
    reload_driver
  fi
}

main
