#!/bin/bash
# First-boot Apple Silicon Wi-Fi firmware provisioning (see
# mseries/FIRMWARE-WIFI.md). v1: detect the chip, report exactly which
# blobs are missing, and copy from installer handoff locations when they
# exist. Always exits 0 — Wi-Fi staying down must never fail the boot.
set -euo pipefail

FIRMWARE_DIR="${MSERIES_FIRMWARE_DIR:-/lib/firmware/brcm}"
# The ESP is mounted at /boot on an encrypted install and at /boot/efi on stock Asahi Alarm.
HANDOFF_DIRS=("${MSERIES_HANDOFF_DIR:-/boot/mseries-firmware}" /boot/efi/mseries-firmware /run/mseries/firmware)

log() { logger -t mseries-wifi-firmware "$@" || true; echo "mseries-wifi-firmware: $*" >&2; }

# Same Apple gate as the rest of the layer: aarch64 + apple, in device-tree.
if [[ $(uname -m) != "aarch64" ]]; then exit 0; fi
compatible="${MSERIES_APPLE_COMPATIBLE:-/proc/device-tree/compatible}"
if [[ -f $compatible ]] && ! grep -Faiq 'apple,' "$compatible"; then exit 0; fi
[[ -f $compatible ]] || exit 0

chip=""
pci=$(lspci -nn 2>/dev/null || true)   # not piped: grep -q under pipefail can SIGPIPE lspci
if grep -q "14e4:4425" <<<"$pci"; then chip="4378b1";
elif grep -q "14e4:4433" <<<"$pci"; then chip="4387c2"; fi
[[ -n $chip ]] || { log "no Apple Silicon Broadcom Wi-Fi found; nothing to do"; exit 0; }

base="brcmfmac${chip}-pcie"
# Presence check accepts both plain names (brcmfmac4387c2-pcie.bin) and
# Apple board-suffixed names (brcmfmac4387c2-pcie.apple,maldives.bin),
# which is what Asahi ships in /usr/lib/firmware/vendor/brcm/ and what the
# transform track copies into $FIRMWARE_DIR (all board variants).
have_blob() { # $1 = extension without dot
  compgen -G "$FIRMWARE_DIR/$base.$1" >/dev/null && return 0
  compgen -G "$FIRMWARE_DIR/$base.apple,*.$1" >/dev/null && return 0
  return 1
}
required=(bin clm_blob txcap_blob)
missing=()
for ext in "${required[@]}"; do
  have_blob "$ext" || missing+=("$base.$ext / $base.apple,<board>.$ext")
done
# NVRAM .txt name varies by module/antenna; any match counts.
if ! compgen -G "$FIRMWARE_DIR/$base*.txt" >/dev/null; then missing+=("$base-<module>.txt"); fi

if (( ${#missing[@]} == 0 )); then log "Apple Wi-Fi firmware present ($base)"; exit 0; fi

# Try installer handoff locations before giving up (accept exact or
# .apple,<board> names on both sides).
for dir in "${HANDOFF_DIRS[@]}"; do
  [[ -d $dir ]] || continue
  for ext in "${required[@]}"; do
    have_blob "$ext" && continue
    for cand in "$dir/$base.$ext" "$dir/$base.apple,"*".$ext"; do
      [[ -f $cand ]] && install -m 644 "$cand" "$FIRMWARE_DIR/" && log "provisioned $(basename "$cand") from $dir"
    done
  done
  for txt in "$dir/$base"*.txt; do
    [[ -f $txt ]] && install -m 644 "$txt" "$FIRMWARE_DIR/" && log "provisioned $(basename "$txt") from $dir"
  done
done

missing=()
for ext in "${required[@]}"; do
  have_blob "$ext" || missing+=("$base.$ext / $base.apple,<board>.$ext")
done
if ! compgen -G "$FIRMWARE_DIR/$base*.txt" >/dev/null; then missing+=("$base-<module>.txt"); fi

if (( ${#missing[@]} == 0 )); then log "Apple Wi-Fi firmware provisioned ($base)"; exit 0; fi
log "MISSING Apple Wi-Fi firmware in $FIRMWARE_DIR: ${missing[*]}. Copy them from macOS (see mseries/FIRMWARE-WIFI.md) into /boot/efi/mseries-firmware and reboot. Wi-Fi stays down until then."
exit 0
