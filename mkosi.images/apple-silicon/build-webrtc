#!/usr/bin/env bash
# Assemble the locked JS runtime once at image build time, never at user login.
set -euo pipefail
source_dir="$SRCDIR/mseries/webrtc"
runtime="$DESTDIR/usr/lib/mseries-webrtc"
node -e 'if (Number(process.versions.node.split(".")[0]) < 22) process.exit(1)'
install -d "$runtime/public"
install -m644 "$source_dir/"{server.mjs,input_bridge.py,package.json,package-lock.json} "$runtime/"
install -m644 "$source_dir"/public/* "$runtime/public/"
npm --prefix "$runtime" ci --omit=dev --ignore-scripts --no-audit --no-fund
install -Dm755 "$source_dir/open.py" "$DESTDIR/usr/bin/mseries-webrtc-open"
install -Dm644 "$source_dir/deploy/mseries-webrtc.service" "$DESTDIR/usr/lib/systemd/user/mseries-webrtc.service"
install -Dm644 "$source_dir/deploy/mseries-webrtc.desktop" "$DESTDIR/usr/share/applications/mseries-webrtc.desktop"
install -Dm644 "$source_dir/README.md" "$DESTDIR/usr/share/doc/mseries-webrtc/README.md"
install -Dm644 "$runtime/node_modules/ws/LICENSE" "$DESTDIR/usr/share/doc/mseries-webrtc/WS-LICENSE"
