#!/bin/bash
set -xeuo pipefail

# Avoid nesting Ubuntu's relocatable EFI wrapper inside the generated factory UKI.
if [[ -x /usr/libexec/mseries/prepare-uki-kernels ]]; then
    /usr/libexec/mseries/prepare-uki-kernels --root /
fi

fc-cache --force --really-force --system-only --verbose

glib-compile-schemas /usr/share/glib-2.0/schemas/

mkdir -p /var/usrlocal
ln -s /var/usrlocal /usr/local
cp -a /usr/local/. /var/usrlocal/
rm -rf /usr/local
ln -s /var/usrlocal /usr/local

# Check final package ownership after overlay application, before publication.
if [[ -x /usr/libexec/mseries/verify-video-driver-packaging ]]; then
    /usr/libexec/mseries/verify-video-driver-packaging
fi

# The final installed panel versions must match every locally patched plugin.
if [[ -x /usr/libexec/mseries/verify-panel-packages ]]; then
    /usr/libexec/mseries/verify-panel-packages --root /
fi

# Refresh after ExtraTrees merges the YouTube launcher/icon into the final image.
if [[ -f /usr/share/applications/mseries-brave-youtube.desktop ]]; then
    desktop-file-validate /usr/share/applications/mseries-brave-youtube.desktop
    update-desktop-database /usr/share/applications
    gtk-update-icon-cache --force --ignore-theme-index /usr/share/icons/hicolor
fi

# Both ARM64 consumers must contain the offline browser and its runtime libraries.
if [[ -f /usr/share/applications/mseries-brave-youtube.desktop ]]; then
    /usr/libexec/mseries/verify-factory-brave --root / --ldd
fi
