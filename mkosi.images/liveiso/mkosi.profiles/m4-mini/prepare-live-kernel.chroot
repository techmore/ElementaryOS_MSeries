#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Image-only staging for assemble-iso.sh's /boot contract.
set -eu
release=7.1.13-elementary-m4-gravity1
modules=/usr/lib/modules/$release
# The assembler selects one module tree. Reject ambiguous kernel selection.
test "$(find /usr/lib/modules -mindepth 1 -maxdepth 1 -type d | wc -l)" -eq 1
test -d "$modules"
printf '%s  %s\n' db3833e9ae2073c5063d733254561bb4bebaed0ee6091f9aadf32dee16f7803b "$modules/vmlinuz" | sha256sum --check --status
printf '%s  %s\n' 4f88633c7f4547674cff6210cf1fbea6f39139d071269d97ba437f216a865d0a "$modules/config-$release" | sha256sum --check --status
install -D -m 0644 "$modules/vmlinuz" "/boot/vmlinuz-$release"
# Ensure update-initramfs -u in the ISO assembler has a candidate to update.
if [ -f "/boot/initrd.img-$release" ]; then
    update-initramfs -u -k "$release"
else
    update-initramfs -c -k "$release"
fi
