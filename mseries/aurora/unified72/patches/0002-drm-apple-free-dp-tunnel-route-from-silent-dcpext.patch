+/*
+ * A DPTX RemotePort call that times out means the firmware service itself
+ * is not answering, not that it refused: every later call waits out its
+ * timeout too. Remember it for a while, so the display fabric routes new
+ * displays to another pipeline instead of back to this one.
+ */
+void dcp_dptx_note_timeout(struct apple_dcp *dcp, int err)
+{
+	if (err != -ETIMEDOUT)
+		return;
+	/* Each failed retry extends the hold-off; say so once. */
+	if (!dcp_dptx_held_off(dcp))
+		dev_warn(dcp->dev,
+			 "DPTX service not answering; routing displays elsewhere for %u s\n",
+			 jiffies_to_msecs(DCP_DPTX_HOLDOFF) / MSEC_PER_SEC);
+	WRITE_ONCE(dcp->dptx_holdoff_until, jiffies + DCP_DPTX_HOLDOFF);
+	WRITE_ONCE(dcp->dptx_holdoff, true);
+}
+
+bool dcp_dptx_held_off(struct apple_dcp *dcp)
+{
+	return READ_ONCE(dcp->dptx_holdoff) &&
+	       time_before(jiffies, READ_ONCE(dcp->dptx_holdoff_until));
+}
+
+/*
+ * Drop our own view of a display the firmware can no longer be asked to
+ * release, so that the route it held can be freed. If the firmware comes
+ * back, the next connection starts from scratch.
+ */
+void dcp_dptx_abandon(struct apple_dcp *dcp, u32 port)
+{
+	guard(mutex)(&dcp->hpd_mutex);
+	if (dcp->external) {
+		smp_store_release(&dcp->external_link_ready, false);
+		dcpext_scanout_invalidate(dcp);
+	}
+	dcp->dptxport[port].connected = false;
+	WRITE_ONCE(dcp->dptxport[port].tile_hint, false);
+}
+
 int dcp_dptx_disconnect(struct apple_dcp *dcp, u32 port)
 {
 	int ret;
