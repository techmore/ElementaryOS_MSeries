+static void fabric_unresponsive_pipeline_test(struct kunit *test)
+{
+	struct fabric_fixture f;
+	struct dcp_fabric_route *route;
+	int error;
+
+	fabric_init(&f, false);
+	/* Without a fault the tunnel takes the lower-scoring pipeline 1. */
+	route = dcp_fabric_tunnel_candidate(&f.port[0], &f.policy, NULL, false,
+					    0, true, &error);
+	KUNIT_ASSERT_PTR_EQ(test, route, &f.route[0][1]);
+
+	/* A pipeline whose firmware service timed out is passed over. */
+	f.pipeline[1].unresponsive = true;
+	KUNIT_EXPECT_FALSE(test, dcp_fabric_available(&f.pipeline[1], &f.policy));
+	route = dcp_fabric_tunnel_candidate(&f.port[0], &f.policy, NULL, false,
+					    0, true, &error);
+	KUNIT_EXPECT_PTR_EQ(test, route, &f.route[0][0]);
+	KUNIT_EXPECT_EQ(test, error, 0);
+
+	/* With nothing else free the request waits for a pipeline. */
+	f.pipeline[0].unresponsive = true;
+	route = dcp_fabric_tunnel_candidate(&f.port[0], &f.policy, NULL, false,
+					    0, true, &error);
+	KUNIT_EXPECT_PTR_EQ(test, route, NULL);
+	KUNIT_EXPECT_EQ(test, error, -EBUSY);
+
+	/* Planning leaves the dead pipeline out, so the next stream goes dark. */
+	f.pipeline[0].unresponsive = false;
+	f.port[0].wanted = true;
+	f.port[0].hpd = true;
+	f.port[1].wanted = true;
+	f.port[1].hpd = true;
+	dcp_fabric_plan(f.pipeline, f.port, NULL, 0);
+	KUNIT_EXPECT_PTR_EQ(test, f.plan[0].target[0], &f.route[0][0]);
+	KUNIT_EXPECT_PTR_EQ(test, f.plan[1].target[0], NULL);
+
+	/* Once the hold-off lapses the pipeline is used again. */
+	f.pipeline[1].unresponsive = false;
+	dcp_fabric_plan(f.pipeline, f.port, NULL, 0);
+	KUNIT_EXPECT_PTR_EQ(test, f.plan[0].target[0], &f.route[0][0]);
+	KUNIT_EXPECT_PTR_EQ(test, f.plan[1].target[0], &f.route[1][1]);
+}
