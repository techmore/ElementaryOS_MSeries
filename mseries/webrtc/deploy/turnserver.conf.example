# On an internet-reachable relay with a dedicated DNS record and fixed public IP.
# UDP/TCP 3478 and UDP 49160:49200 must reach this machine. Caddy/HTTP tunnels
# cannot forward TURN media. Never enable an unauthenticated/open relay.
listening-port=3478
min-port=49160
max-port=49200
realm=relay.stoverparc.org
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_THE_SAME_PRIVATE_TURN_SECRET
stale-nonce=600
no-cli
no-multicast-peers
no-loopback-peers
no-tcp-relay
# If NATed, set external-ip=PUBLIC_IP/PRIVATE_IP and listening-ip=PRIVATE_IP.
# Explicitly prevent relaying to private/internal networks:
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
