#!/usr/bin/env python3
"""Launcher for Orchard for Incus. The code lives in the `orchard_incus` package next to this script
(or in ~/.local/share/orchard-incus when installed)."""
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
for base in (here, os.path.join(here, "..", "share", "orchard-incus")):
    if os.path.isdir(os.path.join(base, "orchard_incus")):
        sys.path.insert(0, os.path.abspath(base))
        break

from orchard_incus.app import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
