[Unit]
Description=Wingpanel for the experimental Pantheon Rust session
BindsTo=pantheon-rust-compositor@wayland.service
After=pantheon-rust-compositor@wayland.service
PartOf=gnome-session-initialized.target
ConditionEnvironment=XDG_SESSION_TYPE=wayland
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
# The compositor advertises wl_shm only (no linux-dmabuf), so GTK4's default
# Vulkan renderer logs VK_ERROR_SURFACE_LOST_KHR in a loop and spins the CPU
# (observed natively 2026-10-19: 2.5 min CPU in 5 min, 2.3G peak). Use GL.
Environment=GSK_RENDERER=gl
ExecStart=/usr/bin/io.elementary.wingpanel
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s
# Apps opened from the panel (Applications menu, indicators) live in this unit's
# cgroup. Restarting or replacing the panel must end only the panel, not them.
KillMode=process
