[Unit]
Description=Wingpanel for the experimental Pantheon Rust session
BindsTo=pantheon-rust-compositor@wayland.service
After=pantheon-rust-compositor@wayland.service
PartOf=gnome-session-initialized.target
ConditionEnvironment=XDG_SESSION_TYPE=wayland
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/io.elementary.wingpanel
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s
