[Unit]
Description=Elementary Dock for the experimental Pantheon Rust session
BindsTo=pantheon-rust-compositor@wayland.service
After=pantheon-rust-compositor@wayland.service pantheon-wingpanel.service
PartOf=gnome-session-initialized.target
ConditionEnvironment=XDG_SESSION_TYPE=wayland
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
# Respect the local user's opt-out even though this unit launches the distro
# binary directly rather than resolving the per-user Dock wrapper through PATH.
ExecCondition=/usr/bin/test ! -e %h/.config/mseries/dock/user-disabled
ExecStart=/usr/bin/io.elementary.dock
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s
