#!/usr/bin/env python3
"""AirPlay outputs: select the receivers to include in AirPlay Group.

Active receivers are members of one combine-stream sink, "AirPlay Group", that plays to all of
them at once. Choose "AirPlay Group" in Sound Output (or the button here) to send audio to it.
Changing a selection only loads/unloads that one extra PipeWire module; the rest of the audio
graph and the default output are never touched unless you press the button.

  mseries-airplay-outputs                GTK window
  mseries-airplay-outputs json           the same, as JSON (used by the Quick Settings menu)
  mseries-airplay-outputs list           receivers and whether they are active
  mseries-airplay-outputs enable|disable|toggle NAME_OR_KEY
  mseries-airplay-outputs apply          make the graph match the saved choice (login autostart)
  mseries-airplay-outputs --screenshot PATH   render the window to a PNG (use with MSERIES_AIRPLAY_FAKE=1)
"""
import json, os, subprocess, sys, time, threading
HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import airplay_core as core

FAKE = bool(os.environ.get("MSERIES_AIRPLAY_FAKE"))


def pw_dump():
    if FAKE:
        return [{"id": i, "type": "PipeWire:Interface:Node", "info": {"state": "suspended", "props": {
            "media.class": "Audio/Sink", "node.description": n,
            "node.name": "raop_sink.%s.local.10.0.0.%d.7000" % (h, i)}}}
            for i, (h, n) in enumerate([("Sonos-1", "Living Room"), ("Sonos-2", "Bedroom"),
                                        ("zTV", "zTV-Living Room"), ("Eve1", "Eve1")], 10)]
    return json.loads(subprocess.run(["pw-dump"], capture_output=True, text=True, check=True, timeout=10).stdout)


def apply(enabled):
    """Make the running graph's group sink contain exactly `enabled` (receivers still on the network)."""
    dump = pw_dump()
    present = {d["key"] for d in core.destinations(dump)}
    want = [k for k in enabled if k in present]
    if FAKE:
        return want
    unit = core.GROUP_UNIT
    systemctl = lambda *x: subprocess.run(["systemctl", "--user", *x], capture_output=True, text=True, timeout=20)
    systemctl("stop", unit)
    systemctl("reset-failed", unit)
    if want:
        conf = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "mseries-airplay-group.conf")
        with open(conf, "w") as f:
            f.write(core.client_conf(want))
        r = subprocess.run(["systemd-run", "--user", "--collect", "--quiet", "--unit", unit,
                            "pipewire", "-c", conf], capture_output=True, text=True, timeout=20)
        if r.returncode != 0:
            raise RuntimeError(r.stderr.strip() or "systemd-run failed")
    return want


def set_enabled(key, on):
    cur = set(core.load_state())
    (cur.add if on else cur.discard)(key)
    core.save_state(cur)
    apply(sorted(cur))


def resolve(arg):
    for d in core.destinations(pw_dump()):
        if arg in (d["key"], d["name"]):
            return d["key"]
    raise SystemExit("No AirPlay receiver called %r" % arg)


def cli(argv):
    cmd = argv[0]
    if cmd == "json":
        saved = set(core.load_state())
        dump = pw_dump()
        live = core.group_members(dump)
        print(json.dumps([{"key": d["key"], "name": d["name"], "enabled": d["key"] in saved,
                           "active": d["key"] in live} for d in core.destinations(dump)]))
    elif cmd == "list":
        saved = set(core.load_state())
        live = core.group_members(pw_dump())
        for d in core.destinations(pw_dump()):
            print("%s  %-24s %s%s" % ("●" if d["key"] in saved else "○", d["name"], d["key"],
                                       "  (in group)" if d["key"] in live else ""))
    elif cmd in ("enable", "disable", "toggle") and len(argv) == 2:
        key = resolve(argv[1])
        on = key not in core.load_state() if cmd == "toggle" else cmd == "enable"
        set_enabled(key, on)
        print("%s %s" % (argv[1], "enabled" if on else "disabled"))
    elif cmd == "apply":
        for _ in range(20):  # receivers appear a few seconds after login
            if core.destinations(pw_dump()):
                break
            time.sleep(3)
        print("group members:", ", ".join(apply(core.load_state())) or "none")
    else:
        raise SystemExit(__doc__)


def gui(shot=None):
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, GLib, Pango
    win = Gtk.Window(title="AirPlay Outputs")
    win.set_default_size(360, -1)
    win.set_border_width(12)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
    win.add(box)
    head = Gtk.Label(xalign=0)
    head.set_markup("<b>AirPlay outputs</b>")
    box.pack_start(head, False, False, 0)
    rows = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    box.pack_start(rows, False, False, 0)
    status = Gtk.Label(xalign=0, wrap=True)
    status.get_style_context().add_class("dim-label")
    use = Gtk.Button(label="Play to AirPlay Group")
    box.pack_start(status, False, False, 4)
    box.pack_start(use, False, False, 0)
    saved = set()
    alive = True
    busy = False
    destinations = []

    def say(text):
        status.set_text(text)

    def rebuild():
        for child in rows.get_children():
            rows.remove(child)
        for destination in destinations:
            row = Gtk.Box(spacing=10)
            on = destination["key"] in saved
            # A persistent receiver selection is a native boolean control.
            toggle = Gtk.CheckButton(label=destination["name"])
            label = toggle.get_child()
            label.set_line_wrap(True)
            label.set_max_width_chars(34)
            label.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
            toggle.set_active(on)
            toggle.set_tooltip_text(destination["name"] + " — Include this receiver in AirPlay Group")
            toggle.connect("toggled", on_toggle, destination["key"], destination["name"])
            row.pack_start(toggle, True, True, 0)
            rows.pack_start(row, False, False, 3)
        if not destinations:
            label = Gtk.Label(label="No AirPlay receivers found. Check your network and try again.",
                              xalign=0, wrap=True)
            rows.pack_start(label, False, False, 0)
        rows.set_sensitive(not busy)
        use.set_sensitive(not busy and any(d["key"] in saved for d in destinations))
        refresh.set_sensitive(not busy)
        rows.show_all()

    def complete(result, error, success_message):
        nonlocal busy, saved, destinations
        if not alive:
            return False
        busy = False
        if error:
            say("Could not update AirPlay receivers. Check your network and try again.")
        else:
            destinations, saved = result
            say(success_message or "%d selected. Selected receivers play together as AirPlay Group." %
                sum(d["key"] in saved for d in destinations))
        rebuild()
        return False

    def start(operation=None, message="Finding AirPlay receivers…", success_message=None):
        nonlocal busy
        if busy or not alive:
            return
        busy = True
        rows.set_sensitive(False)
        use.set_sensitive(False)
        refresh.set_sensitive(False)
        say(message)

        def work():
            try:
                if operation is not None:
                    operation()
                result = (core.destinations(pw_dump()), set(core.load_state()))
                error = None
            except Exception as exc:  # Backend failures must not break the GTK loop.
                result, error = None, type(exc).__name__
            GLib.idle_add(complete, result, error, success_message)
        threading.Thread(target=work, daemon=True).start()

    def on_toggle(button, key, name):
        on = button.get_active()
        start(lambda: set_enabled(key, on), "Updating AirPlay receivers…",
              "%s %s." % (name, "selected" if on else "removed"))

    def use_group(_button):
        def operation():
            group = core.group_sink(pw_dump())
            if group is None:
                raise RuntimeError("AirPlay Group is not running")
            if not FAKE:
                result = subprocess.run(["wpctl", "set-default", str(group)],
                                        capture_output=True, text=True, timeout=10)
                if result.returncode:
                    raise RuntimeError("Could not choose AirPlay Group")
        start(operation, "Choosing AirPlay Group…", "Default output is now AirPlay Group.")

    refresh = Gtk.Button(label="Refresh")
    refresh.connect("clicked", lambda _button: start())
    box.pack_start(refresh, False, False, 0)

    def close(_window):
        nonlocal alive
        alive = False
        Gtk.main_quit()

    use.connect("clicked", use_group)
    start()
    win.connect("destroy", close)
    win.show_all()
    if shot:
        def snap():
            from gi.repository import Gdk
            w = win.get_window()
            pb = Gdk.pixbuf_get_from_window(w, 0, 0, w.get_width(), w.get_height())
            pb.savev(shot, "png", [], [])
            win.destroy()
        if FAKE and os.environ.get("MSERIES_AIRPLAY_CLICK"):
            GLib.timeout_add(300, lambda: [b for b in rows.get_children()[0].get_children() if isinstance(b, Gtk.CheckButton)][0].set_active(True) and False)
        GLib.timeout_add(900, snap)
    Gtk.main()


if __name__ == "__main__":
    a = sys.argv[1:]
    if a[:1] == ["--screenshot"]:
        gui(a[1])
    elif a:
        cli(a)
    else:
        gui()
