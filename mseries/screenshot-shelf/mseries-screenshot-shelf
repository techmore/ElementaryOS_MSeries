#!/usr/bin/python3
"""Screenshot shelf: after a screenshot, show its thumbnail bottom-right, fixed size, for 4 seconds.

Gala saves every screenshot to ~/Pictures/Screenshots (a link to ~/Downloads/Screenshots). This helper
watches that folder and shows the newest shot as a draggable thumbnail, like macOS.

  Drag it into an app      the shot is used and not kept: the saved file goes to the Trash after the drop.
  Hold Alt while dragging  the shot is used and a copy is kept (the thumbnail says so).
  Click Copy               puts the image on the clipboard (paste it anywhere); the file is kept.
  Click it                 opens Markup on the saved file; the file is kept.
  Ignore it                the thumbnail stays (same size, same corner) for 4 seconds, longer while the pointer is on it; the file is kept.
  Click the x              dismisses it; the file is kept.

A screenshot is only ever trashed (never hard-deleted) by a drag without Alt, and only after the drop was accepted.

Flatpak apps (Signal, for one) cannot read files outside their sandbox, so the drag offers the screenshot
through the document portal: a per-file, read-only export granted to the running Flatpak apps and
revoked when the shelf cleans up. Native apps read the same path.
  mseries-screenshot-shelf             run (started from the desktop autostart)
  mseries-screenshot-shelf --snapshot out.png [image.png]   render the card to a PNG and exit
"""
import configparser
import ctypes
import glob
import os
import shutil
import subprocess
import sys
import time
import warnings

GALA_PREFIX = "/usr/local/lib/mseries/gala"
GALA_MARKER = os.path.join(GALA_PREFIX, "share", "mseries-shelf-wayland")


def gala_places_shelf():
    """True when the running compositor is our patched Gala built with the shelf placement.

    A Wayland window cannot choose its position, so the patched Gala puts it bottom-right (patches/
    gala-screenshot-shelf-placement.patch). Wayland is the only backend where drag and drop into native
    Wayland apps such as Signal works; without that Gala the shelf falls back to XWayland and places itself.
    """
    if os.environ.get("MSERIES_SHELF_BACKEND"):
        return os.environ["MSERIES_SHELF_BACKEND"] == "wayland"
    try:
        marker = os.stat(GALA_MARKER).st_mtime
        for pid in filter(str.isdigit, os.listdir("/proc")):
            try:
                if os.path.realpath(f"/proc/{pid}/exe").startswith(GALA_PREFIX) and \
                        os.stat(f"/proc/{pid}").st_ctime > marker:
                    return True
            except OSError:
                continue
    except OSError:
        pass
    return False


ORIGINAL_ENV = {name: os.environ.get(name) for name in ("GDK_BACKEND", "GDK_SCALE")}
WAYLAND = gala_places_shelf()
if not WAYLAND:
    os.environ["GDK_BACKEND"] = "x11"
warnings.filterwarnings("ignore", category=DeprecationWarning)


def display_scale():
    """XWayland windows are unscaled, so GTK needs the compositor's integer scale."""
    try:
        from gi.repository import Gio
        reply = Gio.DBusProxy.new_for_bus_sync(
            Gio.BusType.SESSION, Gio.DBusProxyFlags.NONE, None, "org.gnome.Mutter.DisplayConfig",
            "/org/gnome/Mutter/DisplayConfig", "org.gnome.Mutter.DisplayConfig", None
        ).call_sync("GetCurrentState", None, Gio.DBusCallFlags.NONE, 1000, None).unpack()
        logical = reply[2]
        primary = next((m for m in logical if m[4]), logical[0])
        return max(1, round(primary[2]))
    except Exception:
        return 1


if not WAYLAND:
    os.environ.setdefault("GDK_SCALE", str(display_scale()))

import gi
gi.require_version("Gdk", "4.0")
gi.require_version("GdkX11", "4.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("Graphene", "1.0")
gi.require_version("Gtk", "4.0")
from gi.repository import Gdk, GdkPixbuf, GdkX11, Gio, GLib, Graphene, Gtk

WATCH = os.path.realpath(os.environ.get("MSERIES_SHELF_WATCH", os.path.expanduser("~/Pictures/Screenshots")))
STAGE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "mseries-shelf")
LOG = os.path.expanduser("~/.cache/mseries-screenshot-shelf.log")
MARKUP = os.environ.get("MSERIES_MARKUP", os.path.expanduser("~/.local/bin/mseries-markup"))
DELETE_AFTER = 120      # seconds after an accepted drag before the unsaved file is moved to the Trash
SHOW_SECONDS = int(os.environ.get("MSERIES_SHELF_SECONDS", "4"))       # how long the thumbnail stays when ignored (hover or drag keeps it)
THUMB_WIDTH = 280       # the card is always THUMB_WIDTH x THUMB_HEIGHT, whatever the screenshot's shape
THUMB_HEIGHT = 180
MARGIN = 24

