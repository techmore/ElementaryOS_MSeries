#!/usr/bin/python3
"""Screenshot shelf: after a screenshot, show its thumbnail bottom-right, fixed size, for 4 seconds.

Gala saves every screenshot to ~/Pictures/Screenshots (a link to ~/Downloads/Screenshots). This helper
watches that folder and shows the newest shot as a draggable thumbnail, like macOS.

  Drag it into an app      the shot is used and not kept: the saved file goes to the Trash after the drop.
  Hold Alt while dragging  the shot is used and a copy is kept (the thumbnail says so).
  Click Copy               puts the image on the clipboard (paste it anywhere); the file is kept.
  Click it                 opens Markup on the saved file; the file is kept.
  Ignore it                the thumbnail stays (same size, same corner) for 4 seconds, longer while the pointer is on it; the file is kept.
  Click the x              dismisses it; the file is kept.

A screenshot is only ever trashed (never hard-deleted) by a drag without Alt, and only after the drop was accepted.

Flatpak apps (Signal, for one) cannot read files outside their sandbox, so the drag offers the screenshot
through the document portal: a per-file, read-only export granted to the running Flatpak apps and
revoked when the shelf cleans up. Native apps read the same path.
  mseries-screenshot-shelf             run (started from the desktop autostart)
  mseries-screenshot-shelf --snapshot out.png [image.png]   render the card to a PNG and exit
"""
import configparser
import ctypes
import glob
import os
import shutil
import subprocess
import sys
import time
import warnings

# Wayland clients cannot choose their position, so run through XWayland and place the window.
ORIGINAL_ENV = {name: os.environ.get(name) for name in ("GDK_BACKEND", "GDK_SCALE")}
os.environ["GDK_BACKEND"] = "x11"
warnings.filterwarnings("ignore", category=DeprecationWarning)


def display_scale():
    """XWayland windows are unscaled, so GTK needs the compositor's integer scale."""
    try:
        from gi.repository import Gio
        reply = Gio.DBusProxy.new_for_bus_sync(
            Gio.BusType.SESSION, Gio.DBusProxyFlags.NONE, None, "org.gnome.Mutter.DisplayConfig",
            "/org/gnome/Mutter/DisplayConfig", "org.gnome.Mutter.DisplayConfig", None
        ).call_sync("GetCurrentState", None, Gio.DBusCallFlags.NONE, 1000, None).unpack()
        logical = reply[2]
        primary = next((m for m in logical if m[4]), logical[0])
        return max(1, round(primary[2]))
    except Exception:
        return 1


os.environ.setdefault("GDK_SCALE", str(display_scale()))

import gi
gi.require_version("Gdk", "4.0")
gi.require_version("GdkX11", "4.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("Graphene", "1.0")
gi.require_version("Gtk", "4.0")
from gi.repository import Gdk, GdkPixbuf, GdkX11, Gio, GLib, Graphene, Gtk

WATCH = os.path.realpath(os.environ.get("MSERIES_SHELF_WATCH", os.path.expanduser("~/Pictures/Screenshots")))
STAGE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "mseries-shelf")
LOG = os.path.expanduser("~/.cache/mseries-screenshot-shelf.log")
MARKUP = os.environ.get("MSERIES_MARKUP", os.path.expanduser("~/.local/bin/mseries-markup"))
DELETE_AFTER = 120      # seconds after an accepted drag before the unsaved file is moved to the Trash
SHOW_SECONDS = 4        # how long the thumbnail stays when ignored (hover or drag keeps it)
THUMB_WIDTH = 280       # the card is always THUMB_WIDTH x THUMB_HEIGHT, whatever the screenshot's shape
THUMB_HEIGHT = 180
MARGIN = 24

CSS = b"""
window.shelf { background: transparent; box-shadow: none; }
.shelf-card { background: #1c1c20; color: #ffffff; border-radius: 14px; padding: 10px;
              border: 1px solid rgba(255,255,255,0.18); }
.shelf-thumb { border-radius: 8px; background: rgba(255,255,255,0.06); }
.shelf-hint { color: rgba(255,255,255,0.80); font-size: 12px; }
.shelf-hint.saving { color: #9ad1a4; font-weight: bold; }
.shelf-card button.flat { color: #ffffff; min-height: 22px; min-width: 22px; padding: 0 6px; }
.shelf-card button.markup { background: rgba(255,255,255,0.14); color: #ffffff; border-radius: 8px; padding: 2px 10px; }
"""


def log(message):
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a") as handle:
            handle.write(f"{time.strftime('%H:%M:%S')} {message}\n")
    except OSError:
        pass


def clean_env():
    env = dict(os.environ)
    for name, value in ORIGINAL_ENV.items():
        if value is None:
            env.pop(name, None)
        else:
            env[name] = value
    return env


DOCS = ("org.freedesktop.portal.Documents", "/org/freedesktop/portal/documents", "org.freedesktop.portal.Documents")
DOC_ROOT = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "doc")


def running_flatpak_apps():
    """App ids of running Flatpak instances (read from the instance info files, no subprocess)."""
    apps = set()
    for info in glob.glob(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), ".flatpak", "*", "info")):
        parser = configparser.ConfigParser(interpolation=None)
        try:
            parser.read(info)
            apps.add(parser["Application"]["name"])
        except (configparser.Error, KeyError, OSError):
            pass
    return apps


class PortalExport:
    """One file exported through the document portal, so sandboxed drop targets can read it.

    The export lives at DOC_ROOT/<id>/<name>: the same path on the host and inside every sandbox it is
    granted to. If the host's portal mount is missing (seen on this machine: the FUSE mount vanished while
    the portal kept serving the sandboxes), a hard link stands in at that path for native apps.
    """

    def __init__(self, path):
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        self.granted = set()
        self.shadow = None
        fds = Gio.UnixFDList()
        fd = os.open(path, os.O_PATH | os.O_CLOEXEC)
        try:
            index = fds.append(fd)
        finally:
            os.close(fd)
        # Add(h fd, b reuse_existing, b persistent): a transient export, readable by the host only until granted.
        reply, _ = self.bus.call_with_unix_fd_list_sync(
            *DOCS, "Add", GLib.Variant("(hbb)", (index, True, False)), GLib.VariantType("(s)"),
            Gio.DBusCallFlags.NONE, 2000, fds, None)
        self.doc = reply.unpack()[0]
        self.path = os.path.join(DOC_ROOT, self.doc, os.path.basename(path))
        if not os.path.ismount(DOC_ROOT) and not os.path.exists(self.path):
            os.makedirs(os.path.dirname(self.path), exist_ok=True)
            try:
                os.link(path, self.path)
            except OSError:
                shutil.copy2(path, self.path)
            self.shadow = self.path
            log("document portal is not mounted on the host; using a stand-in link for native apps")

    def grant_running(self):
        for app in running_flatpak_apps() - self.granted:
            try:
                self.bus.call_sync(*DOCS, "GrantPermissions", GLib.Variant("(ssas)", (self.doc, app, ["read"])),
                                   None, Gio.DBusCallFlags.NONE, 2000, None)
                self.granted.add(app)
            except GLib.Error as error:
                log(f"could not grant {app}: {error.message}")

    def remove(self):
        if self.shadow:
            for remove in (os.remove, os.rmdir):
                try:
                    remove(self.shadow if remove is os.remove else os.path.dirname(self.shadow))
                except OSError:
                    pass
        try:
            self.bus.call_sync(*DOCS, "Delete", GLib.Variant("(s)", (self.doc,)), None, Gio.DBusCallFlags.NONE, 2000, None)
        except GLib.Error:
            pass


class Thumb(Gtk.Widget):
    __gtype_name__ = "ShelfThumb"
    """The screenshot, drawn centred and fitted inside a card that is always THUMB_WIDTH x THUMB_HEIGHT."""

    def __init__(self, texture):
        super().__init__()
        self.texture = texture
        self.set_overflow(Gtk.Overflow.HIDDEN)
        self.add_css_class("shelf-thumb")

    def do_measure(self, orientation, _for_size):
        size = THUMB_WIDTH if orientation == Gtk.Orientation.HORIZONTAL else THUMB_HEIGHT
        return size, size, -1, -1

    def do_snapshot(self, snapshot):
        if self.texture is None:
            return
        width, height = self.get_width(), self.get_height()
        ratio = self.texture.get_width() / max(1, self.texture.get_height())
        fit_w, fit_h = (width, width / ratio) if width / height < ratio else (height * ratio, height)
        snapshot.append_texture(self.texture, Graphene.Rect().init((width - fit_w) / 2, (height - fit_h) / 2, fit_w, fit_h))


class Shelf(Gtk.Window):
    """One thumbnail for one screenshot."""

    def __init__(self, app, path, staged):
        super().__init__(application=app)
        self.app, self.path, self.staged = app, path, staged
        self.finished = False
        self.dragging = False
        self.alt_seen = False
        self.cancelled = False
        self.hover = False
        self.timer = None
        self.export = None
        self.add_css_class("shelf")
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_focusable(False)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        card.add_css_class("shelf-card")
        texture = None
        try:
            # Scale once, here, to twice the card so it stays sharp on the Retina panel.
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(staged, THUMB_WIDTH * 2, THUMB_HEIGHT * 2, True)
            texture = Gdk.Texture.new_for_pixbuf(pixbuf)
        except GLib.Error:
            pass
        picture = Thumb(texture)
        self.texture = texture
        self.picture = picture
        card.append(picture)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.hint = Gtk.Label(label="Drag to use  ·  Alt keeps", xalign=0, hexpand=True)
        self.hint.set_ellipsize(3)   # Pango.EllipsizeMode.END: never widen the card
        self.hint.add_css_class("shelf-hint")
        copy = Gtk.Button(label="Copy")
        copy.add_css_class("markup")
        copy.set_tooltip_text("Copy the image to the clipboard")
        copy.connect("clicked", lambda *_: self.copy_to_clipboard())
        self.copy_button = copy
        markup = Gtk.Button(label="Markup")
        markup.add_css_class("markup")
        markup.connect("clicked", lambda *_: self.open_markup())
        close = Gtk.Button(label="✕")
        close.add_css_class("flat")
        close.connect("clicked", lambda *_: self.finish("dismissed"))
        row.append(self.hint)
        row.append(copy)
        row.append(markup)
        row.append(close)
        card.append(row)
        self.set_child(card)

        source = Gtk.DragSource()
        source.set_actions(Gdk.DragAction.COPY)
        source.connect("prepare", self.on_prepare)
        source.connect("drag-begin", self.on_drag_begin)
        source.connect("drag-cancel", self.on_drag_cancel)
        source.connect("drag-end", self.on_drag_end)
        picture.add_controller(source)

        click = Gtk.GestureClick()
        click.connect("released", lambda *_: self.open_markup())
        picture.add_controller(click)

        motion = Gtk.EventControllerMotion()
        motion.connect("enter", lambda *_: self.set_hover(True))
        motion.connect("leave", lambda *_: self.set_hover(False))
        card.add_controller(motion)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.present()
        GLib.timeout_add(60, self.place)
        self.restart_timer()

    # ------------------------------------------------------------------ placement

    def place(self):
        """Bottom-right of the primary monitor, above the bottom edge."""
        surface = self.get_surface()
        if not isinstance(surface, GdkX11.X11Surface):
            return False
        monitor = self.get_display().get_monitor_at_surface(surface)
        geo, scale = monitor.get_geometry(), monitor.get_scale_factor()
        x = geo.x + geo.width - self.get_width() - MARGIN
        y = geo.y + geo.height - self.get_height() - MARGIN
        xlib = ctypes.CDLL("libX11.so.6")
        xlib.XOpenDisplay.restype = ctypes.c_void_p
        xlib.XInternAtom.restype = ctypes.c_ulong
        display = xlib.XOpenDisplay(None)
        if display:
            d, xid = ctypes.c_void_p(display), ctypes.c_ulong(surface.get_xid())
            # Ask for notification treatment: no focus, no taskbar entry.
            wtype = xlib.XInternAtom(d, b"_NET_WM_WINDOW_TYPE", False)
            notif = ctypes.c_ulong(xlib.XInternAtom(d, b"_NET_WM_WINDOW_TYPE_NOTIFICATION", False))
            xlib.XChangeProperty(d, xid, ctypes.c_ulong(wtype), ctypes.c_ulong(4), 32, 0,
                                 ctypes.byref(notif), 1)   # 4 = XA_ATOM, 0 = PropModeReplace
            xlib.XMoveWindow(d, xid, x * scale, y * scale)
            xlib.XFlush(d)
            xlib.XCloseDisplay(d)
        return False

    # ------------------------------------------------------------------ timing

    def restart_timer(self):
        if self.timer:
            GLib.source_remove(self.timer)
        self.timer = GLib.timeout_add_seconds(SHOW_SECONDS, self.on_timeout)

    def on_timeout(self):
        self.timer = None
        if self.hover or self.dragging:
            self.restart_timer()
            return False
        self.finish("expired")
        return False

    def set_hover(self, value):
        self.hover = value

    # ------------------------------------------------------------------ drag

    def alt_held(self):
        keyboard = self.get_display().get_default_seat().get_keyboard()
        return bool(keyboard and keyboard.get_modifier_state() & Gdk.ModifierType.ALT_MASK)

    def drop_path(self):
        """The path a drop target gets: a portal export when possible, so Flatpak apps can read it."""
        try:
            if self.export is None:
                self.export = PortalExport(self.staged)
            self.export.grant_running()
            return self.export.path
        except (GLib.Error, OSError) as error:
            log(f"document portal unavailable ({error}); offering the staged path")
            return self.staged

    def on_prepare(self, source, _x, _y):
        if self.alt_held():
            self.alt_seen = True
        path = self.drop_path()
        log(f"offering {path} (granted: {', '.join(sorted(self.export.granted)) if self.export else 'none'})")
        return Gdk.ContentProvider.new_for_value(Gdk.FileList.new_from_list([Gio.File.new_for_path(path)]))

    def on_drag_begin(self, source, drag):
        self.dragging, self.cancelled = True, False
        if self.texture is not None:
            source.set_icon(self.texture, 0, 0)
        GLib.timeout_add(50, self.poll_alt)
        log(f"drag begin {os.path.basename(self.path)}")

    def poll_alt(self):
        if not self.dragging:
            return False
        if self.alt_held():
            self.alt_seen = True
        self.hint.set_label("Keeping a copy (Alt)" if self.alt_seen else "Drag to use  ·  Alt keeps")
        (self.hint.add_css_class if self.alt_seen else self.hint.remove_css_class)("saving")
        return True

    def on_drag_cancel(self, _source, _drag, reason):
        self.cancelled = True
        log(f"drag cancelled ({reason.value_nick})")
        return False

    def on_drag_end(self, _source, _drag, _delete):
        self.dragging = False
        if self.cancelled:
            self.restart_timer()
            self.alt_seen = False
            self.hint.set_label("Drag to use  ·  Alt keeps")
            return
        if self.alt_seen:
            log(f"used and kept (Alt): {os.path.basename(self.path)}")
            self.finish("used-kept", delay=DELETE_AFTER, delete_saved=False)
        else:
            log(f"used, not kept: {os.path.basename(self.path)} deleted in {DELETE_AFTER}s")
            self.finish("used", delay=DELETE_AFTER, delete_saved=True)

    # ------------------------------------------------------------------ outcomes

    def copy_to_clipboard(self):
        """Full-size image on the clipboard: pasting needs no file access, so it works in any app."""
        try:
            texture = Gdk.Texture.new_from_filename(self.staged)
        except GLib.Error as error:
            log(f"could not copy: {error.message}")
            return
        self.get_clipboard().set_content(Gdk.ContentProvider.new_for_value(texture))
        self.clip_texture = texture   # keep the data alive while this process owns the clipboard
        self.copy_button.set_label("Copied")
        GLib.timeout_add_seconds(2, lambda: self.copy_button.set_label("Copy") and False)
        log(f"copied {os.path.basename(self.path)} to the clipboard")

    def open_markup(self):
        log(f"markup {os.path.basename(self.path)}")
        try:
            subprocess.Popen([MARKUP, self.path], env=clean_env(), start_new_session=True)
        except OSError as error:
            log(f"could not start markup: {error}")

    def finish(self, reason, delay=0, delete_saved=False):
        if self.finished:
            return
        self.finished = True
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = None
        log(f"shelf done: {reason}")
        # The staged copy is what an app may still be reading after a drop, so it outlives the window.
        GLib.timeout_add_seconds(max(delay, 1), self.cleanup, delete_saved)
        self.app.shelf = None
        self.close()

    def cleanup(self, delete_saved):
        if self.export:
            self.export.remove()
        try:
            os.remove(self.staged)
        except OSError:
            pass
        if delete_saved:
            # Trash, not delete: an accepted drop does not prove the app could read the file.
            try:
                Gio.File.new_for_path(self.path).trash(None)
                log(f"moved used screenshot to the Trash: {os.path.basename(self.path)}")
            except GLib.Error as error:
                log(f"kept {os.path.basename(self.path)}: could not trash it ({error.message})")
        return False


class ShelfApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.techmore.mseries.ScreenshotShelf", flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.shelf = None
        self.seen = set()
        self.monitor = None

    def do_activate(self):
        self.hold()
        os.makedirs(STAGE, exist_ok=True)
        os.makedirs(WATCH, exist_ok=True)
        self.monitor = Gio.File.new_for_path(WATCH).monitor_directory(Gio.FileMonitorFlags.NONE, None)
        self.monitor.connect("changed", self.on_changed)
        log(f"watching {WATCH}")

    def on_changed(self, _monitor, file, _other, event):
        if event != Gio.FileMonitorEvent.CHANGES_DONE_HINT:
            return
        name = file.get_basename()
        if not name.lower().endswith(".png") or not name.startswith("Screenshot") or name in self.seen:
            return
        self.seen.add(name)
        GLib.timeout_add(250, self.show, file.get_path())

    def show(self, path):
        try:
            staged = os.path.join(STAGE, os.path.basename(path))
            shutil.copy2(path, staged)
        except OSError as error:
            log(f"could not stage {path}: {error}")
            return False
        if self.shelf:
            self.shelf.finish("replaced")
        log(f"showing {os.path.basename(path)}")
        self.shelf = Shelf(self, path, staged)
        return False


def snapshot(out, image):
    """Render the card to a PNG for visual checks."""
    class Holder(Gtk.Application):
        shelf = None

    app = Holder(application_id="org.techmore.mseries.ShelfSnapshot")

    def on(app):
        shelf = Shelf(app, image, image)

        def snap():
            child = shelf.get_child()
            w, h = child.get_width(), child.get_height()
            paintable = Gtk.WidgetPaintable.new(child)
            s = Gtk.Snapshot()
            paintable.snapshot(s, w, h)
            node = s.to_node()
            tex = shelf.get_native().get_renderer().render_texture(node, Graphene.Rect().init(0, 0, w, h))
            tex.save_to_png(out)
            app.quit()
            return False
        GLib.timeout_add(900, snap)

    app.connect("activate", on)
    app.run([])


def main():
    if "--snapshot" in sys.argv:
        i = sys.argv.index("--snapshot")
        snapshot(sys.argv[i + 1], sys.argv[i + 2])
        return
    ShelfApp().run([])


if __name__ == "__main__":
    main()
