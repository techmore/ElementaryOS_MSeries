#!/usr/bin/env python3
"""Display settings for the M-series desktop: drag monitors into place, pick resolution,
refresh rate, scale and rotation from what each monitor really offers, save layouts per
set of attached displays, and see in plain words why a monitor is or is not working.

Talks to Gala over org.gnome.Mutter.DisplayConfig. Set MSERIES_DISPLAY_FAKE=1 to run on
made-up monitors (no changes are applied); --screenshot PATH renders the window to a PNG.
"""
import importlib.machinery, importlib.util, os, sys, json
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib, Gio

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import display_diag


def _load_profiles():
    for d in (HERE, os.path.join(HERE, "..", "display-profiles"), os.path.expanduser("~/.local/bin")):
        p = os.path.join(d, "mseries-display-profiles")
        if os.path.exists(p):
            loader = importlib.machinery.SourceFileLoader("mseries_display_profiles", p)
            spec = importlib.util.spec_from_loader("mseries_display_profiles", loader)
            mod = importlib.util.module_from_spec(spec)
            loader.exec_module(mod)
            return mod
    raise SystemExit("mseries-display-profiles not found next to this app")


profiles = _load_profiles()
FAKE = bool(os.environ.get("MSERIES_DISPLAY_FAKE"))
ROTATIONS = [("Normal", 0), ("90°", 1), ("180°", 2), ("270°", 3)]
SEV_ICON = {"ok": "emblem-ok-symbolic", "info": "dialog-information-symbolic",
            "warn": "dialog-warning-symbolic", "bad": "dialog-error-symbolic"}


