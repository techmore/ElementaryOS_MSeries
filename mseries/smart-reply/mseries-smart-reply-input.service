[Unit]
Description=Smart Reply input method (holds one drafted reply; Tab inserts it)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.techmore.SmartReplyInput
ExecStart=/usr/bin/python3 %h/.local/share/mseries/smart-reply/smart-reply-input.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
