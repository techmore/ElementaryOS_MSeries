+    private Meta.Window? window_at (float px, float py) {
+        unowned var display = wm.get_display ();
+        var workspace = display.get_workspace_manager ().get_active_workspace ();
+        var on_workspace = new SList<Meta.Window> ();
+        foreach (unowned var candidate in workspace.list_windows ()) {
+            on_workspace.prepend (candidate);
