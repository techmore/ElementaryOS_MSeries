+
+        // sort_windows_by_stacking is bottom to top; keep the last (topmost) window under the point.
+        Meta.Window? found = null;
+        foreach (unowned var window in display.sort_windows_by_stacking (on_workspace)) {
+            if (window.minimized || window.is_override_redirect ()) {
