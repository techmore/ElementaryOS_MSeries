+/* M-series taskbar mode (io.elementary.dock taskbar-mode): a Windows 11-style
+ * bar flush to the bottom edge. Everything below is scoped to .taskbar. */
+dock-window.taskbar dock {
+    background: rgba(158, 163, 169, 0.97);
+    box-shadow: none;
+    border-radius: 0;
+    opacity: 1;
+    min-height: 72px;
+}
+
+dock-window.taskbar.dark dock {
+    /* Windows 11 silver in both styles. */
+    background: rgba(158, 163, 169, 0.97);
+    box-shadow: none;
+}
+
+dock-window.taskbar.reduce-transparency dock {
+    background: rgb(236, 238, 241);
+}
+
+dock-window.taskbar.dark.reduce-transparency dock {
+    background: rgb(158, 163, 169);
+}
+
+dock-window.taskbar launcher,
+dock-window.taskbar backgrounditem,
+dock-window.taskbar icongroup {
+    padding-top: 12px;
+}
+
+dock-window.taskbar bottom-margin {
+    min-height: 8px;
+}
+
+dock-window.taskbar .taskbar-row {
