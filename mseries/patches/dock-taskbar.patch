+}
+
+popover.start-menu .start-list {
+    background: none;
+}
+
+popover.start-menu .start-footer {
+    padding: 10px 32px;
+    border-radius: 0 0 8px 8px;
+    background: rgba(0, 0, 0, 0.04);
+    box-shadow: inset 0 1px 0 0 rgba(0, 0, 0, 0.06);
