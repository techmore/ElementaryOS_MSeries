diff --git a/src/Taskbar.vala b/src/Taskbar.vala
new file mode 100644
index 0000000..2acbc7f
--- /dev/null
+++ b/src/Taskbar.vala
@@ -0,0 +1,361 @@
+/*
+ * SPDX-License-Identifier: GPL-3.0
+ * SPDX-FileCopyrightText: 2026 ElementaryOS_MSeries contributors
+ *
+ * M-series taskbar mode (io.elementary.dock taskbar-mode): a Windows 11-style
+ * row with a Start button left of the centred launchers and a status area plus
+ * clock on the right. Created only when the mode is first enabled, so the
+ * regular dock does no extra work.
+ */
+
+public class Dock.TaskbarRow : Gtk.Widget {
+    public const int HEIGHT = 72;
+
+    /** The launchers (ItemManager) are moved in here while taskbar mode is on. */
+    public Gtk.Box center_box { get; private set; }
+
+    private Gtk.CenterBox center_layout;
+    private Gtk.Image network_image;
+    private Gtk.Button network_button;
+    private Gtk.Button battery_button;
+    private Gtk.Image battery_image;
+    private Gtk.Button clock_button;
+    private Gtk.Label time_label;
+    private Gtk.Label date_label;
+    private uint clock_timeout_id = 0;
+    private DBusProxy? upower = null;
+    private Gtk.Button weather_button;
+    private Gtk.Image weather_image;
+    private Gtk.Label weather_temp;
+    private Gtk.Label weather_desc;
+    private uint weather_timeout_id = 0;
+
+    class construct {
+        set_layout_manager_type (typeof (Gtk.BinLayout));
+        set_css_name ("taskbar-row");
+    }
+
+    construct {
+        add_css_class ("taskbar-row");
+        hexpand = true;
+
+        // Four-pane start glyph drawn with CSS so no icon theme is needed.
+        var logo = new Gtk.Grid () {
+            row_spacing = 2,
+            column_spacing = 2,
+            valign = CENTER,
+            halign = CENTER
+        };
+        logo.add_css_class ("taskbar-logo");
+        for (int i = 0; i < 4; i++) {
+            var pane = new Gtk.Box (HORIZONTAL, 0);
+            pane.add_css_class ("taskbar-logo-pane");
+            logo.attach (pane, i % 2, i / 2);
+        }
+        var start_button = new Gtk.Button () {
+            child = logo,
+            tooltip_text = _("Start"),
+            valign = CENTER,
+            focusable = false
+        };
+        start_button.add_css_class ("taskbar-start");
+        start_button.update_property (Gtk.AccessibleProperty.LABEL, _("Start"), -1);
+        start_button.clicked.connect (open_launcher);
+
+        var search_content = new Gtk.Box (HORIZONTAL, 8);
+        search_content.append (new Gtk.Image.from_icon_name ("system-search-symbolic"));
+        search_content.append (new Gtk.Label (_("Search")) { xalign = 0 });
+        var search_button = new Gtk.Button () {
+            child = search_content,
+            tooltip_text = _("Search apps"),
+            valign = CENTER,
+            focusable = false
+        };
+        search_button.add_css_class ("taskbar-search");
+        search_button.update_property (Gtk.AccessibleProperty.LABEL, _("Search"), -1);
+        search_button.clicked.connect (open_launcher);
+
+        center_box = new Gtk.Box (HORIZONTAL, 4) {
+            valign = FILL
+        };
+        center_box.append (start_button);
+        center_box.append (search_button);
+
+        weather_image = new Gtk.Image.from_icon_name ("weather-few-clouds-symbolic") {
+            pixel_size = 48
+        };
+        weather_temp = new Gtk.Label ("—") { xalign = 0 };
+        weather_temp.add_css_class ("taskbar-weather-temp");
+        weather_desc = new Gtk.Label (_("Weather")) { xalign = 0 };
+        weather_desc.add_css_class ("taskbar-weather-desc");
+        var weather_labels = new Gtk.Box (VERTICAL, 0) { valign = CENTER };
+        weather_labels.append (weather_temp);
+        weather_labels.append (weather_desc);
+        var weather_content = new Gtk.Box (HORIZONTAL, 8);
+        weather_content.append (weather_image);
+        weather_content.append (weather_labels);
+        weather_button = new Gtk.Button () {
+            child = weather_content,
+            valign = CENTER,
+            margin_start = 8,
+            focusable = false,
+            tooltip_text = _("Weather")
+        };
+        weather_button.add_css_class ("taskbar-weather");
+        weather_button.clicked.connect (() => refresh_weather.begin ());
+
+        network_image = new Gtk.Image.from_icon_name ("network-wireless-signal-excellent-symbolic");
+        network_button = make_status_button (network_image, _("Network"), "settings://network");
+
+        var volume_button = make_status_button (
+            new Gtk.Image.from_icon_name ("audio-volume-high-symbolic"), _("Sound"), "settings://sound"
+        );
+
+        battery_image = new Gtk.Image.from_icon_name ("battery-full-symbolic");
+        battery_button = make_status_button (battery_image, _("Power"), "settings://power");
+
+        var status_box = new Gtk.Box (HORIZONTAL, 0) {
+            valign = CENTER
+        };
+        status_box.add_css_class ("taskbar-status");
+        status_box.append (network_button);
+        status_box.append (volume_button);
+        status_box.append (battery_button);
+
+        time_label = new Gtk.Label (null) {
+            halign = END
+        };
+        date_label = new Gtk.Label (null) {
+            halign = END
+        };
+        var clock_labels = new Gtk.Box (VERTICAL, 0) {
+            valign = CENTER
+        };
+        clock_labels.append (time_label);
+        clock_labels.append (date_label);
+
+        clock_button = new Gtk.Button () {
+            child = clock_labels,
+            valign = CENTER,
+            focusable = false
+        };
+        clock_button.add_css_class ("taskbar-clock");
+        clock_button.clicked.connect (() => {
+            if (Environment.find_program_in_path ("io.elementary.calendar") != null) {
+                spawn ({ "io.elementary.calendar" });
+            }
+        });
+
+        var end_box = new Gtk.Box (HORIZONTAL, 4) {
+            valign = FILL,
+            margin_end = 8
+        };
+        end_box.append (status_box);
+        end_box.append (clock_button);
+
+        center_layout = new Gtk.CenterBox () {
+            start_widget = weather_button,
+            center_widget = center_box,
+            end_widget = end_box,
+            hexpand = true
+        };
+        center_layout.set_parent (this);
+
+        var network_monitor = NetworkMonitor.get_default ();
+        network_monitor.network_changed.connect (update_network);
+        network_monitor.notify["connectivity"].connect (update_network);
+        update_network ();
+
+        init_upower.begin ();
+
+        refresh_weather.begin ();
+        weather_timeout_id = Timeout.add_seconds (30 * 60, () => {
+            refresh_weather.begin ();
+            return Source.CONTINUE;
+        });
+
+        map.connect (() => {
+            update_clock ();
+            schedule_clock ();
+        });
+        unmap.connect (() => {
+            if (clock_timeout_id != 0) {
+                Source.remove (clock_timeout_id);
+                clock_timeout_id = 0;
+            }
+        });
+        update_clock ();
+    }
+
+    ~TaskbarRow () {
+        if (weather_timeout_id != 0) {
+            Source.remove (weather_timeout_id);
+        }
+        if (clock_timeout_id != 0) {
+            Source.remove (clock_timeout_id);
+        }
+        center_layout.unparent ();
+    }
+
+    private static void open_launcher () {
+        // Slingshot is a Wingpanel indicator; Wingpanel's command line toggles it.
+        spawn ({ "io.elementary.wingpanel", "--toggle-indicator=app-launcher" });
+    }
+
+    // Current conditions from wttr.in (location from the public IP), refreshed every 30 minutes.
+    private async void refresh_weather () {
+        try {
+            var process = new Subprocess.newv (
+                { "curl", "-sf", "--max-time", "8", "https://wttr.in/?format=%t|%C" },
+                SubprocessFlags.STDOUT_PIPE | SubprocessFlags.STDERR_SILENCE
+            );
+            string? output;
+            yield process.communicate_utf8_async (null, null, out output, null);
+            if (!process.get_successful () || output == null || !output.contains ("|")) {
+                return;
+            }
+            var parts = output.strip ().split ("|", 2);
+            var temp = parts[0].strip ();
+            if (temp.has_prefix ("+")) {
+                temp = temp.substring (1);
+            }
+            var condition = parts[1].strip ();
+            weather_temp.label = temp;
+            weather_desc.label = condition;
+            weather_image.icon_name = weather_icon (condition.down ());
+            weather_button.tooltip_text = "%s, %s".printf (temp, condition);
+            weather_button.update_property (Gtk.AccessibleProperty.LABEL, "%s, %s".printf (temp, condition), -1);
+        } catch (Error e) {
+            debug ("Taskbar weather unavailable: %s", e.message);
+        }
+    }
+
+    private static string weather_icon (string condition) {
+        if ("thunder" in condition) return "weather-storm-symbolic";
+        if ("snow" in condition || "sleet" in condition || "ice" in condition) return "weather-snow-symbolic";
+        if ("rain" in condition || "drizzle" in condition || "shower" in condition) return "weather-showers-symbolic";
+        if ("fog" in condition || "mist" in condition || "haze" in condition) return "weather-fog-symbolic";
+        if ("overcast" in condition || "cloudy" in condition && !("partly" in condition)) return "weather-overcast-symbolic";
+        if ("partly" in condition || "cloud" in condition) return "weather-few-clouds-symbolic";
+        return "weather-clear-symbolic";
+    }
+
+    private Gtk.Button make_status_button (Gtk.Image image, string label, string uri) {
+        var button = new Gtk.Button () {
+            child = image,
+            tooltip_text = label,
+            focusable = false
+        };
+        button.update_property (Gtk.AccessibleProperty.LABEL, label, -1);
+        button.clicked.connect (() => {
+            spawn ({ "io.elementary.settings", uri });
+        });
+        return button;
+    }
+
+    private static void spawn (string[] argv) {
+        try {
+            Process.spawn_async (
+                null, argv, null,
+                SpawnFlags.SEARCH_PATH | SpawnFlags.STDOUT_TO_DEV_NULL | SpawnFlags.STDERR_TO_DEV_NULL,
+                null, null
+            );
+        } catch (Error e) {
+            warning ("Taskbar could not start %s: %s", argv[0], e.message);
+        }
+    }
+
+    private void update_network () {
+        var monitor = NetworkMonitor.get_default ();
+        string icon;
+        string description;
+        if (!monitor.network_available || monitor.connectivity == LOCAL) {
+            icon = "network-wireless-offline-symbolic";
+            description = _("Network: offline");
+        } else if (monitor.connectivity == FULL) {
+            icon = "network-wireless-signal-excellent-symbolic";
+            description = _("Network: connected");
+        } else {
+            icon = "network-wireless-no-route-symbolic";
+            description = _("Network: limited connectivity");
+        }
+        network_image.icon_name = icon;
+        network_button.tooltip_text = description;
+        network_button.update_property (Gtk.AccessibleProperty.LABEL, description, -1);
+    }
+
+    private async void init_upower () {
+        try {
+            upower = yield new DBusProxy.for_bus (
+                SYSTEM, DBusProxyFlags.DO_NOT_AUTO_START, null,
+                "org.freedesktop.UPower",
+                "/org/freedesktop/UPower/devices/DisplayDevice",
+                "org.freedesktop.UPower.Device"
+            );
+            upower.g_properties_changed.connect (update_battery);
+        } catch (Error e) {
+            debug ("Taskbar: UPower unavailable: %s", e.message);
+            upower = null;
+        }
+        update_battery ();
+    }
+
+    private void update_battery () {
+        var present = upower?.get_cached_property ("IsPresent");
+        var icon = upower?.get_cached_property ("IconName");
+        var percentage = upower?.get_cached_property ("Percentage");
+
+        if (present != null && !present.get_boolean ()) {
+            // Desktops without a battery: the Power page is still one click away.
+            battery_image.icon_name = "battery-missing-symbolic";
+            battery_button.tooltip_text = _("Power");
+            battery_button.update_property (Gtk.AccessibleProperty.LABEL, _("Power"), -1);
+            return;
+        }
+
+        if (icon != null && icon.get_string () != "") {
+            battery_image.icon_name = icon.get_string ();
+        }
+
+        if (percentage != null) {
+            var description = _("Battery: %.0f%%").printf (percentage.get_double ());
+            battery_button.tooltip_text = description;
+            battery_button.update_property (Gtk.AccessibleProperty.LABEL, description, -1);
+        }
+    }
+
+    private void schedule_clock () {
+        if (clock_timeout_id != 0) {
+            Source.remove (clock_timeout_id);
+        }
+        var now = new DateTime.now_local ();
+        clock_timeout_id = Timeout.add_seconds ((uint) (60 - now.get_second ()), () => {
+            clock_timeout_id = 0;
+            update_clock ();
+            schedule_clock ();
+            return Source.REMOVE;
+        });
+    }
+
+    private static bool is_12h () {
+        var schema = SettingsSchemaSource.get_default ().lookup ("org.gnome.desktop.interface", true);
+        if (schema == null || !schema.has_key ("clock-format")) {
+            return false;
+        }
+        return new Settings ("org.gnome.desktop.interface").get_string ("clock-format") == "12h";
+    }
+
+    private void update_clock () {
+        var now = new DateTime.now_local ();
+        var time_text = now.format (Granite.DateTime.get_default_time_format (is_12h (), false));
+        var date_text = now.format ("%x");
+        time_label.label = time_text;
+        date_label.label = date_text;
+
+        var full_date = now.format (Granite.DateTime.get_default_date_format (true, true, true));
+        clock_button.tooltip_text = full_date;
+        clock_button.update_property (
+            Gtk.AccessibleProperty.LABEL, "%s, %s".printf (time_text, full_date), -1
+        );
+    }
+}
