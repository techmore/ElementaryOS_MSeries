+}
+
+dock-window.taskbar.dark .taskbar-row {
+    color: rgba(0, 0, 0, 0.87);
+}
+
+dock-window.taskbar .taskbar-row button {
+    background: none;
+    border: none;
+    box-shadow: none;
+    border-radius: 4px;
+    color: inherit;
+    min-height: 0;
+    min-width: 0;
+    padding: 4px 6px;
+    transition: background 100ms ease-in-out;
+}
+
+dock-window.taskbar .taskbar-row button:hover {
+    background: rgba(0, 0, 0, 0.05);
+}
+
+dock-window.taskbar .taskbar-row button:active {
+    background: rgba(0, 0, 0, 0.03);
+}
+
+dock-window.taskbar.dark .taskbar-row button:hover {
+    background: rgba(255, 255, 255, 0.08);
+}
+
+dock-window.taskbar.dark .taskbar-row button:active {
+    background: rgba(255, 255, 255, 0.05);
+}
+
+dock-window.taskbar .taskbar-row button.taskbar-start {
+    padding: 10px 14px;
+    -gtk-icon-size: 24px;
+}
+
+dock-window.taskbar .taskbar-row button.taskbar-start image {
