+    min-height: 4px;
+    margin-top: 2px;
+    border-radius: 2px;
+    background: #0078d4;
+    transition: min-width 150ms ease-out, background 150ms ease-out;
+}
+
+dock-window.taskbar .running-indicator:disabled {
+    min-width: 7px;
+    background: rgba(0, 0, 0, 0.45);
+}
+
+dock-window.taskbar.dark .running-indicator {
+    background: #4cc2ff;
+}
+
+dock-window.taskbar.dark .running-indicator:disabled {
+    background: rgba(255, 255, 255, 0.55);
+}
+
+/* Windows 11 dark Start/Search panel, following the dark style preference. */
+dock-window.taskbar.dark popover.start-menu > contents {
+    background: rgba(32, 32, 32, 0.97);
+    color: rgba(255, 255, 255, 0.92);
+    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08);
+}
+
+dock-window.taskbar.dark popover.start-menu .start-search {
+    background: rgba(255, 255, 255, 0.06);
+    color: rgba(255, 255, 255, 0.92);
+    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08), inset 0 -1px 0 0 #4cc2ff;
+}
+
+dock-window.taskbar.dark popover.start-menu .start-pill {
+    background: rgba(255, 255, 255, 0.06);
+    color: rgba(255, 255, 255, 0.92);
+    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
+}
+
+dock-window.taskbar.dark popover.start-menu .start-tile:hover,
+dock-window.taskbar.dark popover.start-menu .start-list row:hover {
+    background: rgba(255, 255, 255, 0.06);
+}
+
+dock-window.taskbar.dark popover.start-menu .start-footer {
+    background: rgba(0, 0, 0, 0.2);
+    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.06);
+}
+
+dock-window.taskbar .taskbar-weather image.weather-sun {
+    color: #f9a825;
+}
+
+/* Search pill: a visible rounded border, like Windows 11's taskbar search. */
+dock-window.taskbar .taskbar-row button.taskbar-search,
+dock-window.taskbar.dark .taskbar-row button.taskbar-search {
+    border: 1px solid rgba(0, 0, 0, 0.22);
+    border-radius: 999px;
+    background: rgba(255, 255, 255, 0.75);
+    box-shadow: none;
+}
+
+dock-window.taskbar .taskbar-row button.taskbar-search:hover {
+    background: rgba(255, 255, 255, 0.9);
+}
