+}
+
+dock-window.taskbar .taskbar-logo-pane {
+    min-width: 18px;
+    min-height: 18px;
+    background: #065eba;
+    border-radius: 1px;
+}
+
+dock-window.taskbar.dark .taskbar-logo-pane {
+    background: #32a8e5;
+}
+
+dock-window.taskbar .taskbar-row button.taskbar-search {
+    min-width: 200px;
+    padding: 10px 22px;
+    border-radius: 999px;
+    background: rgba(255, 255, 255, 0.85);
+    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
+}
+
+dock-window.taskbar.dark .taskbar-row button.taskbar-search {
+    background: rgba(255, 255, 255, 0.08);
+    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
+}
+
+dock-window.taskbar .taskbar-search label {
+    opacity: 0.7;
+}
+
+dock-window.taskbar .taskbar-weather-temp {
+    font-size: 1.3em;
+    font-weight: 600;
+}
+
+dock-window.taskbar .taskbar-weather-desc {
+    font-size: 1.1em;
+    opacity: 0.75;
+}
+
+.taskbar-power-item {
+    padding: 6px 12px;
+    min-width: 180px;
+}
+
+dock-window.taskbar .taskbar-search label {
+    font-size: 1.25em;
+}
+
+dock-window.taskbar .taskbar-search image {
+    -gtk-icon-size: 24px;
+}
+
+popover.start-menu > contents {
+    padding: 0;
+    border-radius: 8px;
+    background: rgba(243, 243, 243, 0.97);
+    color: rgba(0, 0, 0, 0.9);
+}
+
+popover.start-menu .start-search {
+    min-height: 36px;
+    border-radius: 999px;
+    background: white;
+    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08), inset 0 -1px 0 0 #0078d4;
