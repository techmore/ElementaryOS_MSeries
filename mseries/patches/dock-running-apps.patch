diff --git a/src/AppSystem/AppResolver.vala b/src/AppSystem/AppResolver.vala
new file mode 100644
index 0000000..f3a2015
--- /dev/null
+++ b/src/AppSystem/AppResolver.vala
@@ -0,0 +1,104 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright 2026 ElementaryOS_MSeries contributors
+ */
+
+// The compositor's app-id is a window-system identity, not necessarily a
+// desktop filename. Resolve installed entries before creating a transient item.
+public class Dock.AppResolver : Object {
+    private static AppResolver? instance;
+    public static AppResolver get_default () {
+        if (instance == null) {
+            instance = new AppResolver ();
+        }
+        return instance;
+    }
+
+    private HashTable<string, DesktopAppInfo> ids;
+    private HashTable<string, DesktopAppInfo> classes;
+    private HashTable<string, DesktopAppInfo> executables;
+    private HashTable<string, bool> ambiguous_executables;
+    private HashTable<string, DesktopAppInfo> resolved;
+
+    public AppResolver () {
+        reload ();
+        AppInfoMonitor.get ().changed.connect (reload);
+    }
+
+    private void reload () {
+        ids = new HashTable<string, DesktopAppInfo> (str_hash, str_equal);
+        classes = new HashTable<string, DesktopAppInfo> (str_hash, str_equal);
+        executables = new HashTable<string, DesktopAppInfo> (str_hash, str_equal);
+        ambiguous_executables = new HashTable<string, bool> (str_hash, str_equal);
+        resolved = new HashTable<string, DesktopAppInfo> (str_hash, str_equal);
+        foreach (var info in AppInfo.get_all ()) {
+            var desktop = info as DesktopAppInfo;
+            if (desktop == null || desktop.get_id () == null) {
+                continue;
+            }
+            var id = desktop.get_id ().casefold ();
+            ids[id] = desktop;
+            var startup_class = desktop.get_startup_wm_class ();
+            if (startup_class != null && startup_class != "") {
+                classes[startup_class.casefold ()] = desktop;
+            }
+            var executable = desktop.get_executable ();
+            if (executable != null && executable != "") {
+                var name = Path.get_basename (executable).casefold ();
+                if (executables.contains (name)) {
+                    ambiguous_executables[name] = true;
+                } else {
+                    executables[name] = desktop;
+                }
+            }
+        }
+    }
+
+    public DesktopAppInfo? resolve (string window_id) {
+        if (resolved.contains (window_id)) {
+            return resolved[window_id];
+        }
+        var key = window_id.casefold ();
+        DesktopAppInfo? info = ids[key];
+        if (info == null && !key.has_suffix (".desktop")) {
+            info = ids[key + ".desktop"];
+        }
+        if (info == null) {
+            info = classes[key];
+        }
+        if (info == null && !ambiguous_executables.contains (key)) {
+            info = executables[key];
+        }
+        if (info == null) {
+            info = transient_app (window_id);
+        }
+        if (info != null) {
+            resolved[window_id] = info;
+        }
+        return info;
+    }
+
+    private DesktopAppInfo? transient_app (string window_id) {
+        // Track windows without installed launchers too. Never turn an untrusted
+        // window identity into a shell command, or persist a fake installed app.
+        var directory = Path.build_filename (Environment.get_user_runtime_dir (), "mseries-dock-apps");
+        var filename = Checksum.compute_for_string (ChecksumType.SHA256, window_id) + ".desktop";
+        var path = Path.build_filename (directory, filename);
+        var key = new KeyFile ();
+        key.set_string ("Desktop Entry", "Type", "Application");
+        key.set_string ("Desktop Entry", "Name", window_id == "" ? "Application" : window_id);
+        key.set_string ("Desktop Entry", "Exec", "/usr/bin/false");
+        key.set_string ("Desktop Entry", "Icon", "application-default-icon");
+        key.set_boolean ("Desktop Entry", "NoDisplay", true);
+        key.set_boolean ("Desktop Entry", "X-MSeries-Transient", true);
+        try {
+            if (DirUtils.create_with_parents (directory, 0700) != 0) {
+                return null;
+            }
+            FileUtils.set_contents (path, key.to_data ());
+            return new DesktopAppInfo.from_filename (path);
+        } catch (Error error) {
+            warning ("Could not create a running-window dock item: %s", error.message);
+            return null;
+        }
+    }
+}
