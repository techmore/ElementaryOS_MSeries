diff --git a/src/Widgets/ScreenCorners.vala b/src/Widgets/ScreenCorners.vala
new file mode 100644
index 0000000..8d43d90
--- /dev/null
+++ b/src/Widgets/ScreenCorners.vala
@@ -0,0 +1,112 @@
+/*
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * SPDX-FileCopyrightText: 2026 ElementaryOS_MSeries
+ */
+
+/**
+ * Black rounded masks over the four corners of the built-in (laptop) display, so everything
+ * on the desktop (top bar, dock, maximized and tiled windows) follows the curve of the panel
+ * the way macOS does. External monitors are left alone. The actor is click-through and sits
+ * above everything else in the UI group.
+ *
+ * Radius, in logical pixels, comes from the GALA_SCREEN_CORNER_RADIUS environment variable
+ * (default 20, 0 disables the masks).
+ */
+public class Gala.ScreenCorners : CanvasActor {
+    private const double DEFAULT_RADIUS = 20.0;
+    private const double FEATHER = 1.0;
+
+    public Meta.Display display { get; construct; }
+
+    private double radius = DEFAULT_RADIUS;
+    // x, y, width, height of every built-in panel, flattened
+    private Gee.ArrayList<int> panels = new Gee.ArrayList<int> ();
+
+    public ScreenCorners (Meta.Display display) {
+        Object (display: display);
+    }
+
+    construct {
+        reactive = false;
+        name = "screen-corners";
+
+        var env = Environment.get_variable ("GALA_SCREEN_CORNER_RADIUS");
+        if (env != null && env != "") {
+            radius = double.max (0, double.parse (env));
+        }
+
+        unowned var monitor_manager = display.get_context ().get_backend ().get_monitor_manager ();
+        monitor_manager.monitors_changed.connect (update);
+
+        update ();
+    }
+
+    private void update () {
+        panels.clear ();
+
+        unowned var monitor_manager = display.get_context ().get_backend ().get_monitor_manager ();
+        foreach (unowned var logical_monitor in monitor_manager.get_logical_monitors ()) {
+            foreach (unowned var monitor in logical_monitor.get_monitors ()) {
+                if (monitor.is_builtin ()) {
+                    var geometry = display.get_monitor_geometry (logical_monitor.get_number ());
+                    panels.add (geometry.x);
+                    panels.add (geometry.y);
+                    panels.add (geometry.width);
+                    panels.add (geometry.height);
+                    break;
+                }
+            }
+        }
+
+        int stage_width, stage_height;
+        display.get_size (out stage_width, out stage_height);
+        set_position (0, 0);
+        set_size (stage_width, stage_height);
+
+        visible = radius > 0 && panels.size > 0;
+        content.invalidate ();
+    }
+
+    protected override void draw (Cairo.Context cr, int width, int height) {
+        cr.set_operator (Cairo.Operator.CLEAR);
+        cr.paint ();
+
+        cr.set_operator (Cairo.Operator.OVER);
+
+        for (int i = 0; i + 3 < panels.size; i += 4) {
+            double x = panels[i];
+            double y = panels[i + 1];
+            double w = panels[i + 2];
+            double h = panels[i + 3];
+
+            corner (cr, x, y, 1, 1);
+            corner (cr, x + w, y, -1, 1);
+            corner (cr, x, y + h, 1, -1);
+            corner (cr, x + w, y + h, -1, -1);
+        }
+    }
+
+    /**
+     * Darkens the corner square between a screen corner (cx, cy) and the quarter circle of
+     * {@link radius}. The edge is feathered by {@link FEATHER} logical pixels either side of the
+     * arc, so it reads as a smooth curve instead of a hard one-pixel staircase.
+     * dx and dy point from the corner towards the inside of the screen (+1 or -1).
+     */
+    private void corner (Cairo.Context cr, double cx, double cy, double dx, double dy) {
+        double centre_x = cx + dx * radius;
+        double centre_y = cy + dy * radius;
+
+        var gradient = new Cairo.Pattern.radial (centre_x, centre_y, double.max (0, radius - FEATHER),
+                                                 centre_x, centre_y, radius + FEATHER);
+        gradient.add_color_stop_rgba (0, 0, 0, 0, 0);
+        gradient.add_color_stop_rgba (1, 0, 0, 0, 1);
+
+        // Confine the soft band to the corner square so it never leaks along the screen edge.
+        cr.save ();
+        cr.rectangle (dx > 0 ? cx : cx - radius, dy > 0 ? cy : cy - radius, radius, radius);
+        cr.clip ();
+        cr.set_source (gradient);
+        cr.paint ();
+        cr.restore ();
+    }
+}
