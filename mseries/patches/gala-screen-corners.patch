index 0000000..8d43d90
--- /dev/null
+++ b/src/Widgets/ScreenCorners.vala
@@ -0,0 +1,119 @@
+/*
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * SPDX-FileCopyrightText: 2026 ElementaryOS_MSeries
+ */
+
+/**
+ * Black masks over the four corners of the built-in (laptop) display, so desktop content
+ * follows a continuous superellipse approximation of the panel curve. External monitors are
+ * left alone. The actor is click-through and sits above everything else in the UI group.
+ *
+ * Radius, in logical pixels, comes from GALA_SCREEN_CORNER_RADIUS (default 20; 0 disables).
+ * Its continuous superellipse approximation uses exponent n=4, matching Gala window clipping.
+ */
+public class Gala.ScreenCorners : CanvasActor {
+    private const double DEFAULT_RADIUS = 20.0;
+    private const double CURVE_EXPONENT = 4.0;
+    private const int CURVE_SEGMENTS = 64;
+
+    public Meta.Display display { get; construct; }
+
+    private double radius = DEFAULT_RADIUS;
+    // x, y, width, height of every built-in panel, flattened
+    private Gee.ArrayList<int> panels = new Gee.ArrayList<int> ();
+
+    public ScreenCorners (Meta.Display display) {
+        Object (display: display);
+    }
+
+    construct {
+        reactive = false;
+        name = "screen-corners";
+
+        var env = Environment.get_variable ("GALA_SCREEN_CORNER_RADIUS");
+        if (env != null && env != "") {
+            radius = double.max (0, double.parse (env));
+        }
+
+        unowned var monitor_manager = display.get_context ().get_backend ().get_monitor_manager ();
+        monitor_manager.monitors_changed.connect (update);
+
+        update ();
+    }
+
+    private void update () {
+        panels.clear ();
+
+        unowned var monitor_manager = display.get_context ().get_backend ().get_monitor_manager ();
+        foreach (unowned var logical_monitor in monitor_manager.get_logical_monitors ()) {
+            foreach (unowned var monitor in logical_monitor.get_monitors ()) {
+                if (monitor.is_builtin ()) {
+                    var geometry = display.get_monitor_geometry (logical_monitor.get_number ());
+                    panels.add (geometry.x);
+                    panels.add (geometry.y);
+                    panels.add (geometry.width);
+                    panels.add (geometry.height);
+                    break;
+                }
+            }
+        }
+
+        int stage_width, stage_height;
+        display.get_size (out stage_width, out stage_height);
+        set_position (0, 0);
+        set_size (stage_width, stage_height);
+
+        visible = radius > 0 && panels.size > 0;
+        content.invalidate ();
+    }
+
+    protected override void draw (Cairo.Context cr, int width, int height) {
+        cr.set_operator (Cairo.Operator.CLEAR);
+        cr.paint ();
+
+        cr.set_operator (Cairo.Operator.OVER);
+
+        for (int i = 0; i + 3 < panels.size; i += 4) {
+            double x = panels[i];
+            double y = panels[i + 1];
+            double w = panels[i + 2];
+            double h = panels[i + 3];
+
+            corner (cr, x, y, 1, 1);
+            corner (cr, x + w, y, -1, 1);
+            corner (cr, x, y + h, 1, -1);
+            corner (cr, x + w, y + h, -1, -1);
+        }
+    }
+
+    /** Paints the corner outside the shared continuous superellipse as black. */
+    private void corner (Cairo.Context cr, double cx, double cy, double dx, double dy) {
+        double centre_x = cx + dx * radius;
+        double centre_y = cy + dy * radius;
+
+        // Confine both operations to the corner square so the mask never leaks along a screen edge.
+        cr.save ();
+        cr.rectangle (dx > 0 ? cx : cx - radius, dy > 0 ? cy : cy - radius, radius, radius);
+        cr.clip ();
+        cr.set_operator (Cairo.Operator.OVER);
+        cr.set_source_rgba (0, 0, 0, 1);
+        cr.paint ();
+
+        // Clear the inside of an n=4 superellipse. Cairo antialiases its sampled boundary.
+        cr.set_operator (Cairo.Operator.CLEAR);
+        for (int i = 0; i <= CURVE_SEGMENTS; i++) {
+            double angle = Math.PI * 0.5 * i / CURVE_SEGMENTS;
+            double x = centre_x - dx * radius * Math.pow (Math.cos (angle), 2.0 / CURVE_EXPONENT);
+            double y = centre_y - dy * radius * Math.pow (Math.sin (angle), 2.0 / CURVE_EXPONENT);
+            if (i == 0) {
+                cr.move_to (x, y);
+            } else {
+                cr.line_to (x, y);
+            }
+        }
+        cr.line_to (centre_x, centre_y);
+        cr.close_path ();
+        cr.fill ();
+        cr.restore ();
+    }
+}
