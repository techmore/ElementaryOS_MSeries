+/** Per-user preference shared by the menu and the bar, without replacing system schemas. */
+public class Power.Widgets.WattSettings : Object {
+    private static WattSettings? instance = null;
+    public bool enabled { get; set; default = true; }
+
+    public static unowned WattSettings get_default () {
+        if (instance == null) instance = new WattSettings ();
+        return instance;
+    }
+
+    private static string path () {
+        return Path.build_filename (Environment.get_user_config_dir (), "mseries", "battery-meter.ini");
+    }
+
+    construct {
+        try {
+            var file = new KeyFile ();
+            file.load_from_file (path (), KeyFileFlags.NONE);
+            enabled = file.get_boolean ("panel", "show-watts");
+        } catch (Error e) {
+            // Preserve the existing display until the owner chooses otherwise.
+        }
+        notify["enabled"].connect (() => {
+            var file = new KeyFile ();
+            file.set_boolean ("panel", "show-watts", enabled);
+            DirUtils.create_with_parents (Path.get_dirname (path ()), 0755);
+            try {
+                FileUtils.set_contents (path (), file.to_data ());
+            } catch (Error e) {
+                warning ("Could not save watt display preference: %s", e.message);
+            }
+        });
+    }
+}
