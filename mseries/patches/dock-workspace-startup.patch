diff --git a/src/Application.vala b/src/Application.vala
index eea910c..5a3d1d2 100644
--- a/src/Application.vala
+++ b/src/Application.vala
@@ -18,14 +18,17 @@ public class Dock.Application : Gtk.Application {

     protected override void activate () {
-        if (active_window == null) {
-            var main_window = new MainWindow ();
+        // A supervisor or a second launcher can activate the existing instance.
+        // The compositor owns panel visibility; never request focus again here.
+        if (get_windows () != null) {
+            return;
+        }

-            add_window (main_window);
+        var main_window = new MainWindow ();
+        add_window (main_window);

-            unowned var unity_client = Unity.get_default ();
-            unity_client.add_client (AppSystem.get_default ());
-        }
+        unowned var unity_client = Unity.get_default ();
+        unity_client.add_client (AppSystem.get_default ());

-        active_window.present ();
+        main_window.present ();
     }

