+* SPDX-FileCopyrightText: 2026 ElementaryOS_MSeries
+*/
+
+/**
+ * Whether the speed readout is shown next to the network icon in the panel.
+ * Stored in ~/.config/mseries/network-speed.ini so there is no GSettings schema to install.
+ */
+public class Network.PanelSpeedSettings : Object {
+    private static PanelSpeedSettings? instance = null;
+
+    public bool enabled { get; set; default = false; }
+
+    public static unowned PanelSpeedSettings get_default () {
+        if (instance == null) {
+            instance = new PanelSpeedSettings ();
+        }
+        return instance;
+    }
+
+    private static string path () {
+        return Path.build_filename (Environment.get_user_config_dir (), "mseries", "network-speed.ini");
+    }
+
+    construct {
+        try {
+            var keyfile = new KeyFile ();
+            keyfile.load_from_file (path (), KeyFileFlags.NONE);
+            enabled = keyfile.get_boolean ("panel", "show-speed");
+        } catch (Error e) {
+            // No file yet: off by default.
+        }
+
+        notify["enabled"].connect (() => {
+            var keyfile = new KeyFile ();
+            keyfile.set_boolean ("panel", "show-speed", enabled);
+            DirUtils.create_with_parents (Path.get_dirname (path ()), 0755);
+            try {
+                FileUtils.set_contents (path (), keyfile.to_data ());
+            } catch (Error e) {
+                warning ("Could not save %s: %s", path (), e.message);
+            }
+        });
+    }
+}
+
+/**
+ * "↓ 1.2 MB/s ↑ 40 kB/s" beside the panel icon, averaged over 10 seconds. The timer only runs
+ * while the readout is enabled.
+ */
+public class Network.Widgets.PanelSpeed : Gtk.Box {
+    private Gtk.Label speed_label;
+    private const uint INTERVAL_SECONDS = 10;
+
+    private uint timeout_id = 0;
+    private uint64 last_rx = 0;
+    private uint64 last_tx = 0;
+    private int64 last_time = 0;
+    private bool have_baseline = false;
+
+    construct {
+        speed_label = new Gtk.Label (null);
+        speed_label.add_css_class ("numeric");
+        append (speed_label);
+        margin_start = 4;
+        visible = false;
+
+        var settings = PanelSpeedSettings.get_default ();
+        settings.notify["enabled"].connect (sync);
+        sync ();
+    }
+
+    private void sync () {
+        if (PanelSpeedSettings.get_default ().enabled) {
+            if (timeout_id == 0) {
+                have_baseline = false;
+                speed_label.label = "↓ … ↑ …";
+                visible = true;
+                tick ();
+                timeout_id = Timeout.add_seconds (INTERVAL_SECONDS, tick);
+            }
+        } else {
+            if (timeout_id != 0) {
+                Source.remove (timeout_id);
+                timeout_id = 0;
+            }
+            visible = false;
+        }
+    }
+
+    private bool tick () {
+        uint64 rx, tx;
+        if (!ThroughputWidget.read_counters (out rx, out tx)) {
+            return Source.CONTINUE;
+        }
+
+        var now = get_monotonic_time ();
+        if (have_baseline && now > last_time && rx >= last_rx && tx >= last_tx) {
+            double seconds = (now - last_time) / 1000000.0;
+            speed_label.label = "↓ %s  ↑ %s".printf (
+                ThroughputWidget.format_rate ((rx - last_rx) / seconds),
+                ThroughputWidget.format_rate ((tx - last_tx) / seconds)
+            );
+        }
+
+        last_rx = rx;
+        last_tx = tx;
+        last_time = now;
+        have_baseline = true;
+        return Source.CONTINUE;
+    }
+}
