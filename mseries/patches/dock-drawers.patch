+
+    // M-series: Command (Control) + left-drag slides the dock along its edge. Only active
+    // when the compositor speaks protocol version 2 (io_elementary_pantheon_panel_v1.set_offset).
+    private void init_panel_move () {
+        var drag = new Gtk.GestureDrag () {
+            button = Gdk.BUTTON_PRIMARY
+        };
+        drag.drag_begin.connect ((start_x, start_y) => {
+            if (panel == null || panel.get_version () < 2 ||
+                    (drag.get_current_event_state () & Gdk.ModifierType.CONTROL_MASK) == 0) {
+                drag.set_state (Gtk.EventSequenceState.DENIED);
+                return;
+            }
+
+            draging_panel = true;
+            panel_drag_start_offset = panel_offset;
+        });
+        drag.drag_update.connect ((offset_x, offset_y) => {
+            if (!draging_panel) {
+                return;
+            }
+
+            panel_offset = panel_drag_start_offset + (int) offset_x;
+            apply_panel_offset ();
+        });
+        drag.drag_end.connect (() => {
+            draging_panel = false;
+        });
+        // Cast to Widget: Gtk.Window also implements Gtk.ShortcutManager, whose
+        // add_controller (Gtk.ShortcutController) otherwise shadows Gtk.Widget's.
+        ((Gtk.Widget) this).add_controller (drag);
+    }
+
+    private void apply_panel_offset () {
+        if (panel != null && panel.get_version () >= 2) {
+            panel.set_offset (panel_offset);
+        }
     }
 
