+
+/** Shared look for the battery menu; matches the CodexBar dropdown (cards, chips, dock). */
+public class Power.Widgets.MenuStyle : Object {
+    private static bool installed = false;
+
+    public static void install (Gdk.Display display) {
+        if (installed) {
+            return;
+        }
+        installed = true;
+
+        var style = new Gtk.CssProvider ();
+        style.load_from_string (
+            ".mseries-battery { font-size: 8pt; } " +
+            ".mseries-battery .caption { font-size: 7pt; } " +
+            ".mseries-battery .numeric { font-feature-settings: \"tnum\"; } " +
+            ".mseries-battery .section-title { font-size: 7pt; font-weight: 700; opacity: 0.6; margin: 2px 4px 0 4px; } " +
+            ".mseries-battery .card { padding: 6px 8px; border-radius: 10px; background: alpha(currentColor, 0.06); } " +
+            ".mseries-battery .hero-percent { font-size: 22pt; font-weight: 800; font-feature-settings: \"tnum\"; } " +
+            ".mseries-battery .hero-state { font-weight: 700; } " +
+            ".mseries-battery .chip { padding: 1px 8px; border-radius: 99px; font-size: 7.5pt; font-weight: 700; " +
+            "  background: alpha(currentColor, 0.1); } " +
+            ".mseries-battery .chip.ok { background: alpha(@success_color, 0.22); color: @success_color; } " +
+            ".mseries-battery .chip.low { background: alpha(@warning_color, 0.22); color: @warning_color; } " +
+            ".mseries-battery .chip.critical { background: alpha(@error_color, 0.22); color: @error_color; } " +
+            ".mseries-battery progressbar trough, .mseries-battery progressbar progress { min-height: 6px; border-radius: 3px; } " +
+            ".mseries-battery progressbar.ok progress { background: @success_color; } " +
+            ".mseries-battery progressbar.low progress { background: @warning_color; } " +
+            ".mseries-battery progressbar.critical progress { background: @error_color; } " +
+            ".mseries-battery .tile { padding: 4px 2px; border-radius: 8px; background: alpha(currentColor, 0.06); } " +
+            ".mseries-battery .tile-value { font-weight: 700; font-feature-settings: \"tnum\"; } " +
+            ".mseries-battery .mseries-dock { padding: 3px; border-radius: 12px; background: alpha(currentColor, 0.06); } " +
+            ".mseries-battery .mseries-dock button { padding: 4px 6px; border-radius: 9px; min-height: 0; min-width: 0; } " +
+            ".mseries-battery .mseries-dock button:hover { background: alpha(currentColor, 0.1); } " +
+            ".mseries-battery .mseries-dock button:checked { background: alpha(@accent_color, 0.22); color: @accent_color; } " +
+            ".mseries-battery .prefs-row, .mseries-battery .prefs-row label { font-size: 8pt; } " +
+            ".mseries-battery .devices row { background: none; border-radius: 8px; padding: 0; } " +
+            ".mseries-battery .devices row:hover { background: alpha(currentColor, 0.08); }"
+        );
+        Gtk.StyleContext.add_provider_for_display (display, style, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION);
+    }
+}
+
+/** One small stat (value over caption); hides itself when there is nothing to show. */
+public class Power.Widgets.StatTile : Gtk.Box {
+    private Gtk.Label value_label;
+
+    public StatTile (string title) {
+        Object (orientation: Gtk.Orientation.VERTICAL, spacing: 0, homogeneous: false, hexpand: true);
+
+        value_label = new Gtk.Label ("") { halign = Gtk.Align.CENTER };
+        value_label.add_css_class ("tile-value");
+
+        var title_label = new Gtk.Label (title) { halign = Gtk.Align.CENTER };
+        title_label.add_css_class ("caption");
+        title_label.add_css_class ("dim-label");
+
+        add_css_class ("tile");
+        append (value_label);
+        append (title_label);
+    }
+
+    public void set_stat (string? text, string? tooltip = null) {
+        visible = text != null;
+        value_label.label = text ?? "";
+        tooltip_text = tooltip;
+    }
+}
+
+/** Headline card: charge level, state, time estimate, and the numbers that matter. */
+public class Power.Widgets.BatteryHero : Gtk.Box {
+    private Services.DeviceManager dm;
+    private Services.Device? battery = null;
+
+    private Gtk.Image icon;
+    private Gtk.Label percent_label;
+    private Gtk.Label detail_label;
+    private Gtk.Label chip_label;
+    private Gtk.ProgressBar bar;
+    private Gtk.Label energy_label;
+    private Gtk.Label limit_label;
+    private StatTile power_tile;
+    private StatTile health_tile;
+    private StatTile cycles_tile;
+    private StatTile temp_tile;
+
+    construct {
+        dm = Services.DeviceManager.get_default ();
+
+        orientation = Gtk.Orientation.VERTICAL;
+        spacing = 6;
+        add_css_class ("card");
+
+        icon = new Gtk.Image () { pixel_size = 40, valign = Gtk.Align.CENTER };
+
+        percent_label = new Gtk.Label ("") { halign = Gtk.Align.START };
+        percent_label.add_css_class ("hero-percent");
+
+        detail_label = new Gtk.Label ("") { halign = Gtk.Align.START, xalign = 0, wrap = true };
+        detail_label.add_css_class ("hero-state");
+
+        var text_box = new Gtk.Box (Gtk.Orientation.VERTICAL, 0) { hexpand = true, valign = Gtk.Align.CENTER };
+        text_box.append (percent_label);
+        text_box.append (detail_label);
+
+        chip_label = new Gtk.Label ("") { valign = Gtk.Align.START };
+        chip_label.add_css_class ("chip");
+
+        var top = new Gtk.Box (Gtk.Orientation.HORIZONTAL, 8);
+        top.append (icon);
+        top.append (text_box);
+        top.append (chip_label);
+
+        bar = new Gtk.ProgressBar ();
+
+        energy_label = new Gtk.Label ("") { halign = Gtk.Align.START, hexpand = true };
+        energy_label.add_css_class ("caption");
+        energy_label.add_css_class ("dim-label");
+        energy_label.add_css_class ("numeric");
+
+        limit_label = new Gtk.Label ("") { halign = Gtk.Align.END, visible = false };
+        limit_label.add_css_class ("caption");
+        limit_label.add_css_class ("dim-label");
+
+        var energy_row = new Gtk.Box (Gtk.Orientation.HORIZONTAL, 6);
+        energy_row.append (energy_label);
+        energy_row.append (limit_label);
+
+        power_tile = new StatTile (_("Power"));
+        health_tile = new StatTile (_("Health"));
+        cycles_tile = new StatTile (_("Cycles"));
+        temp_tile = new StatTile (_("Temp"));
+
+        var tiles = new Gtk.Box (Gtk.Orientation.HORIZONTAL, 4) { homogeneous = true };
+        tiles.append (power_tile);
+        tiles.append (health_tile);
+        tiles.append (cycles_tile);
+        tiles.append (temp_tile);
+
+        append (top);
+        append (bar);
+        append (energy_row);
+        append (tiles);
+
+        // Peripherals share the list; the internal battery is the first device of type BATTERY.
+        foreach (var device in dm.devices.values) {
+            adopt (device);
+        }
+        dm.battery_registered.connect ((path, device) => adopt (device));
+
+        dm.display_device.properties_updated.connect (refresh);
+        WattSettings.get_default ().notify["watts"].connect (refresh);
+        refresh ();
+    }
+
+    private void adopt (Services.Device device) {
+        if (battery != null || device.device_type != Services.Device.Type.BATTERY) {
+            return;
+        }
+        battery = device;
+        battery.properties_updated.connect (refresh);
+        refresh ();
+    }
+
+    private static string format_duration (int64 seconds) {
+        int64 minutes = (seconds + 30) / 60;
+        if (minutes < 1) {
+            minutes = 1;
+        }
+        if (minutes >= 60) {
+            ///Translators: duration such as "1 h 24 min"
+            return _("%lld h %02lld min").printf (minutes / 60, minutes % 60);
+        }
+        ///Translators: duration such as "24 min"
+        return _("%lld min").printf (minutes);
+    }
+
+    private void set_level (string level) {
+        foreach (unowned var name in new string[] { "ok", "low", "critical" }) {
+            bar.remove_css_class (name);
+            chip_label.remove_css_class (name);
+        }
+        if (level != "") {
+            bar.add_css_class (level);
+            chip_label.add_css_class (level);
+        }
+    }
+
+    private void refresh () {
+        var overall = dm.display_device;
+        if (overall == null) {
+            return;
+        }
+
+        var info = battery ?? overall;
+        double percentage = overall.percentage;
+        var state = overall.state;
+
+        icon.icon_name = overall.get_icon_name_for_battery ();
+        percent_label.label = _("%.0f%%").printf (percentage);
+        bar.fraction = (percentage / 100.0).clamp (0.0, 1.0);
+
+        uint limit = battery != null ? battery.charge_end_threshold : 0;
+        bool at_limit = limit > 0 && limit < 100 && percentage >= limit - 3
+            && state != Services.Device.State.CHARGING;
+
+        string chip;
+        string level = "ok";
+        string detail;
+
+        switch (state) {
+            case Services.Device.State.CHARGING:
+                chip = _("Charging");
+                detail = overall.time_to_full > 0
+                    ? _("%s until full").printf (format_duration (overall.time_to_full))
+                    : _("Estimating time…");
+                break;
+            case Services.Device.State.FULLY_CHARGED:
+                chip = _("Full");
+                detail = _("Fully charged");
+                break;
+            case Services.Device.State.PENDING_CHARGE:
+            case Services.Device.State.PENDING_DISCHARGE:
+                chip = at_limit ? _("Limit reached") : _("Plugged in");
+                detail = at_limit
+                    ? _("Holding at %u%% to protect the battery").printf (limit)
+                    : _("Not charging");
+                break;
+            default:
+                if (percentage < 10) {
+                    chip = _("Critical");
+                    level = "critical";
+                } else if (percentage < 20) {
+                    chip = _("Low");
+                    level = "low";
+                } else {
+                    chip = _("On battery");
+                    level = "";
+                }
+                detail = overall.time_to_empty > 0
+                    ? _("%s remaining").printf (format_duration (overall.time_to_empty))
+                    : _("Estimating time…");
+                break;
+        }
+
+        chip_label.label = chip;
+        detail_label.label = detail;
+        set_level (level);
+
+        if (info.energy_full > 0) {
+            ///Translators: stored energy out of capacity, e.g. "49.5 of 63.1 Wh"
+            energy_label.label = _("%.1f of %.1f Wh").printf (info.energy, info.energy_full);
+        } else {
+            energy_label.label = "";
+        }
+
+        limit_label.visible = limit > 0 && limit < 100;
+        limit_label.label = _("Charge limit %u%%").printf (limit);
+
+        double watts = WattSettings.get_default ().watts;
+        power_tile.set_stat (
+            watts >= 0.1 ? _("%.1f W").printf (watts) : _("0 W"),
+            _("Power drawn by the whole computer right now")
+        );
+
+        double health = info.capacity;
+        if (health <= 0 && info.energy_full_design > 0) {
+            health = 100.0 * info.energy_full / info.energy_full_design;
+        }
+        health_tile.set_stat (
+            health > 0 ? _("%.0f%%").printf (health) : null,
+            _("Maximum capacity compared with when the battery was new (%.1f of %.1f Wh)")
+                .printf (info.energy_full, info.energy_full_design)
+        );
+
+        cycles_tile.set_stat (
+            info.charge_cycles > 0 ? "%d".printf (info.charge_cycles) : null,
+            _("Full charge cycles")
+        );
+        temp_tile.set_stat (
+            info.temperature > 0 ? _("%.0f °C").printf (info.temperature) : null,
+            _("Battery temperature")
+        );
+    }
+}
