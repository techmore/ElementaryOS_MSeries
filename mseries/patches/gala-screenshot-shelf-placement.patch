+    // The screenshot shelf is a plain Wayland window (so drag and drop to Wayland apps works) that cannot
+    // place itself: keep it in the bottom-right corner of the primary monitor, above other windows.
+    private const string SCREENSHOT_SHELF_APP_ID = "org.techmore.mseries.ScreenshotShelf";
+    private const int SCREENSHOT_SHELF_MARGIN = 24;
+
+    private void watch_screenshot_shelf (Meta.Window window) {
+        if (window.get_gtk_application_id () == SCREENSHOT_SHELF_APP_ID) {
+            adopt_screenshot_shelf (window);
+            return;
+        }
+
+        window.notify["gtk-application-id"].connect (() => {
+            if (window.get_gtk_application_id () == SCREENSHOT_SHELF_APP_ID) {
+                adopt_screenshot_shelf (window);
+            }
+        });
+    }
+
+    private void adopt_screenshot_shelf (Meta.Window window) {
+        if (window.get_data<bool> ("mseries-shelf")) {
+            return;
+        }
+        window.set_data<bool> ("mseries-shelf", true);
+
+        ManagedClient.make_dock (window);
+        window.stick ();
+        window.size_changed.connect (place_screenshot_shelf);
+        window.shown.connect (place_screenshot_shelf);
+        place_screenshot_shelf (window);
+    }
+
+    private void place_screenshot_shelf (Meta.Window window) {
+        var display = window.display;
+        var area = display.get_monitor_geometry (display.get_primary_monitor ());
+        var frame = window.get_frame_rect ();
+        var x = area.x + area.width - frame.width - SCREENSHOT_SHELF_MARGIN;
+        var y = area.y + area.height - frame.height - SCREENSHOT_SHELF_MARGIN;
+        if (frame.x != x || frame.y != y) {
+            window.move_frame (false, x, y);
+        }
+    }
+
