@@ -28,6 +28,88 @@ public class Wingpanel.Widgets.Panel : Granite.Bin {
     private Gtk.SortListModel sorted_indicator_entries;

     private double current_scroll_delta = 0;
+    private bool notch_active = false;
+    private int notch_width = 1512;
+    private Gtk.CustomFilter left_filter;
+    private Gtk.CustomFilter center_filter;
+    private Gtk.CustomFilter right_filter;
+    private Gtk.ScrolledWindow left_scroll;
+    private Gtk.ScrolledWindow right_scroll;
+    private IndicatorBar center_menubar;
+
+    // Full-height J314 panel: use the existing native clock/popover beside the
+    // camera, with independently scrollable halves so crowded indicators cannot
+    // push controls into the cutout. No extra daemon or second clock.
+    public void update_notch (Gdk.Monitor monitor) {
+        string model = "";
+        string enabled = "";
+        try {
+            FileUtils.get_contents ("/proc/device-tree/model", out model);
+            FileUtils.get_contents ("/sys/module/appledrm/parameters/show_notch", out enabled);
+        } catch (FileError e) {
+            // Other computers keep the stock layout.
+        }
+        var geometry = monitor.geometry;
+        var active = NotchLayout.is_active (model, monitor.connector, enabled,
+            geometry.width, geometry.height);
+        var logical_width = geometry.width;
+        if (!Services.DisplayConfig.is_logical_layout ()) {
+            logical_width /= get_scale_factor ();
+        }
+        notch_width = logical_width;
+        var depth = active ? NotchLayout.depth (logical_width) : -1;
+        height_request = depth;
+        var gap = active ? NotchLayout.gap (logical_width) : 0;
+        left_scroll.margin_end = gap / 2;
+        right_scroll.margin_start = gap / 2;
+        if (active == notch_active) {
+            return;
+        }
+        notch_active = active;
+        // Remove the native clock from its old FlowBox before adding it to
+        // the other one; GTK widgets cannot have two parents during refiltering.
+        if (notch_active) {
+            center_filter.changed (DIFFERENT);
+            left_filter.changed (DIFFERENT);
+        } else {
+            left_filter.changed (DIFFERENT);
+            center_filter.changed (DIFFERENT);
+        }
+        right_filter.changed (DIFFERENT);
+        rebuild_layout ();
+    }
+
+    private void rebuild_layout () {
+        if (child is Gtk.CenterBox) {
+            var old = (Gtk.CenterBox) child;
+            old.set_start_widget (null);
+            old.set_center_widget (null);
+            old.set_end_widget (null);
+        } else if (child is Gtk.Box) {
+            var old = (Gtk.Box) child;
+            old.remove (left_scroll);
+            old.remove (right_scroll);
+        }
+        left_scroll.propagate_natural_width = !notch_active;
+        right_scroll.propagate_natural_width = !notch_active;
+        left_scroll.hexpand = right_scroll.hexpand = notch_active;
+        if (notch_active) {
+            child = NotchLayout.halves (left_scroll, right_scroll, notch_width);
+        } else {
+            var centered = new Gtk.CenterBox ();
+            centered.set_start_widget (left_scroll);
+            centered.set_center_widget (center_menubar);
+            centered.set_end_widget (right_scroll);
+            child = centered;
+        }
+    }
+
+    private Gtk.ScrolledWindow scroll_bar (IndicatorBar bar, Gtk.Align alignment) {
+        bar.halign = alignment;
+        var scroll = new Gtk.ScrolledWindow () { child = bar };
+        scroll.set_policy (EXTERNAL, NEVER);
+        return scroll;
+    }

