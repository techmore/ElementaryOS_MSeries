new file mode 100644
index 0000000..9a0446a
--- /dev/null
+++ b/src/Widgets/NotchLayout.vala
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// M-series J314 physical camera geometry; values below are logical pixel sizes.
+public class Wingpanel.Widgets.NotchLayout : Object {
+    public static bool is_active (string model, string? connector, string enabled, int width, int height) {
+        return model.contains ("14-inch, M1 Pro") && connector != null &&
+            connector.has_prefix ("eDP") && enabled.strip () == "Y" &&
+            (int64) width * 100 < (int64) height * 158;
+    }
+
+    public static int depth (int width) {
+        return (int) Math.ceil (74.0 * width / 3024.0);
+    }
+
+    public static int gap (int width) {
+        // Conservative 400 physical pixels, plus a logical margin for controls.
+        return (int) Math.ceil (400.0 * width / 3024.0) + 16;
+    }
+
+    public static Gtk.Box halves (Gtk.ScrolledWindow left, Gtk.ScrolledWindow right, int width) {
+        left.margin_end = right.margin_start = gap (width) / 2;
+        left.propagate_natural_width = right.propagate_natural_width = false;
+        left.hexpand = right.hexpand = true;
+        var box = new Gtk.Box (HORIZONTAL, 0) { homogeneous = true };
+        box.append (left);
+        box.append (right);
+        return box;
+    }
+}
