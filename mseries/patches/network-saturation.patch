+    /**
+     * Wraps text in the saturated colour when asked to.
+     */
+    public static string tint (string text, bool saturated) {
+        if (!saturated) {
+            return text;
+        }
+
+        return "<span foreground=\"%s\" weight=\"bold\">%s</span>".printf (SATURATED_COLOR, text);
+    }
+
+    public static bool is_saturated (double bytes_per_second, double capacity) {
+        return capacity > 0 && bytes_per_second >= capacity;
+    }
+
+    /**
+     * What the active connection can carry per direction, in bytes/s, already scaled to the
+     * share that counts as saturated. Zero when NetworkManager has no link speed (then nothing
+     * is highlighted). When Wi-Fi and Ethernet are both up, the faster one is used.
+     */
+    public static void get_capacity (out double down, out double up) {
+        down = 0;
+        up = 0;
+
+        if (nm_client == null) {
+            try {
+                nm_client = new NM.Client ();
+            } catch (Error e) {
+                warning ("Could not read link speed from NetworkManager: %s", e.message);
+                return;
+            }
+        }
+
+        if (nm_client == null || !nm_client.nm_running) {
+            return;
+        }
+
+        double best = 0;
+        foreach (unowned var device in nm_client.get_devices ()) {
+            if (device.get_state () != NM.DeviceState.ACTIVATED) {
+                continue;
+            }
+
+            double rate = 0;
+            if (device is NM.DeviceEthernet) {
+                // Mbit/s -> bytes/s
+                rate = ((NM.DeviceEthernet) device).get_speed () * 125000.0 * WIRED_USABLE;
+            } else if (device is NM.DeviceWifi) {
+                // kbit/s -> bytes/s
+                rate = ((NM.DeviceWifi) device).get_bitrate () * 125.0 * WIFI_USABLE;
+            }
+
+            best = double.max (best, rate);
+        }
+
+        down = best;
+        up = best;
+    }
+
     public static string format_rate (double bytes_per_second) {
         if (bytes_per_second < 1000) {
             return "%d B/s".printf ((int) bytes_per_second);
