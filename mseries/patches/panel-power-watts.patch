+    public void show_power_draw (double watts, bool charging) {
+        // UPower reports the draw as a positive number for both directions; below 0.1 W it is noise
+        // (fully charged on AC), so hide the label rather than show "0.0 W".
+        if (watts < 0.1) {
+            power_draw_revealer.reveal_child = false;
+            power_draw_label.label = "";
+            return;
+        }
+
+        ///Translators: This represents battery power in watts with one decimal, e.g. "12.3 W"
+        power_draw_label.label = _("%.1f W").printf (watts);
+        power_draw_label.tooltip_text = charging
+            ? _("Battery is charging at %.1f W").printf (watts)
+            : _("The computer is using %.1f W from the battery").printf (watts);
+        power_draw_revealer.reveal_child = true;
+    }
