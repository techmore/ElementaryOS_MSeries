diff --git a/src/Indicator.vala b/src/Indicator.vala
index 0154cb8..75c1699 100644
--- a/src/Indicator.vala
+++ b/src/Indicator.vala
@@ -55,10 +55,74 @@ public class Power.Indicator : Wingpanel.Indicator {
         settings = new GLib.Settings ("io.elementary.panel.power");
     }
 
+    private string? system_power_path = null;
+
+    /* Apple Silicon's SMC exposes the whole machine's power ("Total System Power"), which is what the
+     * owner wants to see on battery and on the charger alike. */
+    private string? find_system_power_path () {
+        try {
+            var dir = Dir.open ("/sys/class/hwmon");
+            string? name;
+            while ((name = dir.read_name ()) != null) {
+                var base_dir = Path.build_filename ("/sys/class/hwmon", name);
+                string chip;
+                if (!FileUtils.get_contents (Path.build_filename (base_dir, "name"), out chip) ||
+                    chip.strip () != "macsmc_hwmon") {
+                    continue;
+                }
+
+                for (int i = 1; i <= 8; i++) {
+                    string label;
+                    if (FileUtils.get_contents (Path.build_filename (base_dir, "power%d_label".printf (i)), out label) &&
+                        label.strip () == "Total System Power") {
+                        return Path.build_filename (base_dir, "power%d_input".printf (i));
+                    }
+                }
+            }
+        } catch (Error e) {
+            debug ("No system power sensor: %s", e.message);
+        }
+
+        return null;
+    }
+
+    private double read_system_watts () {
+        if (system_power_path == null) {
+            return -1.0;
+        }
+
+        try {
+            string contents;
+            FileUtils.get_contents (system_power_path, out contents);
+            return double.parse (contents.strip ()) / 1000000.0;
+        } catch (FileError e) {
+            return -1.0;
+        }
+    }
+
+    private void update_power_draw () {
+        if (display_widget == null || display_device == null) {
+            return;
+        }
+
+        double watts = read_system_watts ();
+        if (watts < 0.0) {
+            watts = display_device.energy_rate;
+        }
+
+        display_widget.show_power_draw (watts, display_device.is_charging);
+    }
+
     public override Gtk.Widget get_display_widget () {
         if (display_widget == null) {
             display_widget = new Widgets.DisplayWidget ();
 
+            system_power_path = find_system_power_path ();
+            Timeout.add_seconds (2, () => {
+                update_power_draw ();
+                return Source.CONTINUE;
+            });
+
             /* No need to display the indicator when the device is completely in AC mode */
             if (dm.has_battery || dm.backlight.present) {
                 update_visibility ();
@@ -161,6 +225,8 @@ public class Power.Indicator : Wingpanel.Indicator {
                 display_device.is_charging ? display_device.time_to_full : 0
             );
 
+            update_power_draw ();
+
             update_tooltip ();
         }
     }
