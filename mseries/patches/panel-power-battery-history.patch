+/*
+ * Battery dropdown: shows what the Battery logger writes to ~/.cache/mseries-battery/summary.txt (headline,
+ * detail, six-hour watts sparkline, then stat/run/app/tip rows). An explicit button opens Battery.
+ * Hidden until the logger has data, in which case the stock device list stays.
+ */
+public class Power.Widgets.HistoryCard : Gtk.Box {
+    private Gtk.Label headline_label;
+    private Gtk.Label detail_label;
+    private Gtk.DrawingArea spark;
+    private Gtk.Box sections;
+    private Gtk.Box activity;
+    private Gtk.Expander details;
+    private uint refresh_timer = 0;
+    private string last_contents = "";
+    private double[] points = {};
+
+    construct {
+        orientation = Gtk.Orientation.VERTICAL;
+        spacing = 10;
+        margin_top = 10; margin_bottom = 10; margin_start = 12; margin_end = 12;
+        add_css_class ("mseries-battery-summary");
+        var style = new Gtk.CssProvider ();
+        style.load_from_string (
+            ".mseries-battery-summary .battery-overview { padding: 12px; border-radius: 12px; background: alpha(currentColor, 0.05); } " +
+            ".mseries-battery-summary .battery-remaining { font-size: 1.6em; font-weight: 700; } " +
+            ".mseries-battery-summary .battery-stat .heading { font-size: 1.1em; font-weight: 600; } " +
+            ".mseries-battery-summary .battery-stat { padding: 8px; border-radius: 8px; background: alpha(currentColor, 0.04); }");
+        Gtk.StyleContext.add_provider_for_display (get_display (), style, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION);
+
+        headline_label = new Gtk.Label (null) {
+            halign = START,
+            xalign = 0, wrap = true, max_width_chars = 28
+        };
+        headline_label.add_css_class ("battery-remaining");
+
+        detail_label = new Gtk.Label (null) {
+            halign = START,
+            xalign = 0, wrap = true, max_width_chars = 32
+        };
+        detail_label.add_css_class ("dim-label");
+
+        var top = new Gtk.Box (Gtk.Orientation.VERTICAL, 4);
+        var title = new Gtk.Label (_("Battery")) { xalign = 0 };
+        title.add_css_class ("heading");
+        top.append (title);
+        top.append (headline_label);
+        top.append (detail_label);
+
+        spark = new Gtk.DrawingArea () {
+            content_height = 40,
+            hexpand = true
+        };
+        spark.set_draw_func (draw_spark);
+
+        sections = new Gtk.Box (Gtk.Orientation.VERTICAL, 8);
+
+        var box = new Gtk.Box (Gtk.Orientation.VERTICAL, 8) {
+            width_request = 280
+        };
+        box.append (top);
+        box.append (spark);
+        box.add_css_class ("battery-overview");
+        append (box);
+        append (sections);
+        activity = new Gtk.Box (Gtk.Orientation.VERTICAL, 6);
+        details = new Gtk.Expander (_("Recent activity")) {
+            child = new Gtk.ScrolledWindow () {
+                child = activity, hscrollbar_policy = Gtk.PolicyType.NEVER,
+                propagate_natural_height = true, min_content_height = 160, max_content_height = 220
+            }
+        };
+        append (details);
+        var open = new Gtk.Button.with_label (_("Open Battery…"));
+        open.add_css_class ("suggested-action");
+        append (open);
+
+        refresh ();
+        map.connect (() => {
+            refresh ();
+            if (refresh_timer != 0) return;
+            weak HistoryCard card = this;
+            refresh_timer = Timeout.add_seconds (15, () => {
+                if (card == null) return Source.REMOVE;
+                card.refresh ();
+                return Source.CONTINUE;
+            });
+        });
+        unmap.connect (stop_refresh);
+
+        open.clicked.connect (() => {
+            var app = new DesktopAppInfo ("org.mseries.Battery.desktop");
+            if (app == null) {
+                return;
+            }
+
+            try {
+                app.launch (null, null);
+            } catch (Error e) {
+                warning ("Failed to open Battery: %s", e.message);
+            }
+        });
+    }
+
+    private void stop_refresh () {
+        if (refresh_timer != 0) { Source.remove (refresh_timer); refresh_timer = 0; }
+    }
+
+    public override void dispose () {
+        stop_refresh ();
+        base.dispose ();
+    }
+
+    private Gtk.Label small_label (string text, bool dim, Gtk.Align align = Gtk.Align.START) {
+        var label = new Gtk.Label (text) {
+            halign = align,
+            xalign = align == Gtk.Align.END ? 1 : 0,
+            ellipsize = Pango.EllipsizeMode.END,
+            max_width_chars = 24,
+            tooltip_text = text
+        };
+        if (dim) {
+            label.add_css_class ("dim-label");
+        }
+        return label;
+    }
+
+    private Gtk.Label title_label (string text) {
+        var label = small_label (text, true);
+        label.add_css_class ("caption-heading");
+        label.margin_top = 4;
+        return label;
+    }
+
+    private void refresh () {
+        string contents;
+        var path = Path.build_filename (Environment.get_user_cache_dir (), "mseries-battery", "summary.txt");
+        try {
+            FileUtils.get_contents (path, out contents);
+        } catch (Error e) {
+            visible = false;
+            return;
+        }
+
+        var lines = contents.split ("
+");
+        if (lines.length < 1 || lines[0] == "") {
+            visible = false;
+            return;
+        }
+
+        if (visible && contents == last_contents) return;
+        last_contents = contents;
+        headline_label.label = lines[0];
+        detail_label.label = lines.length > 1 ? lines[1] : "";
+        double[] parsed = {};
+        if (lines.length > 2 && lines[2] != "") {
+            foreach (unowned string part in lines[2].split (",")) {
+                parsed += double.parse (part);
+            }
+        }
+        points = parsed;
+        spark.visible = points.length >= 2;
+        spark.queue_draw ();
+
+        Gtk.Widget? old;
+        while ((old = sections.get_first_child ()) != null) {
+            sections.remove (old);
+        }
+
+        while (activity.get_first_child () != null) activity.remove (activity.get_first_child ());
+        var stats = new Gtk.FlowBox () {
+            homogeneous = true, selection_mode = Gtk.SelectionMode.NONE,
+            min_children_per_line = 1, max_children_per_line = 2,
+            column_spacing = 6, row_spacing = 6
+        };
+        var runs = new Gtk.Box (Gtk.Orientation.VERTICAL, 3);
+        var apps = new Gtk.Box (Gtk.Orientation.VERTICAL, 3);
+        var devices = new Gtk.Box (Gtk.Orientation.VERTICAL, 3);
+        var profiles = new Gtk.Box (Gtk.Orientation.VERTICAL, 3);
+        var events = new Gtk.Box (Gtk.Orientation.VERTICAL, 3);
+        string? tip_title = null;
+        string? tip_body = null;
+        for (var i = 3; i < lines.length; i++) {
+            var f = lines[i].split ("	");
+            if (f[0] == "stat" && f.length >= 4) {
+                var cell = new Gtk.Box (Gtk.Orientation.VERTICAL, 1) {
+                    halign = START
+                };
+                cell.add_css_class ("battery-stat");
+                cell.append (small_label (f[1], true));
+                var value = small_label (f[2], false);
+                value.add_css_class ("heading");
+                cell.append (value);
+                cell.append (small_label (f[3], true));
+                stats.insert (cell, -1);
+            } else if (f[0] == "run" && f.length >= 5) {
+                var row = new Gtk.Box (Gtk.Orientation.HORIZONTAL, 8);
+                var when = small_label ("%s · %s".printf (f[1], f[2]), false);
+                when.hexpand = true;
+                row.append (when);
+                row.append (small_label ("%s  %s".printf (f[3], f[4]), true, Gtk.Align.END));
+                runs.append (row);
+            } else if (f[0] == "app" && f.length >= 3) {
+                var row = new Gtk.Box (Gtk.Orientation.HORIZONTAL, 8);
+                var name = small_label (f[1], false);
+                name.hexpand = true;
+                row.append (name);
+                row.append (small_label (f[2], true, Gtk.Align.END));
+                apps.append (row);
+            } else if (f[0] == "device" && f.length >= 4) {
+                var row = new Gtk.Box (Gtk.Orientation.HORIZONTAL, 8);
+                var name = small_label (f[1], false);
+                name.hexpand = true;
+                name.max_width_chars = 24;
+                row.append (name);
+                row.append (small_label (f[2], false, Gtk.Align.END));
+                devices.append (row);
+            } else if ((f[0] == "profile" || f[0] == "event") && f.length >= 4) {
+                var row = new Gtk.Box (Gtk.Orientation.HORIZONTAL, 8);
+                var name = small_label (f[1], false);
+                row.append (name);
+                var mid = small_label (f[3], true);
+                mid.hexpand = true;
+                mid.max_width_chars = 22;
+                row.append (mid);
+                var value = small_label (f[2], false, Gtk.Align.END);
+                value.add_css_class ("numeric");
+                value.max_width_chars = 12;
+                row.append (value);
+                if (f[0] == "event") {
+                    events.append (row);
+                } else {
+                    profiles.append (row);
+                }
+            } else if (f[0] == "tip" && f.length >= 3) {
+                tip_title = f[1];
+                tip_body = f[2];
+            }
+        }
+
+        if (stats.get_first_child () != null) {
+            sections.append (stats);
+        }
+        if (runs.get_first_child () != null) {
+            activity.append (title_label (_("Recent runs on battery")));
+            activity.append (runs);
+        }
+        if (apps.get_first_child () != null) {
+            activity.append (title_label (_("Biggest CPU users on battery")));
+            activity.append (apps);
+        }
+        if (profiles.get_first_child () != null) {
+            activity.append (title_label (_("Power profiles")));
+            activity.append (profiles);
+        }
+        if (events.get_first_child () != null) {
+            activity.append (title_label (_("Recent power changes")));
+            activity.append (events);
+        }
+        if (devices.get_first_child () != null) {
+            activity.append (title_label (_("Accessories")));
+            activity.append (devices);
+        }
+        if (tip_title != null) {
+            activity.append (title_label (_("Suggestion")));
+            var tip = small_label (tip_title, false);
+            tip.add_css_class ("heading");
+            activity.append (tip);
+            activity.append (small_label (tip_body, true));
+        }
+        details.visible = activity.get_first_child () != null;
+        visible = true;
+    }
+
+    private void draw_spark (Gtk.DrawingArea area, Cairo.Context cr, int width, int height) {
+        if (points.length < 2) {
+            return;
+        }
+
+        double peak = 5;
+        foreach (var watts in points) {
+            peak = double.max (peak, watts);
+        }
+
+        Gdk.RGBA fg = area.get_color ();
+        cr.set_source_rgba (fg.red, fg.green, fg.blue, 0.12);
+        cr.set_line_width (1);
+        cr.move_to (0, height - 0.5);
+        cr.line_to (width, height - 0.5);
+        cr.stroke ();
+
+        var last = points.length - 1;
+        cr.move_to (0, height - (height - 2) * points[0] / peak);
+        for (var i = 1; i <= last; i++) {
+            cr.line_to (width * i / (double) last, height - (height - 2) * points[i] / peak);
+        }
+        cr.set_source_rgba (0.21, 0.54, 0.90, 1);
+        cr.set_line_width (1.6);
+        cr.stroke_preserve ();
+        cr.line_to (width, height);
+        cr.line_to (0, height);
+        cr.close_path ();
+        cr.set_source_rgba (0.21, 0.54, 0.90, 0.16);
+        cr.fill ();
+
+        cr.set_font_size (10);
+        cr.set_source_rgba (fg.red, fg.green, fg.blue, 0.6);
+        Cairo.TextExtents ext;
+        var top_text = "%.0f W".printf (peak);
+        cr.text_extents (top_text, out ext);
+        cr.move_to (width - ext.width - 2, 10);
+        cr.show_text (top_text);
+        cr.move_to (2, height - 4);
+        cr.show_text (_("6 h ago"));
+    }
+}
