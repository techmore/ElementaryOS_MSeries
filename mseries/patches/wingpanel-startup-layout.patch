-        flow_box.bind_model (indicator_entries, (indicator_entry) => (IndicatorEntry) indicator_entry);
+        resume_model ();
 
         indicator_entries.items_changed.connect (update_flow_box_max_children);
 
         child = flow_box;
     }
 
+    // Detach entries from their old FlowBoxChild before another bar adopts
+    // them when the clock moves between the centered and notch layouts.
+    public void suspend_model () {
+        flow_box.bind_model (null, null);
+    }
+
+    public void resume_model () {
+        flow_box.bind_model (indicator_entries, (indicator_entry) => (IndicatorEntry) indicator_entry);
+        update_flow_box_max_children ();
+    }
+
     private void update_flow_box_max_children () {
-        flow_box.max_children_per_line = indicator_entries.get_n_items ();
+        flow_box.max_children_per_line = uint.max (1, indicator_entries.get_n_items ());
     }
