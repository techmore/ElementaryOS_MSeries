diff --git a/data/shaders/window-corners.frag b/data/shaders/window-corners.frag
new file mode 100644
index 00000000..202abdc9
--- /dev/null
+++ b/data/shaders/window-corners.frag
@@ -0,0 +1,65 @@
+/*
+ * SPDX-License-Identifier: LGPL-3.0-or-later
+ * SPDX-FileCopyrightText: 2026 ElementaryOS_MSeries
+ *
+ * Rounds the corners of a window's frame while leaving its shadow (and
+ * everything on the straight edges) intact. The masks are the same four
+ * corner squares macOS rounds.
+ *
+ * Derived from Gala's rounded-corners.frag, which is based on the shader in mutter.
+ */
+
+uniform sampler2D tex;
+uniform float clip_radius;
+uniform vec2 actor_size;
+uniform vec2 offset;
+uniform vec2 full_texture_size;
+
+float rounded_rect_coverage (vec2 p) {
+  float center_left = clip_radius;
+  float center_right = actor_size.x - clip_radius;
+
+  float center_x;
+  if (p.x < center_left)
+    center_x = center_left;
+  else if (p.x > center_right)
+    center_x = center_right;
+  else
+    return 1.0;
+
+  float center_top = clip_radius;
+  float center_bottom = actor_size.y - clip_radius;
+
+  float center_y;
+  if (p.y < center_top)
+    center_y = center_top;
+  else if (p.y > center_bottom)
+    center_y = center_bottom;
+  else
+    return 1.0;
+
+  vec2 delta = p - vec2 (center_x, center_y);
+  float dist_squared = dot (delta, delta);
+
+  // Fully outside the circle
+  float outer_radius = clip_radius + 0.5;
+  if (dist_squared > (outer_radius * outer_radius))
+    return 0.0;
+
+  // Fully inside the circle
+  float inner_radius = clip_radius - 0.5;
+  if (dist_squared < (inner_radius * inner_radius))
+    return 1.0;
+
+  // Only pixels on the edge of the curve need expensive antialiasing
+  return smoothstep (outer_radius, inner_radius, sqrt (dist_squared));
+}
+
+void main () {
+  vec2 texture_coord = cogl_tex_coord0_in.xy * full_texture_size;
+  texture_coord -= offset;
+
+  vec4 sample = texture2D (tex, cogl_tex_coord0_in.xy);
+  float res = rounded_rect_coverage (texture_coord);
+  cogl_color_out = sample * cogl_color_in * res;
+}
diff --git a/src/Misc/WindowCorners.vala b/src/Misc/WindowCorners.vala
new file mode 100644
index 00000000..76c4d60b
--- /dev/null
+++ b/src/Misc/WindowCorners.vala
@@ -0,0 +1,191 @@
+/*
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * SPDX-FileCopyrightText: 2026 ElementaryOS_MSeries
+ */
+
+/**
+ * Rounds the corners of every standard window, the way macOS does.
+ *
+ * The mask is painted from the window's own texture: the frame rectangle sits inside the
+ * actor's texture (which also contains the shadow), so the shader is told where the frame
+ * is and only the four corner squares are cut away. The shadow stays as mutter drew it.
+ *
+ * Set GALA_WINDOW_CORNER_RADIUS to the radius in logical pixels (default 12; 0 disables).
+ */
+public class Gala.WindowCorners : Object {
+    internal const string SHADER_RESOURCE = "/io/elementary/desktop/gala/shaders/window-corners.frag";
+    private const double DEFAULT_RADIUS = 12.0;
+
+    private static WindowCorners? instance;
+
+    private Gee.HashMap<Meta.Window, WindowCornersEffect> effects;
+    private double radius;
+
+    public static void init (WindowManager wm) {
+        if (instance != null) {
+            return;
+        }
+
+        instance = new WindowCorners (wm);
+    }
+
+    private WindowCorners (WindowManager wm) {
+        radius = DEFAULT_RADIUS;
+
+        var value = Environment.get_variable ("GALA_WINDOW_CORNER_RADIUS");
+        if (value != null && value.strip () != "") {
+            double parsed;
+            if (double.try_parse (value, out parsed)) {
+                radius = double.max (0, parsed);
+            }
+        }
+
+        if (radius <= 0) {
+            return;
+        }
+
+        effects = new Gee.HashMap<Meta.Window, WindowCornersEffect> ();
+
+        wm.get_display ().window_created.connect (on_window_created);
+    }
+
+    private void on_window_created (Meta.Window window) {
+        switch (window.window_type) {
+            case Meta.WindowType.NORMAL:
+            case Meta.WindowType.DIALOG:
+            case Meta.WindowType.MODAL_DIALOG:
+            case Meta.WindowType.UTILITY:
+            case Meta.WindowType.MENU:
+            case Meta.WindowType.SPLASHSCREEN:
+                break;
+            default:
+                return;
+        }
+
+        if (window.is_override_redirect ()) {
+            return;
+        }
+
+        InternalUtils.wait_for_window_actor (window, (window_actor) => {
+            var effect = new WindowCornersEffect ((int) Math.round (radius));
+            window_actor.add_effect (effect);
+            effects[window] = effect;
+
+            update_geometry (window, window_actor, effect);
+
+            window.size_changed.connect (() => update_geometry (window, window_actor, effect));
+            window.notify["monitor"].connect (() => update_geometry (window, window_actor, effect));
+            window_actor.notify["width"].connect (() => update_geometry (window, window_actor, effect));
+            window_actor.notify["height"].connect (() => update_geometry (window, window_actor, effect));
+        });
+    }
+
+    private void update_geometry (Meta.Window window, Meta.WindowActor window_actor, WindowCornersEffect effect) {
+        var monitor = int.max (window.get_monitor (), 0);
+        var monitor_scale = Utils.get_ui_scaling_factor (window.get_display (), monitor);
+
+        effect.set_geometry (
+            window_actor.get_allocation_box (),
+            window.get_frame_rect (),
+            window.get_buffer_rect (),
+            monitor_scale
+        );
+    }
+}
+
+/**
+ * The Clutter effect that masks a window actor to a rounded frame rectangle.
+ */
+public class Gala.WindowCornersEffect : Clutter.ShaderEffect {
+    private int clip_radius;
+
+    public WindowCornersEffect (int clip_radius) {
+        Object (
+#if HAS_MUTTER48
+            shader_type: Cogl.ShaderType.FRAGMENT
+#else
+            shader_type: Clutter.ShaderType.FRAGMENT_SHADER
+#endif
+        );
+
+        this.clip_radius = clip_radius;
+    }
+
+    construct {
+        try {
+            var bytes = GLib.resources_lookup_data (Gala.WindowCorners.SHADER_RESOURCE, GLib.ResourceLookupFlags.NONE);
+            set_shader_source ((string) bytes.get_data ());
+        } catch (Error e) {
+            critical ("Unable to load window-corners.frag: %s", e.message);
+        }
+    }
+
+    public void set_geometry (Clutter.ActorBox actor_box, Mtk.Rectangle frame_rect, Mtk.Rectangle buffer_rect, float monitor_scale) requires (actor != null) {
+        Clutter.ActorBox.clamp_to_pixel (ref actor_box);
+
+        var effect_box = actor_box.copy ();
+        clutter_actor_box_enlarge_for_effects (ref effect_box);
+
+        float[] full_texture_size = {
+            Math.ceilf (effect_box.get_width ()),
+            Math.ceilf (effect_box.get_height ())
+        };
+
+        float pad_x = actor_box.x1 - effect_box.x1;
+        float pad_y = actor_box.y1 - effect_box.y1;
+
+        float[] offset = {
+            Math.ceilf ((frame_rect.x - buffer_rect.x) * monitor_scale + pad_x),
+            Math.ceilf ((frame_rect.y - buffer_rect.y) * monitor_scale + pad_y)
+        };
+
+        float[] actor_size = {
+            Math.ceilf (frame_rect.width * monitor_scale),
+            Math.ceilf (frame_rect.height * monitor_scale)
+        };
+
+        var radius = (float) Utils.scale_to_int (clip_radius, monitor_scale);
+        radius = Math.fminf (radius, Math.fminf (actor_size[0], actor_size[1]) / 2.0f);
+
+        var radius_value = GLib.Value (typeof (float));
+        radius_value.set_float (radius);
+        set_uniform_value ("clip_radius", radius_value);
+
+        var actor_size_value = GLib.Value (typeof (Clutter.ShaderFloat));
+        Clutter.Value.set_shader_float (actor_size_value, actor_size);
+        set_uniform_value ("actor_size", actor_size_value);
+
+        var offset_value = GLib.Value (typeof (Clutter.ShaderFloat));
+        Clutter.Value.set_shader_float (offset_value, offset);
+        set_uniform_value ("offset", offset_value);
+
+        var full_texture_size_value = GLib.Value (typeof (Clutter.ShaderFloat));
+        Clutter.Value.set_shader_float (full_texture_size_value, full_texture_size);
+        set_uniform_value ("full_texture_size", full_texture_size_value);
+
+        queue_repaint ();
+    }
+
+    /**
+     * This is the same as mutter's private _clutter_actor_box_enlarge_for_effects function
+     * that RoundedCornersEffect also accounts for.
+     */
+    private void clutter_actor_box_enlarge_for_effects (ref Clutter.ActorBox box) {
+        if (box.get_area () == 0.0) {
+            return;
+        }
+
+        var width = box.x2 - box.x1;
+        var height = box.y2 - box.y1;
+        var rounded_width = (int) ((width) < 0.0f ? (width) - 0.5f : (width) + 0.5f);
+        var rounded_height = (int) ((height) < 0.0f ? (height) - 0.5f : (height) + 0.5f);
+        width = rounded_width;
+        height = rounded_height;
+
+        box.x2 = Math.ceilf (box.x2 + 0.75f);
+        box.y2 = Math.ceilf (box.y2 + 0.75f);
+
+        box.x1 = box.x2 - width - 3;
+        box.y1 = box.y2 - height - 3;
+    }
+}
