diff --git a/src/Widgets/IndicatorBar.vala b/src/Widgets/IndicatorBar.vala
index e939324..1ddce99 100644
--- a/src/Widgets/IndicatorBar.vala
+++ b/src/Widgets/IndicatorBar.vala
@@ -21,6 +21,7 @@ public class Wingpanel.Widgets.IndicatorBar : Granite.Bin {
     public ListModel indicator_entries { private get; construct; }
 
     private Gtk.FlowBox flow_box;
+    private const float CONTENT_SCALE = 1.15f;
 
     public IndicatorBar (ListModel indicator_entries) {
         Object (indicator_entries: indicator_entries);
@@ -35,6 +36,9 @@ public class Wingpanel.Widgets.IndicatorBar : Granite.Bin {
 
         indicator_entries.items_changed.connect (update_flow_box_max_children);
 
+        // Scale the entire bar, including explicit font/icon sizes and spacing.
+        // Monitor and notch geometry stay in their original coordinates.
+        layout_manager = null;
         child = flow_box;
     }
 
@@ -49,6 +53,27 @@ public class Wingpanel.Widgets.IndicatorBar : Granite.Bin {
         update_flow_box_max_children ();
     }
 
+    public override Gtk.SizeRequestMode get_request_mode () {
+        return flow_box.get_request_mode ();
+    }
+
+    public override void measure (Gtk.Orientation orientation, int for_size,
+                                  out int minimum, out int natural,
+                                  out int minimum_baseline, out int natural_baseline) {
+        flow_box.measure (orientation, for_size < 0 ? -1 : (int) (for_size / CONTENT_SCALE),
+                          out minimum, out natural, out minimum_baseline, out natural_baseline);
+        minimum = (int) Math.ceil (minimum * CONTENT_SCALE);
+        natural = (int) Math.ceil (natural * CONTENT_SCALE);
+        if (minimum_baseline >= 0) minimum_baseline = (int) Math.ceil (minimum_baseline * CONTENT_SCALE);
+        if (natural_baseline >= 0) natural_baseline = (int) Math.ceil (natural_baseline * CONTENT_SCALE);
+    }
+
+    public override void size_allocate (int width, int height, int baseline) {
+        flow_box.allocate ((int) (width / CONTENT_SCALE), (int) (height / CONTENT_SCALE),
+                           baseline < 0 ? -1 : (int) (baseline / CONTENT_SCALE),
+                           new Gsk.Transform ().scale (CONTENT_SCALE, CONTENT_SCALE));
+    }
+
     private void update_flow_box_max_children () {
         flow_box.max_children_per_line = uint.max (1, indicator_entries.get_n_items ());
     }
