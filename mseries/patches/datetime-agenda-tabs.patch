@@ -0,0 +1,33 @@
+/* Verse of the Day: a little larger and airier than list text, for reading. */
+.daily-verse-text {
+    font-size: 1.12em;
+    line-height: 1.4;
+}
+
+.daily-verse-reference {
+    font-weight: 600;
+    opacity: 0.75;
+}
+
+/* Titus study: the passage reads like the daily verse; section labels are small caps. */
+.study-passage {
+    font-size: 1.05em;
+    line-height: 1.45;
+}
+
+.study-section {
+    font-size: 0.8em;
+    font-weight: 700;
+    letter-spacing: 0.06em;
+    text-transform: uppercase;
+    opacity: 0.6;
+}
+
+.study-insight,
+.study-reflect {
+    line-height: 1.35;
+}
+
+.study-reflect {
+    font-style: italic;
+}
