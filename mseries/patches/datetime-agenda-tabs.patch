+/* Copyright 2026 M-Series contributors. SPDX-License-Identifier: GPL-3.0-or-later */
+/*
+ * Homeboard sync status above the Tasks list. The Homeboard bridge keeps a dedicated
+ * "Homeboard" list in Evolution Data Server, so its tasks already appear as ordinary rows;
+ * this strip only reports the bridge's last sync and asks it to sync, sign in or open the
+ * board. It reads the status file the bridge publishes and never sees the device token.
+ * Hidden unless the bridge is installed.
+ */
+public class DateTime.HomeboardStatus : Gtk.Box {
+    public const string BOARD_URI = "https://tasks.stoverparc.org/board/";
+    private const string APP_ID = "org.techmore.Homeboard";
+
+    public signal void link_opened ();
+
+    private File status_file;
+    private FileMonitor? monitor;
+    private Gtk.Label status;
+    private Gtk.Spinner spinner;
+    private Gtk.Image icon;
+    private Gtk.Button sync_button;
+    private Gtk.Button connect_button;
+    private string summary = "";
+    private GLib.DateTime? last_success = null;
+    private bool signed_in = false;
+    private bool syncing = false;
+    private bool requested = false;
+    private uint age_timer = 0;
+
+    public HomeboardStatus () {
+        Object (orientation: Gtk.Orientation.HORIZONTAL, spacing: 6, name: "homeboard-status",
+            margin_start: 6, margin_end: 6, margin_bottom: 3);
+        status_file = File.new_build_filename (Environment.get_user_state_dir (), "homeboard", "panel.json");
+        icon = new Gtk.Image.from_icon_name ("emblem-synchronizing-symbolic");
+        spinner = new Gtk.Spinner () { visible = false };
+        append (icon);
+        append (spinner);
+        var text = new Gtk.Box (Gtk.Orientation.VERTICAL, 0) { hexpand = true, valign = Gtk.Align.CENTER };
+        text.append (new Gtk.Label (_("Homeboard")) { xalign = 0, css_classes = { "heading" } });
+        status = new Gtk.Label (null) {
+            name = "homeboard-sync-status", xalign = 0, ellipsize = Pango.EllipsizeMode.END, max_width_chars = 30
+        };
+        status.add_css_class ("dim-label");
+        var small = new Pango.AttrList ();
+        small.insert (Pango.attr_scale_new (0.85));
+        status.attributes = small;
+        text.append (status);
+        append (text);
+        connect_button = new Gtk.Button.with_label (_("Sign In…")) {
+            name = "homeboard-connect", valign = Gtk.Align.CENTER, visible = false,
+            tooltip_text = _("Sign in with Google to sync Homeboard tasks")
+        };
+        connect_button.add_css_class ("suggested-action");
+        connect_button.clicked.connect (() => { request ("connect"); link_opened (); });
+        append (connect_button);
+        sync_button = new Gtk.Button.from_icon_name ("view-refresh-symbolic") {
+            name = "homeboard-sync", valign = Gtk.Align.CENTER, tooltip_text = _("Sync with Homeboard now")
+        };
+        sync_button.add_css_class ("flat");
+        sync_button.clicked.connect (() => request ("sync"));
+        append (sync_button);
+        var open_board = new Gtk.Button.from_icon_name ("web-browser-symbolic") {
+            name = "homeboard-open", valign = Gtk.Align.CENTER, tooltip_text = _("Open Homeboard")
+        };
+        open_board.add_css_class ("flat");
+        open_board.clicked.connect (() => {
+            try { AppInfo.launch_default_for_uri (BOARD_URI, null); } catch (Error e) {
+                warning ("Could not open Homeboard: %s", e.message);
+            }
+            link_opened ();
+        });
+        append (open_board);
+        try {
+            monitor = status_file.monitor_file (FileMonitorFlags.WATCH_MOVES, null);
+            monitor.changed.connect (() => reload ());
+        } catch (Error e) {
+            warning ("Could not watch Homeboard status: %s", e.message);
+        }
+        map.connect (() => {
+            reload ();
+            if (age_timer == 0) age_timer = Timeout.add_seconds (30, () => { show_status (); return GLib.Source.CONTINUE; });
+        });
+        unmap.connect (() => {
+            if (age_timer != 0) { GLib.Source.remove (age_timer); age_timer = 0; }
+        });
+        reload ();
+    }
+
+    public static bool bridge_installed () {
+        return new DesktopAppInfo (APP_ID + ".desktop") != null ||
+            File.new_build_filename (Environment.get_user_state_dir (), "homeboard", "panel.json").query_exists ();
+    }
+
+    /* Re-read the bridge's status. Missing or malformed files keep the strip neutral. */
+    public void reload () {
+        visible = bridge_installed ();
+        summary = _("Not synced yet");
+        last_success = null;
+        signed_in = false;
+        syncing = false;
+        try {
+            uint8[] contents;
+            status_file.load_contents (null, out contents, null);
+            var parser = new Json.Parser ();
+            parser.load_from_data ((string) contents, contents.length);
+            var root = parser.get_root ();
+            if (root != null && root.get_node_type () == Json.NodeType.OBJECT) {
+                var object = root.get_object ();
+                var state = object.has_member ("state") ? object.get_string_member_with_default ("state", "") : "";
+                summary = object.get_string_member_with_default ("status", summary);
+                // Older bridges publish only a status sentence; anything but "Sign in…" means connected.
+                signed_in = object.has_member ("signedIn") ? object.get_boolean_member_with_default ("signedIn", false) :
+                    !summary.has_prefix ("Sign in") && summary != "Not connected";
+                syncing = state == "syncing";
+                var stamp = object.get_string_member_with_default ("lastSuccess",
+                    state == "ok" || !object.has_member ("state") ? object.get_string_member_with_default ("updated_at", "") : "");
+                if (stamp != "") last_success = new GLib.DateTime.from_iso8601 (stamp, null);
+            }
+        } catch (Error e) {
+            // No sync has run yet, or the bridge is mid-write; the next change event reloads.
+        }
+        if (!syncing) requested = false;
+        show_status ();
+    }
+
+    private void show_status () {
+        bool busy = syncing || requested;
+        spinner.visible = spinner.spinning = busy;
+        icon.visible = !busy;
+        sync_button.sensitive = !busy && signed_in;
+        connect_button.visible = !signed_in;
+        string text = busy ? _("Syncing…") : summary;
+        if (!busy && signed_in && last_success != null) {
+            text = "%s · %s".printf (summary, relative (last_success));
+        }
+        status.label = text;
+        status.tooltip_text = text;
+    }
+
+    private static string relative (GLib.DateTime when) {
+        var seconds = new GLib.DateTime.now_utc ().difference (when) / GLib.TimeSpan.SECOND;
+        if (seconds < 60) return _("just now");
+        if (seconds < 3600) return ngettext ("%d min ago", "%d min ago", (ulong) (seconds / 60)).printf ((int) (seconds / 60));
+        if (seconds < 86400) return ngettext ("%d hour ago", "%d hours ago", (ulong) (seconds / 3600)).printf ((int) (seconds / 3600));
+        return when.to_local ().format ("%b %e");
+    }
+
+    /* Ask the running bridge over D-Bus; start it in the background if it is not running. */
+    private void request (string action) {
+        if (action == "sync") {
+            requested = true;
+            show_status ();
+            // Stop spinning if the bridge never reports back (for example, it is offline).
+            Timeout.add_seconds (30, () => { if (requested) { requested = false; show_status (); } return GLib.Source.REMOVE; });
+        }
+        var parameters = new Variant.tuple ({
+            new Variant.string (action), new Variant.array (VariantType.VARIANT, {}),
+            new Variant.array (new VariantType ("{sv}"), {})
+        });
+        Bus.get.begin (BusType.SESSION, null, (obj, res) => {
+            try {
+                var bus = Bus.get.end (res);
+                bus.call.begin (APP_ID, "/org/techmore/Homeboard", "org.gtk.Actions", "Activate",
+                    parameters, null, DBusCallFlags.NO_AUTO_START, 5000, null,
+                    (o, r) => {
+                        try { bus.call.end (r); } catch (Error e) { launch (action); }
+                    });
+            } catch (Error e) {
+                launch (action);
+            }
+        });
+    }
+
+    private void launch (string action) {
+        var script = Path.build_filename (Environment.get_home_dir (), ".local", "lib", "homeboard", "desktop.py");
+        try {
+            AppInfo.create_from_commandline ("/usr/bin/python3 %s --background --%s".printf (Shell.quote (script), action),
+                null, AppInfoCreateFlags.NONE).launch (null, null);
+        } catch (Error e) {
+            warning ("Could not start Homeboard: %s", e.message);
+            requested = false;
+            summary = _("Homeboard isn’t installed");
+            show_status ();
+        }
+    }
+}
diff --git a/src/Widgets/TaskComposer.vala b/src/Widgets/TaskComposer.vala
new file mode 100644
index 0000000..b5a65ee
--- /dev/null
+++ b/src/Widgets/TaskComposer.vala
@@ -0,0 +1,110 @@
+/* Copyright 2026 M-Series contributors. SPDX-License-Identifier: GPL-3.0-or-later */
+public class DateTime.TaskComposer : Gtk.Box {
+    private Widgets.CalendarModel model;
+    private Gtk.Entry title;
+    private Gtk.DropDown lists;
+    private Gtk.DropDown due;
+    /* Due choices offered by the composer, in days from today; -1 is no date. */
+    private const int[] DUE_DAYS = { -1, 0, 1, 7 };
+    private Gtk.Button add;
+    private Gtk.Label error_label;
+    private Gee.ArrayList<E.Source> sources;
+    private string? preferred_uid;
+    private bool refreshing = false;
+    private bool pending = false;
+
+    public TaskComposer () {
+        Object (orientation: Gtk.Orientation.VERTICAL, spacing: 3,
+            margin_start: 6, margin_end: 6, margin_bottom: 6, name: "task-composer");
+        model = Widgets.CalendarModel.get_default (ECal.ClientSourceType.TASKS);
+        title = new Gtk.Entry () {
+            name = "task-title", placeholder_text = _("New task…"),
+            hexpand = true, width_chars = 12, max_width_chars = 30
+        };
+        title.update_property (Gtk.AccessibleProperty.LABEL, _("New task title"), -1);
+        add = new Gtk.Button.from_icon_name ("list-add-symbolic") {
+            name = "task-add", tooltip_text = _("Add task")
+        };
+        var entry_row = new Gtk.Box (Gtk.Orientation.HORIZONTAL, 3);
+        entry_row.append (title);
+        entry_row.append (add);
+        append (entry_row);
+        lists = new Gtk.DropDown (null, null) { name = "task-list", hexpand = true };
+        lists.update_property (Gtk.AccessibleProperty.LABEL, _("Task list"), -1);
+        due = new Gtk.DropDown.from_strings ({ _("No date"), _("Today"), _("Tomorrow"), _("In a week") }) {
+            name = "task-due", tooltip_text = _("Due date")
+        };
+        due.update_property (Gtk.AccessibleProperty.LABEL, _("Due date"), -1);
+        var list_row = new Gtk.Box (Gtk.Orientation.HORIZONTAL, 6);
+        list_row.append (new Gtk.Label (_("List")) { css_classes = { "dim-label", "caption" } });
+        list_row.append (lists);
+        list_row.append (due);
+        append (list_row);
+        error_label = new Gtk.Label (_("Couldn’t add task. Try again.")) {
+            name = "task-add-error", xalign = 0, wrap = true, max_width_chars = 30, visible = false
+        };
+        error_label.add_css_class ("error");
+        append (error_label);
+        title.changed.connect (refresh_controls);
+        title.activate.connect (() => submit.begin ());
+        add.clicked.connect (() => submit.begin ());
+        lists.notify["selected"].connect (() => {
+            if (!refreshing && lists.selected < sources.size) preferred_uid = sources[(int) lists.selected].dup_uid ();
+            refresh_controls ();
+        });
+        model.task_sources_changed.connect (refresh_sources);
+        refresh_sources ();
+    }
+
+    private void refresh_sources () {
+        refreshing = true;
+        sources = model.writable_task_sources ();
+        var names = new Gtk.StringList (null);
+        // The list chosen earlier, else the default list (also when the chosen one went away), else the first.
+        string? fallback = model.default_task_source_uid ();
+        uint selected = sources.size > 0 ? 0 : Gtk.INVALID_LIST_POSITION;
+        bool preferred_found = false;
+        for (int i = 0; i < sources.size; i++) {
+            names.append (sources[i].dup_display_name ());
+            if (sources[i].get_uid () == preferred_uid) { selected = (uint) i; preferred_found = true; }
+            else if (!preferred_found && sources[i].get_uid () == fallback) selected = (uint) i;
+        }
+        lists.model = names;
+        lists.selected = selected;
+        refreshing = false;
+        refresh_controls ();
+    }
+
+    private void refresh_controls () {
+        bool available = sources != null && lists.selected < sources.size;
+        title.sensitive = !pending && available;
+        lists.sensitive = !pending && available;
+        due.sensitive = !pending && available;
+        add.sensitive = !pending && available && title.text.strip () != "";
+        add.tooltip_text = pending ? _("Adding task…") : _("Add task");
+        title.placeholder_text = available ? _("New task…") : _("No writable task lists");
+    }
+
+    private async void submit () {
+        if (pending || lists.selected >= sources.size || title.text.strip () == "") return;
+        var source = sources[(int) lists.selected];
+        string submitted = title.text.strip ();
+        pending = true;
+        error_label.visible = false;
+        refresh_controls ();
+        try {
+            yield model.create_task (source, submitted, DUE_DAYS[due.selected]);
+            preferred_uid = source.dup_uid ();
+            if (title.text.strip () == submitted) {
+                title.text = "";
+                due.selected = 0;
+            }
+        } catch (Error e) {
+            error_label.tooltip_text = e.message;
+            error_label.visible = true;
+        }
+        pending = false;
+        refresh_controls ();
+        if (title.sensitive) title.grab_focus ();
+    }
+}
diff --git a/src/Widgets/TaskRow.vala b/src/Widgets/TaskRow.vala
new file mode 100644
index 0000000..3ca846d
--- /dev/null
+++ b/src/Widgets/TaskRow.vala
@@ -0,0 +1,160 @@
+/* Copyright 2026 M-Series contributors. SPDX-License-Identifier: GPL-3.0-or-later */
+public class DateTime.TaskRow : Gtk.ListBoxRow {
+    /* Sections shown above the rows, in display order. */
+    public enum Bucket { OVERDUE, TODAY, TOMORROW, WEEK, LATER, UNDATED;
+        public string label () {
+            switch (this) {
+                case OVERDUE: return _("Overdue");
+                case TODAY: return _("Today");
+                case TOMORROW: return _("Tomorrow");
+                case WEEK: return _("Next 7 days");
+                case LATER: return _("Later");
+                default: return _("No due date");
+            }
+        }
+    }
+
+    public int64 due_sort { get; private set; default = int64.MAX; }
+    public Bucket bucket { get; private set; default = Bucket.UNDATED; }
+    public bool priority { get; private set; default = false; }
+    public bool recurring { get; private set; default = false; }
+    public string title { get; private set; }
+    private E.Source source;
+    private string uid;
+    private string? rid;
+    private string key;
+    private Widgets.CalendarModel model;
+    private Gtk.CheckButton completion;
+    private Gtk.Label error_label;
+    private bool updating = false;
+    public bool completing { get { return model.task_completing (key); } }
+
+    public TaskRow (ICal.Component component, E.Source source) {
+        title = component.get_summary () ?? _("Untitled task");
+        this.source = source;
+        uid = component.get_uid ();
+        var recurrence = component.get_recurrenceid ();
+        rid = recurrence != null && !recurrence.is_null_time () ? recurrence.as_ical_string () : null;
+        recurring = rid != null || component.get_first_property (ICal.PropertyKind.RRULE_PROPERTY) != null;
+        key = Widgets.CalendarModel.completion_key (source, uid, rid);
+        model = Widgets.CalendarModel.get_default (ECal.ClientSourceType.TASKS);
+        // RFC 5545: 1–4 is high priority, 5 medium, 6–9 low and 0 undefined.
+        var priority_property = component.get_first_property (ICal.PropertyKind.PRIORITY_PROPERTY);
+        int level = priority_property != null ? priority_property.get_priority () : 0;
+        priority = level >= 1 && level <= 4;
+        completion = new Gtk.CheckButton () { valign = Gtk.Align.START, margin_top = 4 };
+        completion.update_property (Gtk.AccessibleProperty.LABEL, _("Complete task: %s").printf (title), -1);
+        completion.toggled.connect (() => {
+            if (!updating && completion.active) model.complete_task.begin (source, uid, rid, title, recurring);
+        });
+        var box = new Gtk.Box (Gtk.Orientation.VERTICAL, 1) {
+            margin_start = 6, margin_end = 6, margin_top = 2, margin_bottom = 2
+        };
+        var title_row = new Gtk.Box (Gtk.Orientation.HORIZONTAL, 4);
+        if (priority) {
+            var flag = new Gtk.Label ("!") { name = "task-priority", tooltip_text = _("High priority") };
+            flag.add_css_class ("error");
+            flag.add_css_class ("heading");
+            flag.update_property (Gtk.AccessibleProperty.LABEL, _("High priority"), -1);
+            title_row.append (flag);
+        }
+        title_row.append (new Gtk.Label (title) {
+            xalign = 0, wrap = false, max_width_chars = 28, tooltip_text = title,
+            ellipsize = Pango.EllipsizeMode.END, hexpand = true
+        });
+        box.append (title_row);
+
+        var small = new Pango.AttrList ();
+        small.insert (Pango.attr_scale_new (0.85));
+        var details = new Gtk.Box (Gtk.Orientation.HORIZONTAL, 0);
+        var due = component.get_due ();
+        Gtk.Label? due_label = null;
+        if (due != null && !due.is_null_time ()) {
+            var date = Util.ical_to_date_time (due);
+            if (!due.is_date ()) date = date.to_local ();
+            due_sort = due.is_date () ? Util.strip_time (date).to_unix () : date.to_unix ();
+            due_label = new Gtk.Label (describe_due (date, due.is_date ())) {
+                name = "task-due", xalign = 0, attributes = small
+            };
+            if (bucket == Bucket.OVERDUE) due_label.add_css_class ("error");
+            else if (bucket == Bucket.TODAY) due_label.add_css_class ("accent");
+            else due_label.add_css_class ("dim-label");
+        }
+        // Homeboard publishes its project as the first category; show it beside the list name.
+        string detail = source.dup_display_name ();
+        var categories = component.get_first_property (ICal.PropertyKind.CATEGORIES_PROPERTY);
+        if (categories != null && categories.get_categories () != null && categories.get_categories ().strip () != "") {
+            detail += " · " + categories.get_categories ().strip ();
+        }
+        if (recurring) detail += " · " + _("Repeats");
+        var subtitle = new Gtk.Label ((due_label != null ? " · " : "") + detail) {
+            xalign = 0, wrap = false, max_width_chars = 28, hexpand = true,
+            ellipsize = Pango.EllipsizeMode.END, attributes = small
+        };
+        subtitle.add_css_class ("dim-label");
+        if (due_label != null) details.append (due_label);
+        details.append (subtitle);
+        details.tooltip_text = (due_label != null ? due_label.label + " · " : "") + detail;
+        box.append (details);
+        error_label = new Gtk.Label (_("Couldn’t complete task. Try again.")) {
+            xalign = 0, wrap = true, max_width_chars = 28, visible = false
+        };
+        error_label.add_css_class ("error");
+        box.append (error_label);
+        var row = new Gtk.Box (Gtk.Orientation.HORIZONTAL, 3) {
+            margin_start = 6, margin_end = 3
+        };
+        row.append (completion);
+        box.hexpand = true;
+        row.append (box);
+        child = row;
+        model.completion_changed.connect (on_completion_changed);
+        update_completion ();
+    }
+
+    /* Sets the row's bucket and returns its due wording, relative to today. */
+    private string describe_due (GLib.DateTime due, bool all_day) {
+        var now = new GLib.DateTime.now_local ();
+        var today = Util.strip_time (now);
+        var day = Util.strip_time (due);
+        int days = (int) (day.difference (today) / GLib.TimeSpan.DAY);
+        string clock = Granite.DateTime.get_default_time_format (Services.TimeManager.get_default ().is_12h, false);
+        string time = all_day ? "" : ", " + clock;
+        if (all_day ? days < 0 : due.compare (now) < 0) {
+            bucket = Bucket.OVERDUE;
+            if (days == 0) return due.format (_("Overdue since %s").printf (clock));
+            if (days == -1) return _("Overdue since yesterday");
+            return _("Overdue since %s").printf (due.format (due.get_year () == now.get_year () ? "%b %e" : "%b %e, %Y"));
+        }
+        if (days == 0) { bucket = Bucket.TODAY; return due.format (_("Due today") + time); }
+        if (days == 1) { bucket = Bucket.TOMORROW; return due.format (_("Due tomorrow") + time); }
+        if (days < 7) { bucket = Bucket.WEEK; return due.format (_("Due %A") + time); }
+        bucket = Bucket.LATER;
+        return due.format (_("Due ") + (due.get_year () == now.get_year () ? "%b %e" : "%b %e, %Y") + time);
+    }
+
+    private void on_completion_changed (string changed_key) {
+        if (changed_key == key) update_completion ();
+    }
+
+    private void update_completion () {
+        updating = true;
+        bool pending = model.task_completing (key);
+        bool writable = model.task_writable (source);
+        completion.active = pending;
+        completion.sensitive = !pending && writable;
+        completion.tooltip_text = pending ? _("Saving completion…") :
+            writable ? _("Complete task") : _("This task list is read-only or unavailable");
+        var error = model.task_completion_error (key);
+        error_label.visible = error != null;
+        error_label.tooltip_text = error;
+        updating = false;
+    }
+
+    public int compare (TaskRow other) {
+        if (bucket != other.bucket) return bucket < other.bucket ? -1 : 1;
+        if (due_sort != other.due_sort) return due_sort < other.due_sort ? -1 : 1;
+        if (priority != other.priority) return priority ? -1 : 1;
+        return title.collate (other.title);
+    }
+}
diff --git a/src/Widgets/TimeGrid.vala b/src/Widgets/TimeGrid.vala
new file mode 100644
index 0000000..4f453dd
--- /dev/null
+++ b/src/Widgets/TimeGrid.vala
@@ -0,0 +1,289 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Native read-only day/week timetable for the M-series calendar indicator.
+
+public class DateTime.Widgets.TimeEvent : Gtk.Box {
+    public ComponentRow row { get; private set; }
+    public int day_index { get; private set; }
+    public double start_minute { get; private set; }
+    public double end_minute { get; private set; }
+    public int lane { get; set; default = 0; }
+    public int lane_count { get; set; default = 1; }
+    public bool all_day { get; private set; }
+    public signal void open_date (GLib.DateTime date);
+
+    public double visual_end () { return double.min (1440, double.max (end_minute, start_minute + 24)); }
+
+    public TimeEvent (ComponentRow row, int day_index, GLib.DateTime day) {
+        Object (orientation: Gtk.Orientation.VERTICAL);
+        this.row = row;
+        this.day_index = day_index;
+        all_day = row.component.get_dtstart ().is_date ();
+        var end = row.end_time ?? row.start_time;
+        var next = day.add_days (1);
+        var clipped_start = row.start_time.compare (day) < 0 ? day : row.start_time;
+        var clipped_end = end.compare (next) > 0 ? next : end;
+        start_minute = clipped_start.get_hour () * 60 + clipped_start.get_minute () + clipped_start.get_second () / 60.0;
+        end_minute = clipped_end.compare (next) >= 0 ? 1440 : clipped_end.get_hour () * 60 + clipped_end.get_minute () + clipped_end.get_second () / 60.0;
+        // In the repeated DST hour, preserve elapsed duration when wall time runs backwards.
+        if (end_minute <= start_minute && clipped_end.compare (clipped_start) > 0)
+            end_minute = double.min (1440, start_minute + clipped_end.difference (clipped_start) / (double) TimeSpan.MINUTE);
+        end_minute = double.max (start_minute + 1, end_minute);
+        add_css_class ("mseries-time-block");
+        Util.set_component_calendar_color (row.source_selectable, this);
+        var content = new Gtk.Box (Gtk.Orientation.VERTICAL, 1) {
+            valign = Gtk.Align.START, hexpand = true,
+            margin_start = 3, margin_end = 3, margin_top = 3, margin_bottom = 3,
+            visible = all_day || visual_end () - start_minute >= 24
+        };
+        content.append (new Gtk.Label (event_title ()) {
+            xalign = 0, hexpand = true, ellipsize = Pango.EllipsizeMode.END,
+            max_width_chars = 1, css_classes = { "heading" }
+        });
+        if (!all_day && visual_end () - start_minute >= 42) {
+            content.append (new Gtk.Label (clipped_start.format ("%H:%M")) {
+                xalign = 0, ellipsize = Pango.EllipsizeMode.END,
+                max_width_chars = 1, css_classes = { "caption" }
+            });
+        }
+        var button = new Gtk.MenuButton () {
+            child = content, direction = Gtk.ArrowType.NONE,
+            always_show_arrow = false, has_frame = false, hexpand = true, vexpand = true
+        };
+        button.add_css_class ("mseries-time-menu");
+        tooltip_text = "%s\n%s\n%s".printf (event_title (), time_text (), row.calendar_name);
+        button.tooltip_text = tooltip_text;
+        button.update_property (Gtk.AccessibleProperty.LABEL, event_title (), -1);
