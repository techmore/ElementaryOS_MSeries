+++ b/src/Widgets/DailyVerse.vala
@@ -0,0 +1,479 @@
+/* Copyright 2026 M-Series contributors. SPDX-License-Identifier: GPL-3.0-or-later */
+// The + tab: a daily Bible verse, and a section-by-section study of Titus, each
+// with links to sermons on the passage.
+//
+// Daily: Christmas, Easter and other feast days get their own reserved verse;
+// the rest are shuffled per year, so a year never repeats a verse while at
+// least 366 verses are unreserved.
+//
+// Study: an overview and one page per section, with the passage, an insight and
+// a question. The mode and section are remembered across logins.
+public class DateTime.DailyVerse : Gtk.Box {
+    public signal void link_opened ();
+
+    private const string RESOURCES = "/io/elementary/desktop/wingpanel/datetime/";
+
+    private string[] references = {};
+    private string[] texts = {};
+    private string[] headings = {};
+    private string[] seasons = {};
+    private string[] study_references = {};
+    private string[] study_titles = {};
+    private string[] study_insights = {};
+    private string[] study_reflections = {};
+    private string[] study_passages = {};
+    private string study_book = "";
+
+    private bool studying = false;
+    private int offset = 0;
+    private int part = 0;
+    private string reference = "";
+    private string copy_text = "";
+    private uint copied_timeout = 0;
+
+    private Gtk.ToggleButton daily_toggle;
+    private Gtk.ToggleButton study_toggle;
+    private Granite.HeaderLabel header;
+    private Gtk.Button middle_button;
+    private Gtk.Button previous_button;
+    private Gtk.Button next_button;
+    private Gtk.Stack pages;
+    private Gtk.ScrolledWindow scroller;
+    private Gtk.Label heading_label;
+    private Gtk.Label text_label;
+    private Gtk.Label reference_label;
+    private Gtk.Label passage_label;
+    private Gtk.Label insight_title;
+    private Gtk.Label insight_label;
+    private Gtk.Label reflect_label;
+    private Wingpanel.PopoverMenuItem copy_item;
+
+    public DailyVerse () {
+        Object (orientation: Gtk.Orientation.VERTICAL, spacing: 0, name: "daily-verse");
+        load ();
+        load_study ();
+        var style = new Gtk.CssProvider ();
+        style.load_from_resource (RESOURCES + "DailyVerse.css");
+        Gtk.StyleContext.add_provider_for_display (Gdk.Display.get_default (), style,
+            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION);
+
+        // Daily | Titus, styled like the Events tab's view buttons.
+        var view_style = new Gtk.CssProvider ();
+        view_style.load_from_resource (RESOURCES + "EventRow.css");
+        daily_toggle = new Gtk.ToggleButton.with_label (_("Daily")) {
+            name = "verse-mode-daily", tooltip_text = _("A verse for each day")
+        };
+        study_toggle = new Gtk.ToggleButton.with_label (study_book != "" ? study_book : _("Study")) {
+            name = "verse-mode-study", group = daily_toggle,
+            tooltip_text = _("Study %s section by section").printf (study_book), sensitive = study_book != ""
+        };
+        var modes = new Gtk.Box (Gtk.Orientation.HORIZONTAL, 0) {
+            halign = Gtk.Align.CENTER, margin_bottom = 6
+        };
+        modes.add_css_class ("linked");
+        foreach (var toggle in new Gtk.ToggleButton[] { daily_toggle, study_toggle }) {
+            toggle.add_css_class ("agenda-view");
+            toggle.get_style_context ().add_provider (view_style, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION);
+            modes.append (toggle);
+        }
+
+        // Header with the same previous/Today/next control as the calendar.
+        header = new Granite.HeaderLabel ("") {
+            name = "verse-day", size = Granite.HeaderLabel.Size.H4, hexpand = true
+        };
+        previous_button = new Gtk.Button.from_icon_name ("pan-start-symbolic") { name = "verse-previous" };
+        middle_button = new Gtk.Button.with_label (_("Today")) { name = "verse-today" };
+        next_button = new Gtk.Button.from_icon_name ("pan-end-symbolic") { name = "verse-next" };
+        previous_button.clicked.connect (() => step (-1));
+        middle_button.clicked.connect (() => {
+            if (studying) show_part (0); else show_offset (0);
+        });
+        next_button.clicked.connect (() => step (1));
+        var navigation = new Gtk.Box (Gtk.Orientation.HORIZONTAL, 0) { valign = Gtk.Align.CENTER };
+        navigation.add_css_class ("linked");
+        navigation.append (previous_button);
+        navigation.append (middle_button);
+        navigation.append (next_button);
+        var header_row = new Gtk.Box (Gtk.Orientation.HORIZONTAL, 6) {
+            margin_start = 12, margin_end = 12
+        };
+        header_row.append (header);
+        header_row.append (navigation);
+
+        pages = new Gtk.Stack () { vhomogeneous = false, hhomogeneous = true };
+        pages.add_named (build_daily (), "daily");
+        pages.add_named (build_study (), "study");
+        scroller = new Gtk.ScrolledWindow () {
+            hscrollbar_policy = Gtk.PolicyType.NEVER, child = pages, vexpand = true,
+            min_content_height = 96, max_content_height = 300, propagate_natural_height = true
+        };
+
+        append (modes);
+        append (header_row);
+        append (scroller);
+        append (new Gtk.Separator (Gtk.Orientation.HORIZONTAL) { margin_top = 3, margin_bottom = 3 });
+        append (link_item ("verse-sermons", _("Listen to Sermons"),
+            _("Sermons on this passage at SermonAudio"), "https://www.sermonaudio.com/search?q=%s"));
+        append (link_item ("verse-videos", _("Watch Sermon Videos"),
+            _("Sermon videos on this passage at YouTube"), "https://www.youtube.com/results?search_query=sermon+%s"));
+        append (link_item ("verse-context", _("Read the Full Chapter"),
+            _("This passage in context at Bible Gateway"), "https://www.biblegateway.com/passage/?search=%s&version=WEB"));
+        copy_item = new Wingpanel.PopoverMenuItem.with_text (_("Copy Verse")) {
+            name = "verse-copy", tooltip_text = _("Copy the text and its reference")
+        };
+        copy_item.clicked.connect (copy_passage);
+        append (copy_item);
+        var source = new Gtk.Label (_("World English Bible · Public Domain")) {
+            xalign = 0, margin_start = 12, margin_end = 12, margin_top = 6
+        };
+        source.add_css_class (Granite.CssClass.DIM);
+        source.add_css_class (Granite.CssClass.SMALL);
+        append (source);
+
+        restore_state ();
+        daily_toggle.toggled.connect (() => {
+            if (daily_toggle.active) set_studying (false);
+        });
+        study_toggle.toggled.connect (() => {
+            if (study_toggle.active) set_studying (true);
+        });
+        (studying ? study_toggle : daily_toggle).active = true;
+        apply_mode ();
+    }
+
+    private Gtk.Widget build_daily () {
+        heading_label = new Gtk.Label (null) {
+            name = "verse-heading", xalign = 0, wrap = true, max_width_chars = 34
+        };
+        heading_label.add_css_class (Granite.CssClass.DIM);
+        heading_label.add_css_class (Granite.CssClass.SMALL);
+        text_label = new Gtk.Label (null) {
+            name = "verse-text", xalign = 0, wrap = true, wrap_mode = Pango.WrapMode.WORD_CHAR,
+            max_width_chars = 34, width_chars = 24
+        };
+        text_label.add_css_class ("daily-verse-text");
+        reference_label = new Gtk.Label (null) {
+            name = "verse-reference", xalign = 1, wrap = true, max_width_chars = 34
+        };
+        reference_label.add_css_class ("daily-verse-reference");
+        var verse = new Gtk.Box (Gtk.Orientation.VERTICAL, 8) {
+            margin_start = 12, margin_end = 12, margin_top = 6, margin_bottom = 12,
+            valign = Gtk.Align.CENTER, vexpand = true
+        };
+        verse.append (heading_label);
+        verse.append (text_label);
+        verse.append (reference_label);
+        return verse;
+    }
+
+    private Gtk.Label section_title (string text) {
+        var label = new Gtk.Label (text) { xalign = 0, margin_top = 6 };
+        label.add_css_class ("study-section");
+        return label;
+    }
+
+    private Gtk.Widget build_study () {
+        passage_label = new Gtk.Label (null) {
+            name = "study-passage", xalign = 0, wrap = true, wrap_mode = Pango.WrapMode.WORD_CHAR,
+            max_width_chars = 34, width_chars = 24, use_markup = true
+        };
+        passage_label.add_css_class ("study-passage");
+        insight_title = section_title (_("Insight"));
+        insight_label = new Gtk.Label (null) {
+            name = "study-insight", xalign = 0, wrap = true, max_width_chars = 34, width_chars = 24
+        };
+        insight_label.add_css_class ("study-insight");
+        reflect_label = new Gtk.Label (null) {
+            name = "study-reflect", xalign = 0, wrap = true, max_width_chars = 34, width_chars = 24
+        };
+        reflect_label.add_css_class ("study-reflect");
+        var study = new Gtk.Box (Gtk.Orientation.VERTICAL, 6) {
+            margin_start = 12, margin_end = 12, margin_top = 6, margin_bottom = 12
+        };
+        study.append (passage_label);
+        study.append (insight_title);
+        study.append (insight_label);
+        study.append (section_title (_("Reflect")));
+        study.append (reflect_label);
+        return study;
+    }
+
+    private void load () {
+        try {
+            var data = GLib.resources_lookup_data (RESOURCES + "daily-verses.tsv", GLib.ResourceLookupFlags.NONE);
+            foreach (var line in ((string) data.get_data ()).split ("\n")) {
+                // reference, text, Psalm heading, season (the last two may be empty)
+                var fields = line.split ("\t", 4);
+                if (line.has_prefix ("#") || fields.length < 2) continue;
+                references += fields[0];
+                texts += fields[1];
+                headings += fields.length > 2 ? fields[2] : "";
+                seasons += fields.length > 3 ? fields[3] : "";
+            }
+        } catch (Error e) {
+            warning ("Could not load daily verses: %s", e.message);
+        }
+    }
+
+    private void load_study () {
+        try {
+            var data = GLib.resources_lookup_data (RESOURCES + "titus-study.tsv", GLib.ResourceLookupFlags.NONE);
+            foreach (var line in ((string) data.get_data ()).split ("\n")) {
+                // reference, title, insight, reflect, passage (empty for the overview)
+                var fields = line.split ("\t", 5);
+                if (line.has_prefix ("#") || fields.length < 4) continue;
+                study_references += fields[0];
+                study_titles += fields[1];
+                study_insights += fields[2];
+                study_reflections += fields[3];
+                study_passages += fields.length > 4 ? fields[4] : "";
+            }
+            if (study_references.length > 0) study_book = study_references[0];
+        } catch (Error e) {
+            warning ("Could not load the study: %s", e.message);
+        }
+    }
+
+    // Mode and study section persist in a small key file of our own, so the
+    // upstream GSettings schema stays untouched.
+    private string state_path () {
+        return GLib.Path.build_filename (GLib.Environment.get_user_config_dir (), "mseries", "verse-of-the-day.ini");
+    }
+
+    private void restore_state () {
+        var file = new GLib.KeyFile ();
+        try {
+            file.load_from_file (state_path (), GLib.KeyFileFlags.NONE);
+            studying = study_book != "" && file.get_string ("study", "mode") == "study";
+            part = file.get_integer ("study", "part").clamp (0, int.max (study_references.length - 1, 0));
+        } catch (Error e) {
+            // First run or unreadable: start on the daily verse and the overview.
+        }
+    }
+
+    private void save_state () {
+        var file = new GLib.KeyFile ();
+        file.set_string ("study", "mode", studying ? "study" : "daily");
+        file.set_integer ("study", "part", part);
+        try {
+            GLib.DirUtils.create_with_parents (GLib.Path.get_dirname (state_path ()), 0700);
+            file.save_to_file (state_path ());
+        } catch (Error e) {
+            warning ("Could not save verse settings: %s", e.message);
+        }
+    }
+
+    private void set_studying (bool value) {
+        if (studying == value) return;
+        studying = value;
+        save_state ();
+        apply_mode ();
+    }
+
+    private void apply_mode () {
+        pages.visible_child_name = studying ? "study" : "daily";
+        middle_button.label = studying ? _("Overview") : _("Today");
+        middle_button.tooltip_text = studying ? _("About the letter") : _("Today’s verse");
+        previous_button.tooltip_text = studying ? _("Previous section") : _("Previous day");
+        next_button.tooltip_text = studying ? _("Next section") : _("Next day");
+        // Icon-only buttons: tooltips are descriptions, so give screen readers a name.
+        previous_button.update_property (Gtk.AccessibleProperty.LABEL, previous_button.tooltip_text, -1);
+        next_button.update_property (Gtk.AccessibleProperty.LABEL, next_button.tooltip_text, -1);
+        if (studying) show_part (part); else show_offset (offset);
+    }
+
+    private void step (int direction) {
+        if (studying) show_part (part + direction); else show_offset (offset + direction);
+    }
+
+    private Gtk.Button link_item (string id, string label, string tooltip, string template) {
+        var button = new Wingpanel.PopoverMenuItem.with_text (label) { name = id, tooltip_text = tooltip };
+        button.clicked.connect (() => {
+            if (reference == "") return;
+            var uri = template.printf (GLib.Uri.escape_string (reference, null, false));
+            try {
+                AppInfo.launch_default_for_uri (uri, null);
+                link_opened ();
+            } catch (Error e) {
+                warning ("Could not open %s: %s", uri, e.message);
+            }
+        });
+        return button;
+    }
+
+    private string copy_label () {
+        return studying ? _("Copy Passage") : _("Copy Verse");
+    }
+
+    private void copy_passage () {
+        if (copy_text == "") return;
+        get_clipboard ().set_text (copy_text);
+        // Confirm in place; the popover stays open so the reader keeps context.
+        copy_item.text = _("Copied");
+        if (copied_timeout != 0) Source.remove (copied_timeout);
+        copied_timeout = Timeout.add (1500, () => {
+            copy_item.text = copy_label ();
+            copied_timeout = 0;
+            return Source.REMOVE;
+        });
+    }
+
+    // Western (Gregorian) Easter Sunday, anonymous Gregorian algorithm.
+    public static GLib.DateTime easter (int year) {
+        int a = year % 19, b = year / 100, c = year % 100;
+        int d = b / 4, e = b % 4, f = (b + 8) / 25, g = (b - f + 1) / 3;
+        int h = (19 * a + b - d - g + 15) % 30;
+        int i = c / 4, k = c % 4;
+        int l = (32 + 2 * e + 2 * i - h - k) % 7;
+        int m = (a + 11 * h + 22 * l) / 451;
+        int month = (h + l - 7 * m + 114) / 31;
+        int day = (h + l - 7 * m + 114) % 31 + 1;
+        return new GLib.DateTime.local (year, month, day, 0, 0, 0);
+    }
+
+    // The feast or holiday a date reserves a verse for, or "".
+    public static string season_for (GLib.DateTime day) {
+        int month = day.get_month (), date = day.get_day_of_month ();
+        if (month == 12 && date == 24) return "christmas-eve";
+        if (month == 12 && date == 25) return "christmas";
+        if (month == 1 && date == 1) return "new-year";
+        if (month == 1 && date == 6) return "epiphany";
+        // US Thanksgiving: fourth Thursday of November.
+        if (month == 11 && day.get_day_of_week () == 4 && date >= 22 && date <= 28) return "thanksgiving";
+        switch (day.get_day_of_year () - easter (day.get_year ()).get_day_of_year ()) {
+            case -46: return "ash-wednesday";
+            case -7: return "palm-sunday";
+            case -2: return "good-friday";
+            case 0: return "easter";
+            case 49: return "pentecost";
+            default: return "";
+        }
+    }
+
+    public static string season_name (string season) {
+        switch (season) {
+            case "christmas-eve": return _("Christmas Eve");
+            case "christmas": return _("Christmas Day");
+            case "new-year": return _("New Year’s Day");
+            case "epiphany": return _("Epiphany");
+            case "thanksgiving": return _("Thanksgiving");
+            case "ash-wednesday": return _("Ash Wednesday");
+            case "palm-sunday": return _("Palm Sunday");
+            case "good-friday": return _("Good Friday");
+            case "easter": return _("Easter Sunday");
+            case "pentecost": return _("Pentecost");
+            default: return "";
+        }
+    }
+
+    // A reserved verse on its feast day. Otherwise the same verse all day from
+    // a per-year shuffle of the unreserved verses.
+    public static int choose (GLib.DateTime day, string[] seasons) {
+        var season = season_for (day);
+        int[] pool = {};
+        for (int i = 0; i < seasons.length; i++) {
+            if (season != "" && seasons[i] == season) return i;
+            if (seasons[i] == "") pool += i;
+        }
+        if (pool.length == 0) return -1;
+        var random = new GLib.Rand.with_seed ((uint32) (day.get_year () * 7919 + 104729));
+        for (int i = pool.length - 1; i > 0; i--) {
+            int j = random.int_range (0, i + 1);
+            int swap = pool[i];
+            pool[i] = pool[j];
+            pool[j] = swap;
+        }
+        return pool[(day.get_day_of_year () - 1) % pool.length];
+    }
+
+    // Called when the popover opens. The daily verse returns to today (which
+    // also turns it over after midnight); the study stays on its section.
+    public void refresh () {
+        if (studying) show_part (part); else show_offset (0);
+    }
+
+    private void show_offset (int days) {
+        offset = days;
+        var day = new GLib.DateTime.now_local ().add_days (offset);
+        var date = day.format (_("%A, %B %-d"));
+        var feast = season_name (season_for (day));
+        header.label = _("Verse of the Day");
+        header.secondary_text = feast != "" ? feast + " · " + date :
+            offset == 0 ? _("Today") + " · " + date :
+            offset == -1 ? _("Yesterday") + " · " + date :
+            offset == 1 ? _("Tomorrow") + " · " + date : date;
+        previous_button.sensitive = next_button.sensitive = true;
+        middle_button.sensitive = offset != 0;
+        copy_item.text = copy_label ();
+        copy_item.sensitive = true;
+        var index = choose (day, seasons);
+        if (index < 0) {
+            reference = copy_text = "";
+            heading_label.visible = false;
+            text_label.label = _("Verses are unavailable.");
+            reference_label.label = "";
+            return;
+        }
+        reference = references[index];
+        heading_label.label = headings[index];
+        heading_label.visible = headings[index] != "";
+        text_label.label = texts[index];
+        reference_label.label = "— " + reference;
+        copy_text = "“%s” — %s (WEB)".printf (texts[index], reference);
+    }
+
+    // Verse numbers ({n} in the data) become small raised numerals.
+    private static string passage_markup (string passage) {
+        try {
+            var numbers = new GLib.Regex ("\\{(\\d+)\\} ");
+            return numbers.replace (GLib.Markup.escape_text (passage), -1, 0,
+                "<span size=\"70%\" rise=\"3pt\" alpha=\"60%\" font_features=\"tnum\">\\1</span> ");
+        } catch (RegexError e) {
+            return GLib.Markup.escape_text (passage);
+        }
+    }
+
+    private static string passage_plain (string passage) {
+        try {
+            return new GLib.Regex ("\\{\\d+\\} ").replace (passage, -1, 0, "");
+        } catch (RegexError e) {
+            return passage;
+        }
+    }
+
+    private void show_part (int index) {
+        int count = study_references.length;
+        if (count == 0) return;
+        var chosen = index.clamp (0, count - 1);
+        if (chosen != part) {
+            part = chosen;
+            save_state ();
+        }
+        reference = study_references[part];
+        bool overview = study_passages[part] == "";
+        header.label = overview ? study_book : reference.replace ("-", "–");
+        header.secondary_text = overview ? study_titles[part] :
+            _("%s · %d of %d").printf (study_titles[part], part, count - 1);
+        previous_button.sensitive = part > 0;
+        next_button.sensitive = part < count - 1;
+        middle_button.sensitive = part != 0;
+        passage_label.visible = !overview;
+        passage_label.label = overview ? "" : passage_markup (study_passages[part]);
+        insight_title.visible = !overview;
+        insight_label.label = study_insights[part].replace (" ¶ ", "\n\n").replace (" • ", "\n•  ");
+        reflect_label.label = study_reflections[part];
+        copy_text = overview ? "" : "%s (WEB)\n%s".printf (reference.replace ("-", "–"),
+            passage_plain (study_passages[part]));
+        copy_item.text = copy_label ();
+        copy_item.sensitive = !overview;
+        scroller.vadjustment.value = 0;
+    }
+
+    public override void dispose () {
+        if (copied_timeout != 0) {
+            Source.remove (copied_timeout);
+            copied_timeout = 0;
+        }
+        base.dispose ();
+    }
+}
