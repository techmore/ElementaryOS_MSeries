+public class DateTime.Widgets.TimeGrid : Gtk.Box {
+    public signal void open_date (GLib.DateTime date);
+    public int day_count { get; private set; default = 0; }
+    public string start_date { get; private set; default = ""; }
+    private Gtk.ScrolledWindow? timed_scroll;
+    private Gtk.ScrolledWindow? horizontal_scroll;
+    private double desired_x = 0;
+    private bool horizontal_pending = false;
+    private string period_key = "";
+    private double desired_scroll = 480;
+    private bool position_pending = false;
+    private static Gtk.CssProvider style;
+    private const int GUTTER = 48;
+    private const int DAY_WIDTH = 300;
+    private const int WEEK_WIDTH = 94;
+
+    public TimeGrid () {
+        Object (orientation: Gtk.Orientation.VERTICAL, spacing: 3, name: "agenda-time-grid");
+        if (style == null) {
+            style = new Gtk.CssProvider ();
+            style.load_from_resource ("/io/elementary/desktop/wingpanel/datetime/TimeGrid.css");
+            Gtk.StyleContext.add_provider_for_display (get_display (), style, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION);
+        }
+    }
+
+    public void render (GLib.DateTime first, int days, Gee.ArrayList<ComponentRow> rows) {
+        var key = first.format ("%F") + ":" + days.to_string ();
+        double previous_x = key == period_key && horizontal_scroll != null ?
+            (horizontal_pending ? desired_x : horizontal_scroll.hadjustment.value) : 0;
+        bool same_period = key == period_key && timed_scroll != null;
+        double target = same_period ? (position_pending ? desired_scroll : timed_scroll.vadjustment.value) : 480;
+        period_key = key;
+        while (get_first_child () != null) remove (get_first_child ());
+        var timed = new Gee.ArrayList<TimeEvent> ();
+        var all_day_blocks = new Gee.ArrayList<TimeEvent> ();
+        foreach (var row in rows) {
+            int day = 0;
+            for (; day < days; day++) if (first.add_days (day).format ("%F") == row.date.format ("%F")) break;
+            if (day == days) continue;
+            var block = new TimeEvent (row, day, first.add_days (day));
+            block.open_date.connect (on_open_date);
+            if (block.all_day) all_day_blocks.add (block);
+            else {
+                timed.add (block);
+                if (!same_period) target = double.min (target, Math.floor (block.start_minute / 60) * 60);
+            }
+        }
+        for (int d = 0; d < days; d++) {
+            var in_day = new Gee.ArrayList<TimeEvent> ();
+            foreach (var block in timed) if (block.day_index == d) in_day.add (block);
+            in_day.sort ((a, b) => a.start_minute < b.start_minute ? -1 : a.start_minute > b.start_minute ? 1 :
+                a.visual_end () > b.visual_end () ? -1 : a.visual_end () < b.visual_end () ? 1 : 0);
+            var group = new Gee.ArrayList<TimeEvent> ();
+            double group_end = -1;
+            foreach (var block in in_day) {
+                if (group.size > 0 && block.start_minute >= group_end) { assign_lanes (group); group.clear (); }
+                if (group.size == 0) group_end = block.visual_end ();
+                else group_end = double.max (group_end, block.visual_end ());
+                group.add (block);
+            }
+            if (group.size > 0) assign_lanes (group);
+        }
+        int column_width = days == 7 ? WEEK_WIDTH : DAY_WIDTH;
+        foreach (var block in timed) column_width = int.max (column_width, block.lane_count * 28 + 4);
+        int width = GUTTER + days * column_width;
+        var surface = new Gtk.Box (Gtk.Orientation.VERTICAL, 0);
+        var headers = new Gtk.Grid ();
+        headers.attach (new Gtk.Label (_("Time")) { width_request = GUTTER, css_classes = { "dim-label", "caption" } }, 0, 0);
+        for (int d = 0; d < days; d++) {
+            var date = first.add_days (d);
+            headers.attach (new Gtk.Label (date.format (days == 7 ? "%a\n%b %e" : "%A, %b %e")) {
+                width_request = column_width, height_request = 36, css_classes = { "heading" }
+            }, d + 1, 0);
+        }
+        surface.append (headers);
+        var all_day_canvas = new Gtk.Fixed () { name = "calendar-all-day", width_request = width };
+        all_day_canvas.put (new Gtk.Label (_("All day")) { width_request = GUTTER, height_request = 28, css_classes = { "dim-label", "caption" } }, 0, 0);
+        var canvas = new Gtk.Fixed () { name = "calendar-time-canvas", width_request = width, height_request = 1440 };
+        for (int hour = 0; hour <= 24; hour++) {
+            var line = new Gtk.Separator (Gtk.Orientation.HORIZONTAL) {
+                name = "time-slot-" + hour.to_string (), width_request = width - GUTTER,
+                css_classes = { "mseries-hour-line" }
+            };
+            canvas.put (line, GUTTER, hour * 60);
+            if (hour < 24) {
+                canvas.put (new Gtk.Label ("%02d:00".printf (hour)) {
+                    width_request = GUTTER - 4, height_request = 18, xalign = 1,
+                    css_classes = { "dim-label", "caption" }
+                }, 0, hour * 60);
+                canvas.put (new Gtk.Separator (Gtk.Orientation.HORIZONTAL) {
+                    width_request = width - GUTTER, css_classes = { "mseries-half-hour-line" }
+                }, GUTTER, hour * 60 + 30);
+            }
+        }
+        for (int d = 0; d <= days; d++) canvas.put (new Gtk.Separator (Gtk.Orientation.VERTICAL) {
+            height_request = 1440, css_classes = { "mseries-hour-line" }
+        }, GUTTER + d * column_width, 0);
+        int[] all_day_rows = new int[days];
+        int all_day_height = 28;
+        foreach (var block in all_day_blocks) {
+            int day = block.day_index;
+            block.set_size_request (column_width - 4, 26);
+            all_day_canvas.put (block, GUTTER + day * column_width + 2, 2 + all_day_rows[day] * 30);
+            all_day_rows[day]++;
+            all_day_height = int.max (all_day_height, all_day_rows[day] * 30 + 2);
+        }
+        foreach (var block in timed) {
+            int lane_width = (column_width - 4) / block.lane_count;
+            block.set_size_request (lane_width - 2, (int) Math.ceil (block.visual_end () - block.start_minute));
+            canvas.put (block, GUTTER + block.day_index * column_width + 2 + block.lane * lane_width, block.start_minute);
+        }
+        all_day_canvas.height_request = all_day_height;
+        surface.append (new Gtk.ScrolledWindow () {
+            child = all_day_canvas, hscrollbar_policy = Gtk.PolicyType.NEVER,
+            min_content_height = 28, max_content_height = 94, propagate_natural_height = true
+        });
+        if (rows.size == 0) surface.append (new Gtk.Label (days == 7 ? _("No events this week") : _("No events this day")) { css_classes = { "dim-label" } });
+        var scroll = new Gtk.ScrolledWindow () {
+            name = "calendar-time-scroll", child = canvas,
+            hscrollbar_policy = Gtk.PolicyType.NEVER,
+            min_content_height = 250, max_content_height = 280, propagate_natural_height = true
+        };
+        timed_scroll = scroll;
+        desired_scroll = target;
+        position_pending = true;
+        scroll.vadjustment.changed.connect (restore_scroll);
+        surface.append (scroll);
+        var horizontal = new Gtk.ScrolledWindow () {
+            name = "calendar-horizontal-scroll", child = surface, hscrollbar_policy = Gtk.PolicyType.AUTOMATIC,
+            vscrollbar_policy = Gtk.PolicyType.NEVER,
+            min_content_width = int.min (width, 720), max_content_width = 720,
+            propagate_natural_width = true
+        };
+        horizontal_scroll = horizontal;
+        desired_x = previous_x;
+        horizontal_pending = true;
+        horizontal.hadjustment.changed.connect (restore_horizontal);
+        append (horizontal);
+        start_date = first.format ("%F");
+        day_count = days;
+    }
+
+    public void clear () {
+        while (get_first_child () != null) remove (get_first_child ());
+        timed_scroll = null;
+        horizontal_scroll = null;
+        period_key = "";
+        day_count = 0;
+        start_date = "";
+    }
+
+    private void on_open_date (GLib.DateTime date) { open_date (date); }
+
+    private void restore_scroll () {
+        if (position_pending && timed_scroll != null && timed_scroll.vadjustment.page_size > 0 && timed_scroll.vadjustment.upper > timed_scroll.vadjustment.page_size) {
+            timed_scroll.vadjustment.value = double.min (desired_scroll, timed_scroll.vadjustment.upper - timed_scroll.vadjustment.page_size);
+            position_pending = false;
+        }
+    }
+
+    private void restore_horizontal () {
+        if (horizontal_pending && horizontal_scroll != null && horizontal_scroll.hadjustment.page_size > 0) {
+            double maximum = double.max (0, horizontal_scroll.hadjustment.upper - horizontal_scroll.hadjustment.page_size);
+            horizontal_scroll.hadjustment.value = double.min (desired_x, maximum);
+            // A source refresh can temporarily empty/narrow the grid. Keep the
+            // requested position until its columns return instead of saving 0.
+            horizontal_pending = desired_x > maximum;
+        }
+    }
+
+    private void assign_lanes (Gee.ArrayList<TimeEvent> group) {
+        var lane_ends = new Gee.ArrayList<double?> ();
+        foreach (var block in group) {
+            int lane = 0;
+            while (lane < lane_ends.size && lane_ends[lane] > block.start_minute) lane++;
+            if (lane == lane_ends.size) lane_ends.add (block.visual_end ());
+            else lane_ends[lane] = block.visual_end ();
+            block.lane = lane;
+        }
+        foreach (var block in group) block.lane_count = lane_ends.size;
+    }
+}
