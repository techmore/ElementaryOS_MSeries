diff --git a/src/Widgets/TaskRow.vala b/src/Widgets/TaskRow.vala
new file mode 100644
index 0000000..8e1a96e
--- /dev/null
+++ b/src/Widgets/TaskRow.vala
@@ -0,0 +1,35 @@
+/* Copyright 2026 M-Series contributors. SPDX-License-Identifier: GPL-3.0-or-later */
+public class DateTime.TaskRow : Gtk.ListBoxRow {
+    public int64 due_sort { get; private set; default = int64.MAX; }
+    private string title;
+
+    public TaskRow (ICal.Component component, E.Source source) {
+        title = component.get_summary () ?? _("Untitled task");
+        var box = new Gtk.Box (Gtk.Orientation.VERTICAL, 3) {
+            margin_start = 12, margin_end = 12, margin_top = 6, margin_bottom = 6
+        };
+        box.append (new Gtk.Label (title) {
+            xalign = 0, wrap = true, max_width_chars = 28,
+            ellipsize = Pango.EllipsizeMode.END
+        });
+        var due = component.get_due ();
+        string detail = source.dup_display_name ();
+        if (due != null && !due.is_null_time ()) {
+            var date = Util.ical_to_date_time (due);
+            if (!due.is_date ()) date = date.to_local ();
+            due_sort = date.to_unix ();
+            detail += " · " + _("Due %s").printf (date.format (due.is_date () ? "%b %e" : "%b %e, %X"));
+        } else {
+            detail += " · " + _("No due date");
+        }
+        var subtitle = new Gtk.Label (detail) { xalign = 0, wrap = true, max_width_chars = 28 };
+        subtitle.add_css_class ("dim-label");
+        box.append (subtitle);
+        child = box;
+    }
+
+    public int compare (TaskRow other) {
+        if (due_sort != other.due_sort) return due_sort < other.due_sort ? -1 : 1;
+        return title.collate (other.title);
+    }
+}
