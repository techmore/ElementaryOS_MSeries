index 7295b08..6cdecae 100644
--- a/src/View/Slot.vala
+++ b/src/View/Slot.vala
@@ -160,6 +160,50 @@ namespace Files.View {
 
         private void on_dir_view_selection_changed (GLib.List<Files.File> files) {
             selection_changed (files);
+            update_side_preview (files);
+        }
+
+        /* Details and preview pane beside the list view, as in Column View (M-series) */
+        private Gtk.Widget? side_preview = null;
+        private uint side_preview_timeout_id = 0;
+        private void update_side_preview (GLib.List<Files.File> files) {
+            if (mode != ViewMode.LIST) {
+                return;
+            }
+
+            if (side_preview_timeout_id > 0) {
+                Source.remove (side_preview_timeout_id);
+                side_preview_timeout_id = 0;
+            }
+
+            if (side_preview != null) {
+                side_preview.destroy ();
+                side_preview = null;
+            }
+
+            if (!Files.Preferences.get_default ().show_file_preview || files.length () != 1) {
+                return;
+            }
+
+            var file = files.data;
+            if (file.is_folder ()) {
+                return;
+            }
+
+            side_preview_timeout_id = Timeout.add (200, () => {
+                side_preview_timeout_id = 0;
+                /* Scrolled and capped so the list keeps room for its Modified and Created columns */
+                var scrolled = new Gtk.ScrolledWindow (null, null) {
+                    hscrollbar_policy = Gtk.PolicyType.AUTOMATIC,
+                    min_content_width = 420,
+                    propagate_natural_width = false
+                };
+                scrolled.add (new View.DetailsColumn (file, dir_view));
+                side_preview = scrolled;
+                add_side_widget (side_preview, false, true);
+                side_preview.show_all ();
+                return Source.REMOVE;
+            });
         }
 
