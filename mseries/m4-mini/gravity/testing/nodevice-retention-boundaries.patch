+        let counters = pending.counters.clone();
+        let timed_out = wait_for(|| counters.timeouts.load(SeqCst) >= 1);
+        // Signal while the scheduler allocation is still alive. Do not deliver
+        // any late callback after teardown in this diagnostic.
+        let completed = pending.complete();
+        let released = completed && wait_for(|| counters.freed.load(SeqCst) == 1);
+        drop(entity);
+        drop(sched);
+        assert!(timed_out);
