+    #[test]
+    fn nodevice_completion_releases_job() -> Result {
+        let reg = faux::Registration::new(c"rust-drm-sched-nodevice", None)?;
+        let dev: &device::Device = reg.as_ref().as_ref();
+        let contexts = FenceContexts::new(1, c"rust_drm_sched_kunit", FENCE_KEY)?;
+        let sched = dirty_scheduler(dev, 1)?;
+        let mut entity = Entity::new(&sched, Priority::Kernel)?;
+        let pending = Pending::with_status(&mut entity, &contexts, true)?;
+        let counters = pending.counters.clone();
+        let timed_out = wait_for(|| counters.timeouts.load(SeqCst) >= 1);
+        // Signal while the scheduler allocation is still alive. Do not deliver
+        // any late callback after teardown in this diagnostic.
+        let completed = pending.complete();
+        let released = completed && wait_for(|| counters.freed.load(SeqCst) == 1);
+        drop(entity);
+        drop(sched);
+        assert!(timed_out);
+        assert!(completed);
+        assert!(released);
+        assert_eq!(counters.freed.load(SeqCst), 1);
+        Ok(())
