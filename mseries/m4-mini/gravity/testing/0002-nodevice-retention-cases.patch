+    #[test]
+    fn nodevice_completion_during_timeout_releases_job() -> Result {
+        let reg = faux::Registration::new(c"rust-drm-sched-nodevice-in-callback", None)?;
+        let dev: &device::Device = reg.as_ref().as_ref();
+        let contexts = FenceContexts::new(1, c"rust_drm_sched_kunit", FENCE_KEY)?;
+        let sched = dirty_scheduler(dev, 1)?;
+        let mut entity = Entity::new(&sched, Priority::Kernel)?;
+        let pending = Pending::with_mode(&mut entity, &contexts, true, true)?;
+        let counters = pending.counters.clone();
+        let timed_out = wait_for(|| counters.timeouts.load(SeqCst) >= 1);
+        let released = wait_for(|| counters.freed.load(SeqCst) == 1);
+        // Callback already signalled this parent. No extra signal is needed.
+        drop(pending);
+        drop(entity);
+        drop(sched);
+        assert!(timed_out);
+        assert!(released);
+        assert_eq!(counters.freed.load(SeqCst), 1);
+        assert_eq!(counters.cancels.load(SeqCst), 0);
+        Ok(())
+    }
+
+    #[test]
+    fn nodevice_unfinished_job_is_reachable_at_teardown() -> Result {
+        let reg = faux::Registration::new(c"rust-drm-sched-nodevice-teardown", None)?;
+        let dev: &device::Device = reg.as_ref().as_ref();
+        let contexts = FenceContexts::new(1, c"rust_drm_sched_kunit", FENCE_KEY)?;
+        let sched = dirty_scheduler(dev, 1)?;
+        let mut entity = Entity::new(&sched, Priority::Kernel)?;
+        let pending = Pending::with_status(&mut entity, &contexts, true)?;
+        let counters = pending.counters.clone();
+        let timed_out = wait_for(|| counters.timeouts.load(SeqCst) >= 1);
+        // Keep the hardware fence alive until after teardown; stop must detach
+        // its callback before cancellation releases the job.
+        drop(entity);
+        drop(sched);
+        let freed = counters.freed.load(SeqCst);
+        let cancels = counters.cancels.load(SeqCst);
+        if freed == 1 {
+            pending.hw.signal();
+        } else {
+            // Do not run a callback against a freed scheduler on failure.
+            core::mem::forget(pending.hw);
+        }
+        assert!(timed_out);
+        assert_eq!(freed, 1);
+        assert_eq!(cancels, 1);
+        Ok(())
+    }
+
+    #[test]
+    fn nodevice_completion_releases_job() -> Result {
+        let reg = faux::Registration::new(c"rust-drm-sched-nodevice", None)?;
+        let dev: &device::Device = reg.as_ref().as_ref();
+        let contexts = FenceContexts::new(1, c"rust_drm_sched_kunit", FENCE_KEY)?;
+        let sched = dirty_scheduler(dev, 1)?;
+        let mut entity = Entity::new(&sched, Priority::Kernel)?;
+        let pending = Pending::with_status(&mut entity, &contexts, true)?;
+        let counters = pending.counters.clone();
+        let timed_out = wait_for(|| counters.timeouts.load(SeqCst) >= 1);
+        // Signal while the scheduler allocation is still alive. Do not deliver
+        // any late callback after teardown in this diagnostic.
+        let completed = pending.complete();
+        let released = completed && wait_for(|| counters.freed.load(SeqCst) == 1);
+        drop(entity);
+        drop(sched);
+        assert!(timed_out);
+        assert!(completed);
+        assert!(released);
+        assert_eq!(counters.freed.load(SeqCst), 1);
+        Ok(())
