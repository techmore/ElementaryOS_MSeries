+#[kunit_tests(rust_drm_sched)]
+mod tests {
+    use super::*;
+    use crate::{
+        dma_fence::{FenceContexts, FenceObject, FenceOps, UserFence},
+        faux,
+        sync::LockClassKey,
+        time::{delay::fsleep, Delta},
+    };
+    use core::sync::atomic::{AtomicU32, Ordering::SeqCst};
+
+    static FENCE_KEY: Pin<&LockClassKey> = crate::static_lock_class!();
+
+    /// Every poll of a still-running job runs the timeout worker again, as the
+    /// G17 execution allowance and repeated-timeout recovery do.
+    const TIMEOUT_MS: time::Msecs = 5;
+    const WAIT_MS: u32 = 2000;
+
+    struct HwFence;
+
+    #[vtable]
+    impl FenceOps for HwFence {
+        fn get_driver_name<'a>(self: &'a FenceObject<Self>) -> &'a CStr {
+            c"kunit"
+        }
+
+        fn get_timeline_name<'a>(self: &'a FenceObject<Self>) -> &'a CStr {
+            c"rust-drm-sched"
+        }
+    }
+
+    #[derive(Default)]
+    struct Counters {
+        runs: AtomicU32,
+        timeouts: AtomicU32,
+        cancels: AtomicU32,
+        freed: AtomicU32,
+    }
+
+    #[derive(Default)]
+    struct RunGate {
+        entered: AtomicU32,
+        release: AtomicU32,
+        timeout_during_run: AtomicU32,
+        mutations: AtomicU32,
+    }
+
+    struct TestTimeoutData {
+        no_device: bool,
+        complete_in_timeout: bool,
+        hw: Fence,
+        counters: Arc<Counters>,
+        run_gate: Option<Arc<RunGate>>,
+    }
+
+    struct TestJob {
+        run_gate: Option<Arc<RunGate>>,
+        submission_touches: u32,
+        no_device: bool,
+        complete_in_timeout: bool,
+        hw: Fence,
+        counters: Arc<Counters>,
+    }
+
+    impl Drop for TestJob {
+        fn drop(&mut self) {
+            self.counters.freed.fetch_add(1, SeqCst);
+        }
+    }
+
+    impl JobImpl for TestJob {
+        type TimeoutData = TestTimeoutData;
+        fn timeout_data(&self) -> Self::TimeoutData {
+            TestTimeoutData {
+                no_device: self.no_device, complete_in_timeout: self.complete_in_timeout,
+                hw: self.hw.clone(), counters: self.counters.clone(),
+                run_gate: self.run_gate.clone(),
+            }
+        }
+
+        const RETAIN_JOB_ON_ENODEV: bool = true;
+
+        fn run(job: &mut Self) -> Result<Option<Fence>> {
+            job.counters.runs.fetch_add(1, SeqCst);
+            if let Some(gate) = job.run_gate.clone() {
+                gate.entered.store(1, SeqCst);
+                for _ in 0..WAIT_MS {
+                    job.submission_touches += 1;
+                    if gate.release.load(SeqCst) != 0 { break; }
+                    fsleep(Delta::from_millis(1));
+                }
+                gate.mutations.store(job.submission_touches, SeqCst);
+            }
+            Ok(Some(job.hw.clone()))
+        }
+
+        fn timed_out(data: &mut Self::TimeoutData, _finished: bool) -> Status {
+            // Like G17, keep the job and its parent callback. The hardware
+            // result still arrives later through the parent fence.
+            data.counters.timeouts.fetch_add(1, SeqCst);
+            if let Some(gate) = &data.run_gate {
+                if gate.entered.load(SeqCst) != 0 && gate.release.load(SeqCst) == 0 {
+                    gate.timeout_during_run.fetch_add(1, SeqCst);
+                }
+            }
+            if data.complete_in_timeout { let _ = data.hw.signal(); }
+            if data.no_device { Status::NoDevice } else { Status::NoHang }
+        }
+
+        fn cancel(job: &mut Self) {
+            job.counters.cancels.fetch_add(1, SeqCst);
+        }
+    }
+
+    /// Scheduler storage left dirty, as a recycled kmalloc object can be. A
+    /// byte of 1 is the common stale value (refcounts, flags, credits) and the
+    /// only one clang's `bool` test of free_guilty treats as true.
+    fn dirty_scheduler(dev: &device::Device, credits: u32) -> Result<Scheduler<TestJob>> {
+        let mut storage = UniqueArc::<SchedulerInner<TestJob>>::new_uninit(GFP_KERNEL)?;
+        // SAFETY: The storage is uniquely owned and still uninitialized.
+        unsafe {
+            core::ptr::write_bytes(
+                storage.as_mut_ptr().cast::<u8>(),
+                1,
+                core::mem::size_of::<SchedulerInner<TestJob>>(),
+            )
+        };
+        Scheduler::init(
+            storage,
+            dev,
+            1,
+            credits,
+            0,
+            TIMEOUT_MS,
+            c"rust-drm-sched-kunit",
+        )
+    }
+
+    fn wait_for(mut done: impl FnMut() -> bool) -> bool {
+        for _ in 0..WAIT_MS {
+            if done() {
+                return true;
+            }
+            fsleep(Delta::from_millis(1));
+        }
+        done()
+    }
+
+    struct Pending {
+        hw: UserFence<HwFence>,
+        counters: Arc<Counters>,
+    }
+
+    impl Pending {
+        fn new(entity: &mut Entity<TestJob>, contexts: &FenceContexts) -> Result<Self> {
+            Self::with_status(entity, contexts, false)
+        }
+
+        fn with_status(entity: &mut Entity<TestJob>, contexts: &FenceContexts, no_device: bool) -> Result<Self> {
+            Self::with_mode(entity, contexts, no_device, false)
+        }
+
+        fn with_mode(entity: &mut Entity<TestJob>, contexts: &FenceContexts, no_device: bool, complete_in_timeout: bool) -> Result<Self> {
+            let hw: UserFence<HwFence> = contexts.new_fence(0, HwFence)?.into();
+            let counters = Arc::new(Counters::default(), GFP_KERNEL)?;
+            let job = entity.new_job(
+                1,
+                TestJob {
+                    run_gate: None, submission_touches: 0,
+                    no_device,
+                    complete_in_timeout,
+                    hw: Fence::from_fence(&hw),
+                    counters: counters.clone(),
+                },
+            )?;
+            job.arm().push();
+            Ok(Self { hw, counters })
+        }
+
+        /// Deliver the late hardware result. A job freed before this point
+        /// still has its callback on the parent, and signalling the parent
+        /// would run drm_sched_job_done() on freed memory. Leak the fence
+        /// unsignalled in that case and report the failure instead.
+        fn complete(self) -> bool {
+            if self.counters.freed.load(SeqCst) != 0 {
+                core::mem::forget(self.hw);
+                return false;
+            }
+            self.hw.signal();
+            true
+        }
+    }
+
+    fn teardown_accounting_case(legacy_reset_stop: bool, complete_with_error: bool) -> Result<(bool, u32, i32, i32, i32, i32)> {
+        let reg = faux::Registration::new(c"rust-drm-sched-accounting", None)?;
+        let dev: &device::Device = reg.as_ref().as_ref();
+        let contexts = FenceContexts::new(1, c"rust_drm_sched_kunit", FENCE_KEY)?;
+        let sched = Scheduler::<TestJob>::new(dev, 1, 1, 0, 60000, c"rust-drm-sched-accounting")?;
+        let allocation = sched.0.allocation.clone();
+        let raw = allocation.sched.get();
+        let mut entity = Entity::new(&sched, Priority::Kernel)?;
+        let hw: UserFence<HwFence> = contexts.new_fence(0, HwFence)?.into();
+        let counters = Arc::new(Counters::default(), GFP_KERNEL)?;
+        let job = entity.new_job(1, TestJob {
+            no_device: false, complete_in_timeout: false,
+            hw: Fence::from_fence(&hw), counters: counters.clone(),
+            run_gate: None, submission_touches: 0,
+        })?;
+        let mut armed = job.arm();
+        let finished = armed.fences().finished();
+        armed.push();
+        let ran = wait_for(|| counters.runs.load(SeqCst) == 1);
+        // Synchronize submission and prevent free work, retaining the pending
+        // job so final cancellation is exercised even for a completed parent.
+        unsafe { bindings::drm_sched_wqueue_stop(raw) };
+        if legacy_reset_stop {
+            unsafe { bindings::drm_sched_stop(raw, core::ptr::null_mut()) };
+        }
+        if complete_with_error {
+            hw.set_error(EIO);
+            hw.signal();
+        }
+        drop(entity);
+        drop(sched);
+        // Finalization has synchronized every scheduler worker and parent
+        // callback. Allocation is retained only for stable counter inspection.
+        let (credits, score) = unsafe {
+            (core::ptr::read_volatile(addr_of!((*raw).credit_count.counter)),
+             core::ptr::read_volatile(addr_of!((*(*raw).score).counter)))
+        };
+        let status = unsafe { bindings::dma_fence_get_status(finished.raw()) };
+        let freed = counters.freed.load(SeqCst);
+        if freed == 1 { hw.signal(); } else { core::mem::forget(hw); }
+        let late_status = unsafe { bindings::dma_fence_get_status(finished.raw()) };
+        Ok((ran, freed, credits, score, status, late_status))
+    }
+
+    #[test]
+    fn teardown_accounts_unfinished_parent_once() -> Result {
+        let (ran, freed, credits, score, status, late_status) = teardown_accounting_case(false, false)?;
+        assert!(ran);
+        assert_eq!(freed, 1);
+        assert_eq!(credits, 0);
+        assert_eq!(score, 0);
+        assert_eq!(status, ECANCELED.to_errno());
+        assert_eq!(late_status, status);
+        Ok(())
+    }
+
+    #[test]
+    fn teardown_accounts_legacy_detached_parent_once() -> Result {
+        let (ran, freed, credits, score, status, late_status) = teardown_accounting_case(true, false)?;
+        assert!(ran);
+        assert_eq!(freed, 1);
+        assert_eq!(credits, 0);
+        assert_eq!(score, 0);
+        assert_eq!(status, ECANCELED.to_errno());
+        assert_eq!(late_status, status);
+        Ok(())
+    }
+
+    #[test]
+    fn teardown_preserves_completed_parent_error() -> Result {
+        let (ran, freed, credits, score, status, late_status) = teardown_accounting_case(false, true)?;
+        assert!(ran);
+        assert_eq!(freed, 1);
+        assert_eq!(credits, 0);
+        assert_eq!(score, 0);
+        assert_eq!(status, EIO.to_errno());
+        assert_eq!(late_status, status);
+        Ok(())
+    }
+
+    #[test]
+    fn timeout_overlaps_mutable_submission_state() -> Result {
+        let reg = faux::Registration::new(c"rust-drm-sched-disjoint-timeout", None)?;
+        let dev: &device::Device = reg.as_ref().as_ref();
+        let contexts = FenceContexts::new(1, c"rust_drm_sched_kunit", FENCE_KEY)?;
+        let sched = dirty_scheduler(dev, 1)?;
+        let mut entity = Entity::new(&sched, Priority::Kernel)?;
+        let hw: UserFence<HwFence> = contexts.new_fence(0, HwFence)?.into();
+        let counters = Arc::new(Counters::default(), GFP_KERNEL)?;
+        let gate = Arc::new(RunGate::default(), GFP_KERNEL)?;
+        let job = entity.new_job(1, TestJob {
+            no_device: false, complete_in_timeout: false,
+            hw: Fence::from_fence(&hw), counters: counters.clone(),
+            run_gate: Some(gate.clone()), submission_touches: 0,
+        })?;
+        job.arm().push();
+        // run retains exclusive submission state while repeatedly sleeping;
+        // the independent timeout field must remain usable during that borrow.
+        let entered = wait_for(|| gate.entered.load(SeqCst) == 1);
+        let overlapped = wait_for(|| gate.timeout_during_run.load(SeqCst) >= 1);
+        gate.release.store(1, SeqCst);
+        let mutated = wait_for(|| gate.mutations.load(SeqCst) > 0);
+        hw.signal();
+        let freed = wait_for(|| counters.freed.load(SeqCst) == 1);
+        drop(entity);
+        drop(sched);
+        assert!(entered);
+        assert!(overlapped);
+        assert!(mutated);
+        assert!(freed);
+        assert_eq!(counters.runs.load(SeqCst), 1);
+        assert_eq!(counters.cancels.load(SeqCst), 0);
+        Ok(())
+    }
+
+    #[test]
+    fn finalization_permanently_disables_submission_and_free_work() -> Result {
+        let reg = faux::Registration::new(c"rust-drm-sched-disable-work", None)?;
+        let dev: &device::Device = reg.as_ref().as_ref();
+        let sched = dirty_scheduler(dev, 1)?;
+        // Retain allocation only so finalized work state can be observed safely.
+        let allocation = sched.0.allocation.clone();
+        drop(sched);
+        let raw = allocation.sched.get();
+        // Owner finalization drained these items. No producer exists in this
+        // empty-scheduler test, so their off-queue data words are now stable.
+        let (run, free) = unsafe {
+            (core::ptr::read_volatile(addr_of!((*raw).work_run_job.data.counter)) as u64,
+             core::ptr::read_volatile(addr_of!((*raw).work_free_job.data.counter)) as u64)
+        };
+        let shift = bindings::work_bits_WORK_OFFQ_DISABLE_SHIFT;
+        let mask = (1u64 << bindings::work_bits_WORK_OFFQ_DISABLE_BITS) - 1;
+        assert_eq!((run >> shift) & mask, 1);
+        assert_eq!((free >> shift) & mask, 1);
+        Ok(())
+    }
+
+    #[test]
+    fn deferred_dependency_keeps_allocation_after_owner_teardown() -> Result {
+        let reg = faux::Registration::new(c"rust-drm-sched-deferred-owner", None)?;
+        let dev: &device::Device = reg.as_ref().as_ref();
+        let contexts = FenceContexts::new(1, c"rust_drm_sched_kunit", FENCE_KEY)?;
+        let sched = dirty_scheduler(dev, 1)?;
+        let allocation_dropped = sched.0.allocation.allocation_dropped.clone();
+        let mut entity = Entity::new(&sched, Priority::Kernel)?;
+        let dependency: UserFence<HwFence> = contexts.new_fence(0, HwFence)?.into();
+        let hw: UserFence<HwFence> = contexts.new_fence(0, HwFence)?.into();
+        let counters = Arc::new(Counters::default(), GFP_KERNEL)?;
+        let mut job = entity.new_job(1, TestJob {
+            run_gate: None, submission_touches: 0,
+            no_device: false, complete_in_timeout: false,
+            hw: Fence::from_fence(&hw), counters: counters.clone(),
+        })?;
+        job.add_dependency(Fence::from_fence(&dependency))?;
+        job.arm().push();
+        // Model forced entity teardown without waiting for its dependency.
+        // Skip only the subsequent convenience destroy: fini already ran.
+        unsafe {
+            let inner = entity.0.as_mut().get_unchecked_mut();
+            bindings::drm_sched_entity_fini(&mut inner.entity);
+            inner.test_killed = true;
+        }
+        drop(entity);
+        drop(sched);
+        let dropped_early = allocation_dropped.load(SeqCst);
+        let freed_early = counters.freed.load(SeqCst);
+        // The dependency is released only after every scheduler/entity owner.
+        if dropped_early == 0 {
+            dependency.signal();
+        } else {
+            // Diagnostic failure must not run cleanup against freed storage.
+            core::mem::forget(dependency);
+        }
+        let freed = wait_for(|| counters.freed.load(SeqCst) == 1);
+        let allocation_released = wait_for(|| allocation_dropped.load(SeqCst) == 1);
+        assert_eq!(dropped_early, 0);
+        assert_eq!(freed_early, 0);
+        assert!(freed);
+        assert!(allocation_released);
+        assert_eq!(counters.runs.load(SeqCst), 0);
+        Ok(())
+    }
+
+    #[test]
+    fn nodevice_completion_during_timeout_releases_job() -> Result {
+        let reg = faux::Registration::new(c"rust-drm-sched-nodevice-in-callback", None)?;
+        let dev: &device::Device = reg.as_ref().as_ref();
+        let contexts = FenceContexts::new(1, c"rust_drm_sched_kunit", FENCE_KEY)?;
+        let sched = dirty_scheduler(dev, 1)?;
+        let mut entity = Entity::new(&sched, Priority::Kernel)?;
+        let pending = Pending::with_mode(&mut entity, &contexts, true, true)?;
+        let counters = pending.counters.clone();
+        let timed_out = wait_for(|| counters.timeouts.load(SeqCst) >= 1);
+        let released = wait_for(|| counters.freed.load(SeqCst) == 1);
+        // Callback already signalled this parent. No extra signal is needed.
+        drop(pending);
+        drop(entity);
+        drop(sched);
+        assert!(timed_out);
+        assert!(released);
+        assert_eq!(counters.freed.load(SeqCst), 1);
+        assert_eq!(counters.cancels.load(SeqCst), 0);
+        Ok(())
+    }
