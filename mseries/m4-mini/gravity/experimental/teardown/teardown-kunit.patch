+    fn dirty_storage_starts_clean() -> Result {
+        let reg = faux::Registration::new(c"rust-drm-sched-kunit-0", None)?;
+        let dev: &device::Device = reg.as_ref().as_ref();
+        let sched = dirty_scheduler(dev, 1)?;
