Subject: [PATCH] drm/sched: retain terminal M4 timeout jobs until cleanup
Origin: https://github.com/aurora-silicon/linux/commit/0f89327272be80ecf44b643c4198614255024367

Adapt only the opt-in retention contract to Gravity 4fc326f after the
initialization fix. Legacy Rust and C reset backends retain their defaults.
Allocation ownership and callback aliasing are separate open reviews.

--- a/drivers/gpu/drm/scheduler/sched_main.c
+++ b/drivers/gpu/drm/scheduler/sched_main.c
@@ -568,0 +569,12 @@
+		} else if (status == DRM_GPU_SCHED_STAT_NO_HANG) {
+			drm_sched_job_reinsert_on_false_timeout(sched, job);
+		} else if (status == DRM_GPU_SCHED_STAT_ENODEV &&
+			   sched->ops->retain_job_on_enodev) {
+			/* Keep terminal jobs reachable without restarting the watchdog.
+			 * A parent signalled during timedout_job must reach free work.
+			 */
+			spin_lock(&sched->job_list_lock);
+			if (list_empty(&job->list))
+				list_add(&job->list, &sched->pending_list);
+			drm_sched_run_free_queue(sched);
+			spin_unlock(&sched->job_list_lock);
@@ -570,3 +581,0 @@
-
-		if (status == DRM_GPU_SCHED_STAT_NO_HANG)
-			drm_sched_job_reinsert_on_false_timeout(sched, job);
--- a/include/drm/gpu_scheduler.h
+++ b/include/drm/gpu_scheduler.h
@@ -540,0 +541,9 @@
+
+	/**
+	 * @retain_job_on_enodev: Keep a detached terminal-timeout job owned by
+	 * the scheduler until parent completion or final cancellation. The
+	 * backend must not free it during timedout_job. This does not restart
+	 * the watchdog, signal a hardware fence or establish GPU quiescence.
+	 * Reset backends with their own ownership leave this false.
+	 */
+	bool retain_job_on_enodev;
--- a/rust/kernel/drm/sched.rs
+++ b/rust/kernel/drm/sched.rs
@@ -43,0 +44,4 @@
+    /// Retain terminal-timeout jobs until parent completion or final cancellation.
+    /// Opt-in backends must not free the job from `timed_out`.
+    const RETAIN_JOB_ON_ENODEV: bool = false;
+
@@ -345,0 +350 @@
+        retain_job_on_enodev: T::RETAIN_JOB_ON_ENODEV,
--- a/drivers/gpu/drm/asahi/g16_drm.rs
+++ b/drivers/gpu/drm/asahi/g16_drm.rs
@@ -1232,0 +1233,4 @@
+    // Timeout marks the device failed and wakes the worker. The job is not
+    // freed here; its lifetime fence completes after firmware cleanup.
+    const RETAIN_JOB_ON_ENODEV: bool = true;
+
