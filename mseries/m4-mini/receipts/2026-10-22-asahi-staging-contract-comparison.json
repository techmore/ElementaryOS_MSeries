  "findings": {
    "dt74_and_wip72_j773g": "Small board files retain bootloader framebuffer power domains; shared board file enables serial0. Reviewed T8132 SoC files contain no GPU/DCP/NVMe/PCIe controller nodes. Framebuffer properties and memory remain loader fixups.",
    "nvme": "dt74/wip72/drivers74 reviewed match tables lack apple,t8132-nvme-ans2 and Gravity-specific t8132 hardware descriptor. Generic ANS2 presence is not proof of T8132 operation.",
    "gpu": "wip72 DRM_ASAHI depends on BROKEN; no reviewed g16_drm.rs. dt74/drivers74 return 404 for reviewed Asahi/DCP paths. Gravity includes M4 implementation.",
    "uapi": "All three Asahi reviewed headers are identical; Gravity adds fragment-barrier feature/command flags required to assess its selected Mesa contract.",
    "selection": "Retain complete pinned Gravity M4 stack plus reviewed compatibility fixes. No wholesale newer branch substitution or DT transplant."
  },
  "scope": "Pinned source-path/DT/match-table/UAPI comparison; not every branch/driver, build or native qualification",
  "hardware_validated": false
}
