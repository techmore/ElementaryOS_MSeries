# Load the console keymap and font in the initramfs, so the disk passphrase is
# typed with the layout it was chosen under and the prompt is legible on a
# Retina panel. Hooks are inserted before the first hook that follows them.
_elementary_ins() {
  local want=$1 x s placed=0; shift
  local -a out=()
  [[ " ${HOOKS[*]} " == *" $want "* || " ${HOOKS[*]} " == *" sd-vconsole "* ]] && return 0
  for x in "${HOOKS[@]}"; do
    if (( ! placed )); then
      for s in "$@"; do
        if [[ $x == "$s" ]]; then out+=("$want"); placed=1; break; fi
      done
    fi
    out+=("$x")
  done
  if (( placed )); then HOOKS=("${out[@]}"); fi
  return 0
}
_elementary_ins keymap consolefont block encrypt filesystems
_elementary_ins consolefont block encrypt filesystems
unset -f _elementary_ins
