#!/usr/bin/python3
"""Universal dark mode for ElementaryOS_MSeries: one switch for Pantheon, GTK 3/4, libadwaita,
Flatpak apps (through the settings portal) and Chromium-based browsers (which follow the portal).

  mseries-dark-mode status [--json]
  mseries-dark-mode appearance light|dark|auto
  mseries-dark-mode on|off|toggle|auto|tick|sun|schedule [sun | START END] [--dry-run]

Automatic mode is the macOS-style cut-over: by default dark from sunset to sunrise, using the
coordinates the desktop already stores for Night Light (override with `location LAT LON`).
`schedule START END` uses fixed times instead. Light and Dark stay fixed until Automatic is chosen.
The status command reports both the selected mode and the effective appearance. Pantheon keeps the
choice in AccountsService (PrefersColorScheme: 0 none, 1 dark, 2 light) and mirrors it to
org.gnome.desktop.interface color-scheme; both are set so the change is immediate.
Display brightness, refresh rate and power are never touched.
"""
import datetime
import json
import math
import os
import subprocess
import sys

DEFAULTS = {"mode": "sun", "start": "19:00", "end": "07:00", "appearance": "auto"}
CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "mseries/dark-mode.json")
ACCOUNTS = ("org.freedesktop.Accounts", f"/org/freedesktop/Accounts/User{os.getuid()}",
            "io.elementary.pantheon.AccountsService")


def sh(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True)


def load():
    had_appearance = False
    try:
        with open(CONF) as f:
            saved = json.load(f)
            cfg = {**DEFAULTS, **saved}
            had_appearance = "appearance" in saved
    except (OSError, ValueError):
        cfg = dict(DEFAULTS)
    if cfg["mode"] not in ("sun", "fixed"):
        cfg["mode"] = "sun"
    if cfg["appearance"] not in ("auto", "light", "dark"):
        cfg["appearance"] = "auto"
    # Older versions let a manual on/off override the last scheduled result until
    # the next transition. Preserve that choice when migrating the old config.
    if not had_appearance:
        previous_auto = state_get()
        if previous_auto in ("light", "dark") and current() != previous_auto:
            cfg["appearance"] = current()
            cfg["_legacy_override"] = True
    return cfg


def current():
    """Return 'dark' or 'light' from what apps actually see."""
    out = sh("gsettings", "get", "org.gnome.desktop.interface", "color-scheme").stdout
    return "dark" if "prefer-dark" in out else "light"


def pantheon_value():
    out = sh("busctl", "--system", "get-property", *ACCOUNTS, "PrefersColorScheme").stdout.split()
    return int(out[1]) if len(out) == 2 and out[1].isdigit() else None


def apply(mode, dry):
    pref, scheme = (1, "prefer-dark") if mode == "dark" else (2, "prefer-light")
    if not dry:
        sh("systemctl", "--user", "stop", "mseries-dark-mode-next.timer")
    steps = [
        ("AccountsService", ["busctl", "--system", "set-property", *ACCOUNTS, "PrefersColorScheme", "i", str(pref)]),
        ("gsettings", ["gsettings", "set", "org.gnome.desktop.interface", "color-scheme", scheme]),
    ]
    for name, cmd in steps:
        if dry:
            print("would run:", " ".join(cmd))
            continue
        r = sh(*cmd)
        if r.returncode:
            print(f"warning: {name} failed: {r.stderr.strip()}", file=sys.stderr)
    if not dry:
        print(f"Applied {mode.title()} appearance (apps follow within a moment).")


def coordinates(cfg):
    if "lat" in cfg and "lon" in cfg:
        return cfg["lat"], cfg["lon"]
    out = sh("gsettings", "get", "org.gnome.settings-daemon.plugins.color", "night-light-last-coordinates").stdout
    try:
        lat, lon = (float(x) for x in out.strip().strip("()").split(","))
        if abs(lat) <= 90 and abs(lon) <= 180 and (lat or lon):
            return lat, lon
    except ValueError:
        pass
    return None


def sun_times(day, lat, lon):
    """NOAA sunrise/sunset as aware local datetimes for `day` (None during polar day/night)."""
    n = day.timetuple().tm_yday
    g = 2 * math.pi / 365 * (n - 1)
    eqt = 229.18 * (0.000075 + 0.001868 * math.cos(g) - 0.032077 * math.sin(g)
                    - 0.014615 * math.cos(2 * g) - 0.040849 * math.sin(2 * g))
    decl = (0.006918 - 0.399912 * math.cos(g) + 0.070257 * math.sin(g) - 0.006758 * math.cos(2 * g)
            + 0.000907 * math.sin(2 * g) - 0.002697 * math.cos(3 * g) + 0.00148 * math.sin(3 * g))
    la = math.radians(lat)
    c = (math.cos(math.radians(90.833)) / (math.cos(la) * math.cos(decl))) - math.tan(la) * math.tan(decl)
    if abs(c) > 1:
        return None
    ha = math.degrees(math.acos(c))
    utc = datetime.datetime(day.year, day.month, day.day, tzinfo=datetime.timezone.utc)
    rise = utc + datetime.timedelta(minutes=720 - 4 * (lon + ha) - eqt)
    sset = utc + datetime.timedelta(minutes=720 - 4 * (lon - ha) - eqt)
    return rise.astimezone(), sset.astimezone()


def sun_state(now, lat, lon):
    """Return ('dark'|'light', next_transition) for aware local `now`."""
    events = []
    for off in (-1, 0, 1, 2):
        t = sun_times(now.date() + datetime.timedelta(days=off), lat, lon)
        if t:
            events += [(t[0], "light"), (t[1], "dark")]
    events.sort()
    past = [e for e in events if e[0] <= now]
    future = [e for e in events if e[0] > now]
    if not past or not future:
        return ("dark" if lat * (1 if now.month in (10, 11, 12, 1, 2, 3) else -1) > 0 else "light"), None
    return past[-1][1], future[0][0]


STATE = CONF.replace("dark-mode.json", "dark-mode.state")


def state_get():
    try:
        return open(STATE).read().strip()
    except OSError:
        return None


def state_set(value):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, "w") as f:
        f.write(value)


def save(cfg, dry):
    if not dry:
        os.makedirs(os.path.dirname(CONF), exist_ok=True)
        with open(CONF, "w") as f:
            json.dump({key: value for key, value in cfg.items() if not key.startswith("_")}, f)


def minutes(text):
    h, m = text.split(":")
    return int(h) * 60 + int(m)


def wanted(now, start, end):
    return fixed_plan(now, start, end)[0]


def fixed_plan(now, start, end):
    """Return the scheduled appearance and its next transition for a local time window."""
    n, s, e = now.hour * 60 + now.minute, minutes(start), minutes(end)
    today = now.date()
    tomorrow = today + datetime.timedelta(days=1)

    def at(day, minute):
        return datetime.datetime.combine(
            day, datetime.time(minute // 60, minute % 60), tzinfo=now.tzinfo
        )

    if s == e:
        return "dark", None
    if s < e:
        if s <= n < e:
            return "dark", at(today, e)
        if n < s:
            return "light", at(today, s)
        return "light", at(tomorrow, s)
    if n >= s:
        return "dark", at(tomorrow, e)
    if n < e:
        return "dark", at(today, e)
    return "light", at(today, s)


def schedule_plan(cfg, now=None):
    now = now or datetime.datetime.now().astimezone()
    if cfg["mode"] == "sun":
        coords = coordinates(cfg)
        if coords:
            return sun_state(now, *coords)
    return fixed_plan(now, cfg["start"], cfg["end"])


def schedule_label(cfg):
    return "sunset to sunrise" if cfg["mode"] == "sun" else f"{cfg['start']}–{cfg['end']}"


def clock_label(value):
    return value.strftime("%I:%M %p").lstrip("0")


def status_data(cfg):
    appearance = current()
    target, next_change = schedule_plan(cfg)
    mode = cfg["appearance"]
    mode_label = "Automatic" if mode == "auto" else "Manual"
    summary = f"{appearance.title()} · {mode_label}"
    if next_change:
        next_appearance = "light" if target == "dark" else "dark"
        next_text = f"{next_appearance.title()} at {clock_label(next_change)}"
    else:
        next_appearance = None
        next_text = "next change unavailable"
    if mode == "auto":
        detail = f"Following {schedule_label(cfg)}; next change: {next_text}."
    elif appearance == target:
        detail = f"Fixed {appearance}; the {schedule_label(cfg)} schedule is paused."
    else:
        detail = f"Fixed {appearance}; the schedule would switch to {next_text}."
    return {
        "appearance": appearance,
        "mode": mode,
        "schedule": cfg["mode"],
        "schedule_label": schedule_label(cfg),
        "automatic_target": target,
        "next_appearance": next_appearance,
        "next_at": next_change.isoformat() if next_change else None,
        "summary": summary,
        "detail": detail,
    }


def print_status(cfg, as_json=False):
    data = status_data(cfg)
    if as_json:
        print(json.dumps(data, ensure_ascii=False))
    else:
        print(f"Current appearance: {data['appearance'].title()}")
        print(f"Selected mode: {'Automatic' if data['mode'] == 'auto' else data['mode'].title()}")
        print(data["detail"])


def apply_schedule(cfg, dry):
    if cfg["appearance"] != "auto":
        if cfg.get("_legacy_override"):
            target, next_change = schedule_plan(cfg)
            if target == state_get():
                if not dry:
                    print("Keeping the previous manual appearance until the next scheduled change.")
                return
            cfg.pop("_legacy_override", None)
            cfg["appearance"] = "auto"
            save(cfg, dry)
        else:
            if not dry:
                print("Automatic schedule is paused; selected mode is %s." % cfg["appearance"].title())
            else:
                print("would keep the selected %s appearance (automatic schedule is paused)" % cfg["appearance"])
            return
    target, next_change = schedule_plan(cfg)
    if dry:
        print(f"would apply {target} appearance" if current() != target else f"would keep {target} appearance")
    else:
        sh("systemctl", "--user", "stop", "mseries-dark-mode-next.timer")
        if current() != target:
            apply(target, False)
        state_set(target)
    if next_change and not dry:
        sh("systemd-run", "--user", "--quiet", "--unit=mseries-dark-mode-next", "--collect",
           f"--on-calendar={next_change + datetime.timedelta(seconds=5):%Y-%m-%d %H:%M:%S}",
           os.path.realpath(sys.argv[0]), "tick")


def main(argv):
    dry = "--dry-run" in argv
    as_json = "--json" in argv
    args = [a for a in argv if a not in ("--dry-run", "--json")]
    cmd = args[0] if args else "status"
    cfg = load()
    if cmd == "status":
        print_status(cfg, as_json)
    elif cmd in ("on", "off"):
        mode = "dark" if cmd == "on" else "light"
        cfg["appearance"] = mode
        save(cfg, dry)
        apply(mode, dry)
    elif cmd == "toggle":
        mode = "light" if current() == "dark" else "dark"
        cfg["appearance"] = mode
        save(cfg, dry)
        apply(mode, dry)
    elif cmd == "appearance":
        if len(args) != 2 or args[1] not in ("light", "dark", "auto"):
            print("usage: mseries-dark-mode appearance light|dark|auto", file=sys.stderr)
            return 2
        cfg["appearance"] = args[1]
        save(cfg, dry)
        if args[1] == "auto":
            apply_schedule(cfg, dry)
        else:
            apply(args[1], dry)
        if not dry:
            print_status(cfg)
    elif cmd == "auto":
        cfg["appearance"] = "auto"
        save(cfg, dry)
        apply_schedule(cfg, dry)
        if not dry:
            print_status(cfg)
    elif cmd == "tick":
        apply_schedule(cfg, dry)
    elif cmd == "sun":
        want, nxt = schedule_plan(cfg)
        if nxt:
            print(f"{want} now; next change {clock_label(nxt)}")
        else:
            print(f"{want} now; next change unavailable")
    elif cmd == "location":
        cfg = {**load(), "lat": float(args[1]), "lon": float(args[2])}
        save(cfg, dry)
        print(f"Location set to {cfg['lat']}, {cfg['lon']}.")
    elif cmd == "schedule":
        if len(args) == 3:
            for t in args[1:]:
                minutes(t)
            cfg = {**load(), "mode": "fixed", "start": args[1], "end": args[2], "appearance": "auto"}
            save(cfg, dry)
        elif len(args) == 2 and args[1] == "sun":
            cfg = {**load(), "mode": "sun", "appearance": "auto"}
            save(cfg, dry)
        else:
            print("usage: mseries-dark-mode schedule sun|START END", file=sys.stderr)
            return 2
        apply_schedule(cfg, dry)
        if not dry:
            print_status(cfg)
    else:
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
