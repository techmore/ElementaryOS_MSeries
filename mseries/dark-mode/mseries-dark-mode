#!/usr/bin/python3
"""Universal dark mode for ElementaryOS_MSeries: one switch for Pantheon, GTK 3/4, libadwaita,
Flatpak apps (through the settings portal) and Chromium-based browsers (which follow the portal).

  mseries-dark-mode status | on | off | toggle | auto | schedule [START END] [--dry-run]

`auto` picks dark between START and END (default 19:00-07:00, local time) and is what the user timer
runs. Pantheon keeps the choice in AccountsService (PrefersColorScheme: 0 none, 1 dark, 2 light) and
mirrors it to org.gnome.desktop.interface color-scheme; both are set so the change is immediate.
Display brightness, refresh rate and power are never touched.
"""
import datetime
import json
import os
import subprocess
import sys

DEFAULTS = {"start": "19:00", "end": "07:00"}
CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "mseries/dark-mode.json")
ACCOUNTS = ("org.freedesktop.Accounts", f"/org/freedesktop/Accounts/User{os.getuid()}",
            "io.elementary.pantheon.AccountsService")


def sh(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True)


def load():
    try:
        with open(CONF) as f:
            return {**DEFAULTS, **json.load(f)}
    except (OSError, ValueError):
        return dict(DEFAULTS)


def current():
    """Return 'dark' or 'light' from what apps actually see."""
    out = sh("gsettings", "get", "org.gnome.desktop.interface", "color-scheme").stdout
    return "dark" if "prefer-dark" in out else "light"


def pantheon_value():
    out = sh("busctl", "--system", "get-property", *ACCOUNTS, "PrefersColorScheme").stdout.split()
    return int(out[1]) if len(out) == 2 and out[1].isdigit() else None


def apply(mode, dry):
    pref, scheme = (1, "prefer-dark") if mode == "dark" else (2, "prefer-light")
    steps = [
        ("AccountsService", ["busctl", "--system", "set-property", *ACCOUNTS, "PrefersColorScheme", "i", str(pref)]),
        ("gsettings", ["gsettings", "set", "org.gnome.desktop.interface", "color-scheme", scheme]),
    ]
    for name, cmd in steps:
        if dry:
            print("would run:", " ".join(cmd))
            continue
        r = sh(*cmd)
        if r.returncode:
            print(f"warning: {name} failed: {r.stderr.strip()}", file=sys.stderr)
    if not dry:
        print(f"Dark mode {'on' if mode == 'dark' else 'off'} (apps follow within a moment).")


def minutes(text):
    h, m = text.split(":")
    return int(h) * 60 + int(m)


def wanted(now, start, end):
    n, s, e = now.hour * 60 + now.minute, minutes(start), minutes(end)
    return "dark" if (s <= n < e if s < e else n >= s or n < e) else "light"


def main(argv):
    dry = "--dry-run" in argv
    args = [a for a in argv if a != "--dry-run"]
    cmd = args[0] if args else "status"
    cfg = load()
    if cmd == "status":
        pv = {0: "no preference", 1: "dark", 2: "light"}.get(pantheon_value(), "unknown")
        print(f"apps see: {current()}  |  Pantheon preference: {pv}  |  schedule: {cfg['start']}-{cfg['end']}")
    elif cmd in ("on", "off"):
        apply("dark" if cmd == "on" else "light", dry)
    elif cmd == "toggle":
        apply("light" if current() == "dark" else "dark", dry)
    elif cmd == "auto":
        want = wanted(datetime.datetime.now(), cfg["start"], cfg["end"])
        if want != current() or dry:
            apply(want, dry)
    elif cmd == "schedule":
        if len(args) == 3:
            for t in args[1:]:
                minutes(t)
            if not dry:
                os.makedirs(os.path.dirname(CONF), exist_ok=True)
                with open(CONF, "w") as f:
                    json.dump({"start": args[1], "end": args[2]}, f)
            cfg = {"start": args[1], "end": args[2]}
        print(f"Dark from {cfg['start']} to {cfg['end']} when `auto` runs.")
    else:
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
