[Unit]
Description=MSeries assistant model (LFM3-Audio-2B: suggestions, chat, speech) on 127.0.0.1:8772
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# One model for every assistant feature. It loads on the first request and unloads after MSERIES_ASSIST_IDLE seconds, or after 60 s idle when memory is tight.
Environment=OMARCHY_MLX_SYSTEM_PREFIX=%h/.local/share/mlx-omarchy
Environment=VK_DRIVER_FILES=%h/.local/share/mlx-omarchy/vulkan/honeykrisp_icd.aarch64.json
Environment=HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1
# Vulkan submission budget. The M1 Pro (G13S) is uncalibrated upstream and falls back to 5000.
# 120k: LFM3-1.7B 22.6 -> 27.5 tok/s on Honeykrisp 9323171c12, output identical, MLX gate PASS.
Environment=MLX_OMARCHY_BATCH_WORK=120000
Environment=MSERIES_ASSIST_IDLE=1800
ExecStart=%h/.local/share/mseries-ai/lfm3-audio-venv/bin/python -I %h/.local/libexec/mseries-assistant/assistd.py
Nice=5
# Always: the server exits after its idle unload to release pinned GPU memory (MSERIES_ASSIST_EXIT_ON_UNLOAD).
Restart=always
RestartSec=1
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
