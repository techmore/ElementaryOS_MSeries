diff --git a/tools/test_staged_tile_unit_guard.py b/tools/test_staged_tile_unit_guard.py
new file mode 100644
index 0000000..6927655
--- /dev/null
+++ b/tools/test_staged_tile_unit_guard.py
@@ -0,0 +1,40 @@
+"""Offline test: a staged decoder needs an explicit ANEC header unit."""
+import importlib.util
+from pathlib import Path
+import unittest
+from unittest import mock
+
+spec = importlib.util.spec_from_file_location('staged_decoder', Path(__file__).with_name('staged-decode-runtime.py'))
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+
+class UnitGuardTests(unittest.TestCase):
+    def test_missing_or_invalid_unit_fails_before_any_device_open(self):
+        with mock.patch.object(module.RUNTIME, 'Device') as device:
+            for unit in (None, 1024):
+                with self.assertRaisesRegex(ValueError, 'explicit ANEC header tile unit'):
+                    module.StagedDecoder('absent-manifest', 'absent-dir', tile_unit=unit)
+            device.assert_not_called()
+
+class GroupFlowTests(unittest.TestCase):
+    def test_output_of_one_group_becomes_input_to_next(self):
+        import numpy as np
+        class Program:
+            def write_bank(self, port, value):
+                self.value = value.copy()
+            def execute(self, outputs):
+                pass
+            def read_output(self, port, shape):
+                return self.value + np.float16(1)
+        d = module.StagedDecoder.__new__(module.StagedDecoder)
+        d.programs = [Program(), Program()]
+        d.manifest = {'programs': [
+            {'group_start': True, 'group_end': True,
+             'srcs': [{'kind': 'lane', 'lane': 'x', 'port': 'in'}],
+             'dsts': [{'lane': 'h', 'port': 'out', 'shape': [1, 1]}]}
+            for _ in range(2)]}
+        d.lanes = {}; d.position = 0
+        d.context_arrays = lambda position, rope: {}
+        output = d.step(np.array([1], dtype=np.float16), {})
+        self.assertEqual(float(output[0]), 3.0)
+        self.assertEqual(float(d.programs[1].value[0, 0]), 2.0)
