diff --git a/tools/test_uniform_relayout.py b/tools/test_uniform_relayout.py
new file mode 100644
index 0000000..e035e09
--- /dev/null
+++ b/tools/test_uniform_relayout.py
@@ -0,0 +1,45 @@
+"""Offline structural tests for normalized ANE task streams."""
+import importlib.util
+import struct
+import tempfile
+import unittest
+from pathlib import Path
+
+spec = importlib.util.spec_from_file_location('converter', Path(__file__).with_name('hwxv2-to-anec.py'))
+converter = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(converter)
+
+class UniformRelayoutTests(unittest.TestCase):
+    def stream(self):
+        stream = bytearray(0x500)
+        struct.pack_into('<I', stream, 0x1c, 0x200)
+        struct.pack_into('<I', stream, 0x200 + 0x1c, 0)
+        stream[0x40:0x44] = b'one!'
+        stream[0x240:0x244] = b'two!'
+        return bytes(stream)
+
+    def test_preserves_task_bytes_and_rewrites_link(self):
+        source = self.stream()
+        output, mapping = converter.uniform_task_relayout(source, (0, 0x200), len(source), 0x300)
+        self.assertEqual(mapping, {0: 0, 0x200: 0x300})
+        self.assertEqual(struct.unpack_from('<I', output, 0x1c)[0], 0x300)
+        self.assertEqual(struct.unpack_from('<I', output, 0x300+0x1c)[0], 0)
+        self.assertEqual(output[0x40:0x44], b'one!')
+        self.assertEqual(output[0x340:0x344], b'two!')
+        self.assertEqual(output[0x200:0x300], bytes(0x100))
+
+    def test_rejects_unaligned_and_truncated_slots(self):
+        source = self.stream()
+        for stride in (0x280, 0x200):
+            with self.assertRaises(ValueError):
+                converter.uniform_task_relayout(source, (0, 0x200), len(source), stride)
+
+    def test_rejects_wrong_or_cyclic_links(self):
+        source = bytearray(self.stream())
+        struct.pack_into('<I', source, 0x1c, 0x100)
+        with self.assertRaises(ValueError):
+            converter.uniform_task_relayout(bytes(source), (0, 0x200), len(source), 0x300)
+        struct.pack_into('<I', source, 0x1c, 0x200)
+        struct.pack_into('<I', source, 0x200+0x1c, 0x200)
+        with self.assertRaises(ValueError):
+            converter.uniform_task_relayout(bytes(source), (0, 0x200), len(source), 0x300)
