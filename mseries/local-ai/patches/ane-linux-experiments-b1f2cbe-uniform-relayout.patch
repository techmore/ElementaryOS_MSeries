@@ -694,0 +695,25 @@ def convert_hwx(
+def uniform_task_relayout(stream: bytes, bases: tuple[int, ...], stream_size: int, stride: int):
+    """Normalize linked task slots, refusing ambiguous or truncated streams."""
+    if stream_size != len(stream) or not bases or bases[0] != 0:
+        raise ValueError("invalid task stream geometry")
+    if stride < TASK_HEADER_SIZE or stride % 0x100:
+        raise ValueError("task stride must be at least a header and 0x100 aligned")
+    if tuple(sorted(set(bases))) != tuple(bases) or bases[-1] >= stream_size:
+        raise ValueError("invalid task bases")
+    out = bytearray(len(bases) * stride)
+    mapping = {old: i * stride for i, old in enumerate(bases)}
+    for i, base in enumerate(bases):
+        end = bases[i + 1] if i + 1 < len(bases) else stream_size
+        extent = end - base
+        if extent < TASK_HEADER_SIZE or extent > stride:
+            raise ValueError("task extent is outside the normalized slot")
+        next_ptr = struct.unpack_from("<I", stream, base + 0x1c)[0]
+        expected = bases[i + 1] if i + 1 < len(bases) else 0
+        if next_ptr != expected:
+            raise ValueError("task chain does not match discovered bases")
+        new_base = mapping[base]
+        out[new_base:new_base + extent] = stream[base:end]
+        struct.pack_into("<I", out, new_base + 0x1c, mapping[next_ptr] if next_ptr else 0)
+    return bytes(out), mapping
+
