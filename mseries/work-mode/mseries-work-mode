#!/usr/bin/env python3
"""Apply Work Mode's scheduled wallpaper for the current Pantheon user."""

import argparse
import sys
from datetime import datetime
from pathlib import Path

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402


SCHEMA = "io.elementary.mseries.work-mode"
STATE = Path(GLib.get_user_state_dir()) / "mseries" / "work-mode.json"


def load_state():
    try:
        import json
        return json.loads(STATE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {"original": None, "applied": False}


def save_state(state):
    import json
    STATE.parent.mkdir(parents=True, exist_ok=True)
    temporary = STATE.with_suffix(".json.tmp")
    temporary.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
    temporary.replace(STATE)


def in_work_window(settings, now=None):
    if not settings.get_boolean("enabled"):
        return False
    if not settings.get_boolean("scheduled"):
        return True
    now = now or datetime.now().astimezone()
    if settings.get_boolean("weekdays-only") and now.weekday() >= 5:
        return False
    try:
        start = datetime.strptime(settings.get_string("start-time"), "%H:%M").time()
        end = datetime.strptime(settings.get_string("end-time"), "%H:%M").time()
    except ValueError:
        return False
    current = now.time().replace(tzinfo=None)
    return start <= current < end if start <= end else current >= start or current < end


def tick():
    mode = Gio.Settings.new(SCHEMA)
    background = Gio.Settings.new("org.gnome.desktop.background")
    background_schema = background.props.settings_schema
    state = load_state()
    image = Path(mode.get_string("work-wallpaper")).expanduser()
    activate = in_work_window(mode) and image.is_file()

    if activate:
        if state.get("original") is None:
            original = {}
            for key in ("picture-uri", "picture-uri-dark", "picture-options"):
                if background_schema.has_key(key):
                    original[key] = background.get_string(key)
            state["original"] = original
        if background_schema.has_key("picture-uri"):
            background.set_string("picture-uri", image.resolve().as_uri())
        if background_schema.has_key("picture-uri-dark"):
            background.set_string("picture-uri-dark", image.resolve().as_uri())
        state["applied"] = True
    elif state.get("applied"):
        for key, value in (state.get("original") or {}).items():
            if background_schema.has_key(key):
                background.set_string(key, value)
        state.update({"original": None, "applied": False})

    Gio.Settings.sync()
    save_state(state)
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--tick", action="store_true", help="apply the current schedule once")
    parser.add_argument("--status", action="store_true", help="show the current schedule status")
    args = parser.parse_args()
    if args.status:
        settings = Gio.Settings.new(SCHEMA)
        if not settings.get_boolean("enabled"):
            print("Off")
        elif not settings.get_string("work-wallpaper"):
            print("On · choose a work wallpaper in System Settings → Work Mode")
        elif in_work_window(settings):
            print("On · work wallpaper active")
        else:
            print("Scheduled · normal wallpaper active")
        return 0
    if args.tick:
        return tick()
    parser.error("use --tick or --status")


if __name__ == "__main__":
    raise SystemExit(main())
