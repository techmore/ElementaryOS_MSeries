#!/usr/bin/env python3
"""Apply Work Mode's scheduled wallpaper for the current Pantheon user."""

import argparse
import os
import subprocess
import sys
from glob import glob
from shutil import which
from datetime import datetime
from pathlib import Path

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402


SCHEMA = "io.elementary.mseries.work-mode"
DOCK_SCHEMA = "io.elementary.dock"
DOCK_UNIT = "mseries-work-mode-dock.service"
STATE = Path(GLib.get_user_state_dir()) / "mseries" / "work-mode.json"


def load_state():
    try:
        import json
        return json.loads(STATE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {"original": None, "applied": False}


def save_state(state):
    import json
    STATE.parent.mkdir(parents=True, exist_ok=True)
    temporary = STATE.with_suffix(".json.tmp")
    temporary.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
    temporary.replace(STATE)


def in_work_window(settings, now=None):
    if not settings.get_boolean("enabled"):
        return False
    if not settings.get_boolean("scheduled"):
        return True
    now = now or datetime.now().astimezone()
    if settings.get_boolean("weekdays-only") and now.weekday() >= 5:
        return False
    try:
        start = datetime.strptime(settings.get_string("start-time"), "%H:%M").time()
        end = datetime.strptime(settings.get_string("end-time"), "%H:%M").time()
    except ValueError:
        return False
    current = now.time().replace(tzinfo=None)
    return start <= current < end if start <= end else current >= start or current < end


def tick():
    mode = Gio.Settings.new(SCHEMA)
    background = Gio.Settings.new("org.gnome.desktop.background")
    background_schema = background.props.settings_schema
    state = load_state()
    image = Path(mode.get_string("work-wallpaper")).expanduser()
    activate = in_work_window(mode) and image.is_file()

    if activate:
        if state.get("original") is None:
            original = {}
            for key in ("picture-uri", "picture-uri-dark", "picture-options"):
                if background_schema.has_key(key):
                    original[key] = background.get_string(key)
            state["original"] = original
        if background_schema.has_key("picture-uri"):
            background.set_string("picture-uri", image.resolve().as_uri())
        if background_schema.has_key("picture-uri-dark"):
            background.set_string("picture-uri-dark", image.resolve().as_uri())
        activate_dock(state)
        state["applied"] = True
    elif state.get("applied"):
        for key, value in (state.get("original") or {}).items():
            if background_schema.has_key(key):
                background.set_string(key, value)
        restore_dock(state)
        state.update({"original": None, "applied": False})

    Gio.Settings.sync()
    save_state(state)
    return 0


def restore():
    background = Gio.Settings.new("org.gnome.desktop.background")
    schema = background.props.settings_schema
    state = load_state()
    for key, value in (state.get("original") or {}).items():
        if schema.has_key(key):
            background.set_string(key, value)
    restore_dock(state)
    state.update({"original": None, "applied": False})
    Gio.Settings.sync()
    save_state(state)
    return 0


def dock_settings():
    try:
        settings = Gio.Settings.new(DOCK_SCHEMA)
        schema = settings.props.settings_schema
        values = {}
        for key in ("icon-size", "autohide-mode"):
            if schema.has_key(key):
                values[key] = settings.get_value(key).print_(True)
        return settings, schema, values
    except GLib.Error:
        return None, None, {}


def dock_running():
    for proc in glob("/proc/[0-9]*/cmdline"):
        try:
            argv = Path(proc).read_bytes().split(b"\0")
        except OSError:
            continue
        if any(Path(arg.decode(errors="ignore")).name == "io.elementary.dock" for arg in argv if arg):
            return True
    return False


def activate_dock(state):
    settings, schema, _ = dock_settings()
    if settings is None:
        state.setdefault("dock", {"available": False})
        return
    dock = state.get("dock")
    if not isinstance(dock, dict) or not dock.get("applied"):
        was_running = dock_running()
        dock = {
            "available": True,
            "applied": True,
            "original": {},
            "started_by_work_mode": False,
        }
        for key in ("icon-size", "autohide-mode"):
            if schema.has_key(key):
                dock["original"][key] = settings.get_value(key).print_(True)
        if not was_running and which("systemctl"):
            subprocess.run(
                ["systemctl", "--user", "start", DOCK_UNIT],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            dock["started_by_work_mode"] = True
        state["dock"] = dock
    elif dock.get("started_by_work_mode") and which("systemctl"):
        active = subprocess.run(
            ["systemctl", "--user", "is-active", "--quiet", DOCK_UNIT],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        ).returncode == 0
        if not active:
            subprocess.run(
                ["systemctl", "--user", "start", DOCK_UNIT],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )

    if schema.has_key("icon-size"):
        settings.set_int("icon-size", 40)
    if schema.has_key("autohide-mode"):
        settings.set_string("autohide-mode", "never")


def restore_dock(state):
    dock = state.get("dock")
    if not isinstance(dock, dict) or not dock.get("applied"):
        return
    settings, schema, _ = dock_settings()
    if settings is not None:
        for key, value in dock.get("original", {}).items():
            if schema.has_key(key):
                settings.set_value(key, GLib.Variant.parse(None, value, None, None))
    if dock.get("started_by_work_mode") and which("systemctl"):
        subprocess.run(
            ["systemctl", "--user", "stop", DOCK_UNIT],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    state["dock"] = {"available": dock.get("available", False), "applied": False}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--tick", action="store_true", help="apply the current schedule once")
    parser.add_argument("--status", action="store_true", help="show the current schedule status")
    parser.add_argument("--restore", action="store_true", help="restore the wallpaper and dock snapshot")
    args = parser.parse_args()
    if args.status:
        settings = Gio.Settings.new(SCHEMA)
        if not settings.get_boolean("enabled"):
            print("Off")
        elif not settings.get_string("work-wallpaper"):
            print("On · choose a work wallpaper in System Settings → Windows Work Mode")
        elif in_work_window(settings):
            print("Windows Work Mode · work layout active")
        else:
            print("Scheduled · normal desktop active")
        return 0
    if args.tick:
        return tick()
    if args.restore:
        return restore()
    parser.error("use --tick, --status or --restore")


if __name__ == "__main__":
    raise SystemExit(main())
