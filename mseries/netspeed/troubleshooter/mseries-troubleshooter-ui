#!/usr/bin/python3
"""Native GTK4/Granite frontend for the on-device diagnostic command."""
import fcntl
import json
import os
import re
import subprocess
import sys
import threading
import time
from datetime import datetime
from pathlib import Path

import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Gdk', '4.0')
gi.require_version('Pango', '1.0')
from gi.repository import Gdk, Gio, GLib, Gtk, Pango

try:  # Native elementary widgets when available; a plain GTK fallback keeps the app usable.
    gi.require_version('Granite', '7.0')
    from gi.repository import Granite
    Granite.init()
except (ValueError, ImportError):
    Granite = None

APP_ID = 'org.techmore.MSeries.Troubleshooter'
HOME = Path.home()
STATE = HOME / '.local/state/mseries-troubleshooter'
TROUBLESHOOT = str(HOME / '.local/bin/mseries-troubleshoot')
VERIFY = str(HOME / '.local/bin/mseries-verify')
REPAIR = str(HOME / '.local/libexec/mseries-repair-panel')
EVIDENCE_MARK = '\n## Input evidence'
SAVED_RE = re.compile(r'^Saved locally: (.+)$', re.M)
INLINE_RE = re.compile(r'(\*\*Fix:\*\*|\*\*.+?\*\*|`[^`]+`|\[L\d+\])')

# (title, description, run the performance check, icon candidates)
SUGGESTIONS = (
    ('Why did my desktop freeze?', 'Check recent warnings and failed services', False,
     ('computer-fail-symbolic', 'dialog-warning-symbolic')),
    ('Why does it feel slow?', 'Measure CPU, memory pressure and temperatures', True,
     ('utilities-system-monitor-symbolic', 'system-search-symbolic')),
    ('Did anything crash?', 'Look through recent crash reports', False,
     ('dialog-error-symbolic', 'dialog-warning-symbolic')),
)


def split_report(text):
    """Separates the model's answer from the (long) input evidence appended to saved reports."""
    head, mark, tail = text.partition(EVIDENCE_MARK)
    return head.strip(), (mark + tail).strip() if mark else ''


NO_FIX_RE = re.compile(r'nothing to do|no action (is )?(needed|required)|no fix (is )?needed', re.I)
FIX_SPLIT_RE = re.compile(r'\s*\*\*Fix:\*\*.*$', re.S)
BULLET_RE = re.compile(r'^\s*[-*]\s+')


def bullet_name(bullet):
    match = re.search(r'\*\*(.+?)\*\*', bullet)
    return re.sub(r'[^a-z0-9 ]', '', (match.group(1) if match else bullet).lower()).strip()


def sort_sections(markdown):
    """The small model sometimes files "nothing to do" items under Needs attention or lists an
    item twice. Move such items to Fine to ignore, drop duplicates, and keep the rest as written."""
    sections, order, current = {}, [], None
    for line in markdown.splitlines():
        heading = re.match(r'^##\s+(.*)$', line)
        if heading:
            current = heading.group(1).strip()
            order.append(current)
            sections[current] = []
        elif current is not None:
            sections[current].append(line)
    attention = next((t for t in order if t.lower().startswith('needs attention')), None)
    if attention is None:
        return markdown
    fine = next((t for t in order if t.lower().startswith('fine to ignore')), None)

    def bullets(lines):
        items = []
        for line in lines:
            if BULLET_RE.match(line) or not items:
                if line.strip():
                    items.append(line.rstrip())
            elif line.strip():
                items[-1] += ' ' + line.strip()
        return items

    keep, moved = [], []
    for item in bullets(sections[attention]):
        if not BULLET_RE.match(item):
            continue
        fix = re.search(r'\*\*Fix:\*\*(.*)$', item, re.S)
        if fix and NO_FIX_RE.search(fix.group(1)):
            moved.append(FIX_SPLIT_RE.sub('', item).rstrip())
        else:
            keep.append(item)
    ignore = [i for i in (bullets(sections[fine]) if fine else []) if BULLET_RE.match(i)]
    taken = {bullet_name(i) for i in keep}
    seen = set()
    merged = []
    for item in moved + ignore:
        name = bullet_name(item)
        if name in taken or name in seen:
            continue
        seen.add(name)
        merged.append(item)

    out = []
    for title in order:
        out.append('## ' + title)
        if title == attention:
            out.extend(keep or ['Nothing needs attention.'])
            out.append('')
        elif title == fine:
            out.extend(merged)
            out.append('')
        else:
            out.extend(sections[title])
    if fine is None and merged:
        out += ['## Fine to ignore'] + merged + ['']
    return '\n'.join(out)


def report_time(path):
    try:
        return datetime.strptime(path.name[:15], '%Y%m%d-%H%M%S').strftime('%b %-d, %-I:%M %p')
    except ValueError:
        return path.name


def icon_name(*candidates):
    theme = Gtk.IconTheme.get_for_display(Gdk.Display.get_default())
    return next((name for name in candidates if theme.has_icon(name)), candidates[-1])


def option_switch(title, description):
    """An elementary-style switch row with a one-line explanation."""
    if Granite is not None:
        return Granite.SwitchModelButton(text=title, description=description)
    return Gtk.CheckButton(label=title, tooltip_text=description)


class Troubleshooter(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.connect('command-line', self.command_line)
        self.connect('activate', self.activate_window)
        self.window = None
        self.process = None
        self.cancelled = False
        self.busy = False
        self.stage_text = ''
        self.started_at = 0.0
        self.tick_id = 0
        self.answer_text = ''
        self.evidence_text = ''
        self.report_caption = ''
        self.tool_buttons = []

    # ------------------------------------------------------------------ window

    def command_line(self, _app, command_line):
        self.activate()
        arguments = command_line.get_arguments()
        if '--performance' in arguments:
            self.performance.set_active(True)
        # --analyze "question": used by crash notifications to start straight away.
        if '--analyze' in arguments:
            index = arguments.index('--analyze')
            if index + 1 < len(arguments) and not self.busy:
                self.question.set_text(arguments[index + 1][:500])
                self.run_analysis()
        return 0

    def activate_window(self, _app):
        if self.window:
            self.window.present()
            return
        Gtk.Window.set_default_icon_name(APP_ID)
        window = self.window = Gtk.ApplicationWindow(application=self, title='Local Troubleshooter',
                                                     default_width=640, default_height=600)
        window.set_titlebar(self.build_header())

        quit_action = Gio.SimpleAction.new('quit', None)
        quit_action.connect('activate', lambda *_: self.quit())
        self.add_action(quit_action)
        self.set_accels_for_action('app.quit', ['<Control>q'])

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        content.append(self.build_pages())

        if Granite is not None:
            self.toast = Granite.Toast(title='')
            overlay = Gtk.Overlay(child=content)
            overlay.add_overlay(self.toast)
            window.set_child(overlay)
        else:
            self.toast = None
            window.set_child(content)

        self.refresh_checklist()
        self.load_latest_report()
        window.present()
        self.question.grab_focus()

    def build_header(self):
        header = Gtk.HeaderBar()
        # The question lives in the title area, like the search field in other elementary apps.
        self.question = Gtk.SearchEntry(placeholder_text='Ask what went wrong', width_request=360)
        self.question.connect('activate', lambda *_: self.on_analyze())
        header.set_title_widget(self.question)
        header.pack_end(self.build_menu())

        # Pending verification checks live behind a quiet header button instead of crowding the window.
        self.checks_popover = Gtk.Popover()
        self.checks_label = Gtk.Label()
        checks_content = Gtk.Box(spacing=6)
        checks_content.append(Gtk.Image(icon_name=icon_name('emblem-important-symbolic', 'dialog-question-symbolic')))
        checks_content.append(self.checks_label)
        self.checks_button = Gtk.MenuButton(child=checks_content, popover=self.checks_popover, visible=False,
                                            tooltip_text='Checks waiting for you')
        header.pack_start(self.checks_button)
        return header

    def build_menu(self):
        popover = Gtk.Popover()
        popover.add_css_class('menu')
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, margin_top=3, margin_bottom=3)

        self.previous = option_switch('Previous Boot', 'Read logs from before the last restart')
        self.performance = option_switch('Performance Check', 'Add CPU, memory and thermal evidence')
        self.free_after = option_switch('Free Memory When Done', 'Stop the local model afterwards')
        self.free_after.set_active(True)
        for option in (self.previous, self.performance, self.free_after):
            box.append(option)
        box.append(Gtk.Separator(margin_top=3, margin_bottom=3))

        self.evidence_switch = option_switch('Show Evidence', 'Include the logs the model was given')
        self.evidence_switch.connect('notify::active', lambda *_: self.render())
        self.evidence_switch.set_sensitive(False)
        box.append(self.evidence_switch)
        self.copy_button = Gtk.Button(child=Gtk.Label(label='Copy Diagnosis', xalign=0))
        self.copy_button.add_css_class('flat')
        self.copy_button.add_css_class('menuitem')
        self.copy_button.connect('clicked', lambda _b: (popover.popdown(), self.copy_answer()))
        self.copy_button.set_sensitive(False)
        box.append(self.copy_button)
        box.append(Gtk.Separator(margin_top=3, margin_bottom=3))

        self.actions = {}
        for name, label, handler in (('release', 'Release Model Memory', self.stop_model),
                                     ('repair', 'Restart Panel…', self.confirm_repair),
                                     ('folder', 'Open Reports Folder', self.open_folder)):
            button = Gtk.Button(child=Gtk.Label(label=label, xalign=0))
            button.add_css_class('flat')
            button.add_css_class('menuitem')
            button.connect('clicked', lambda _b, h=handler: (popover.popdown(), h()))
            box.append(button)
            self.tool_buttons.append(button)

        popover.set_child(box)
        return Gtk.MenuButton(icon_name='open-menu-symbolic', popover=popover, tooltip_text='Options and tools')

    def build_pages(self):
        # Empty: a Granite placeholder offering starter questions.
        empty_icon = Gio.ThemedIcon.new(APP_ID)
        if Granite is not None:
            empty = Granite.Placeholder(title='Ask Your Mac What Went Wrong',
                                        description='Type a question above and press Enter, or start with one of these. Nothing leaves this Mac.',
                                        icon=empty_icon)
            for title, description, performance, icons in SUGGESTIONS:
                button = empty.append_button(Gio.ThemedIcon.new(icon_name(*icons)), title, description)
                button.connect('clicked', self.use_suggestion, title, performance)
        else:
            empty = Gtk.Label(label='Describe the problem above and press Analyze.', vexpand=True)

        # Busy: one calm, centered progress state.
        self.stage_title = Gtk.Label(wrap=True, justify=Gtk.Justification.CENTER, max_width_chars=48)
        self.stage_title.add_css_class('h3')
        self.elapsed = Gtk.Label()
        self.elapsed.add_css_class('dim-label')
        self.elapsed.add_css_class('numeric')
        self.cancel = Gtk.Button(label='Cancel', halign=Gtk.Align.CENTER, margin_top=6)
        self.cancel.connect('clicked', lambda *_: self.cancel_analysis())
        busy = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=9, valign=Gtk.Align.CENTER,
                       halign=Gtk.Align.CENTER, vexpand=True)
        busy.append(Gtk.Spinner(spinning=True, width_request=32, height_request=32))
        busy.append(self.stage_title)
        busy.append(self.elapsed)
        busy.append(self.cancel)

        # Report.
        self.text = Gtk.TextView(editable=False, cursor_visible=False, wrap_mode=Gtk.WrapMode.WORD_CHAR,
                                 top_margin=12, bottom_margin=24, left_margin=36, right_margin=36,
                                 pixels_below_lines=6, pixels_above_lines=1)
        self.make_tags(self.text.get_buffer())
        scroll = Gtk.ScrolledWindow(vexpand=True, child=self.text)

        report = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        report.append(scroll)

        self.pages = Gtk.Stack(vexpand=True, hhomogeneous=False, vhomogeneous=False,
                                transition_type=Gtk.StackTransitionType.CROSSFADE)
        # Scrollable so a short window never forces the placeholder's full height.
        self.pages.add_named(Gtk.ScrolledWindow(child=empty, hscrollbar_policy=Gtk.PolicyType.NEVER), 'empty')
        self.pages.add_named(busy, 'busy')
        self.pages.add_named(report, 'report')
        self.pages.set_visible_child_name('empty')
        return self.pages

    # ------------------------------------------------------------------ report rendering

    @staticmethod
    def make_tags(buffer):
        for name, scale in (('h1', 1.3), ('h2', 1.15), ('h3', 1.0)):
            buffer.create_tag(name, weight=Pango.Weight.BOLD, scale=scale, pixels_above_lines=14)
        buffer.create_tag('bold', weight=Pango.Weight.BOLD)
        buffer.create_tag('fix', weight=Pango.Weight.BOLD, foreground='#3689e6')
        buffer.create_tag('attention', weight=Pango.Weight.BOLD, scale=1.15, pixels_above_lines=14, foreground='#f37329')
        buffer.create_tag('fine', weight=Pango.Weight.BOLD, scale=1.15, pixels_above_lines=14, foreground='#68b723')
        shade = Gdk.RGBA()
        shade.parse('rgba(128,128,128,0.18)')
        buffer.create_tag('mono', family='monospace', scale=0.92)
        buffer.create_tag('codeblock', family='monospace', scale=0.9, background_rgba=shade,
                          left_margin=22, pixels_below_lines=0)
        buffer.create_tag('cite', scale=0.8, foreground='#888a85')
        buffer.create_tag('item', left_margin=26, indent=-14)
        buffer.create_tag('dim', scale=0.9, foreground='#888a85')

    def insert_inline(self, buffer, text, *base):
        position = 0
        for match in INLINE_RE.finditer(text):
            if match.start() > position:
                buffer.insert_with_tags_by_name(buffer.get_end_iter(), text[position:match.start()], *base)
            token = match.group(0)
            if token == '**Fix:**':
                buffer.insert_with_tags_by_name(buffer.get_end_iter(), 'Fix:', 'fix', *base)
            elif token.startswith('**'):
                buffer.insert_with_tags_by_name(buffer.get_end_iter(), token[2:-2], 'bold', *base)
            elif token.startswith('`'):
                buffer.insert_with_tags_by_name(buffer.get_end_iter(), token[1:-1], 'mono', *base)
            else:
                buffer.insert_with_tags_by_name(buffer.get_end_iter(), token, 'cite', *base)
            position = match.end()
        if position < len(text):
            buffer.insert_with_tags_by_name(buffer.get_end_iter(), text[position:], *base)

    def render_markdown(self, buffer, markdown):
        in_code = False
        for line in markdown.splitlines():
            if line.strip().startswith('```'):
                in_code = not in_code
                continue
            if in_code:
                buffer.insert_with_tags_by_name(buffer.get_end_iter(), line + '\n', 'codeblock')
                continue
            heading = re.match(r'^(#{1,3})\s+(.*)$', line)
            bullet = re.match(r'^\s*(?:[-*]|\d+[.)])\s+(.*)$', line)
            if heading:
                title = heading.group(2).strip()
                if title.lower().startswith('needs attention'):
                    buffer.insert_with_tags_by_name(buffer.get_end_iter(), '⚠  ' + title, 'attention')
                elif title.lower().startswith('fine to ignore'):
                    buffer.insert_with_tags_by_name(buffer.get_end_iter(), '✓  ' + title, 'fine')
                else:
                    self.insert_inline(buffer, title, 'h%d' % len(heading.group(1)))
            elif bullet:
                marker = re.match(r'^\s*(\d+[.)])', line)
                buffer.insert_with_tags_by_name(buffer.get_end_iter(),
                                                (marker.group(1) if marker else '•') + '  ', 'item')
                self.insert_inline(buffer, bullet.group(1), 'item')
            else:
                self.insert_inline(buffer, line)
            buffer.insert(buffer.get_end_iter(), '\n')

    def show_report(self, text, path=None, label=None):
        self.answer_text, self.evidence_text = split_report(text)
        if not self.evidence_text and path:
            try:
                _, self.evidence_text = split_report(Path(path).read_text()[:200000])
            except OSError:
                pass
        self.report_caption = label or ''
        self.evidence_switch.set_active(False)
        self.evidence_switch.set_sensitive(bool(self.evidence_text))
        self.copy_button.set_sensitive(bool(self.answer_text))
        self.render()
        self.pages.set_visible_child_name('report')

    def render(self):
        buffer = self.text.get_buffer()
        buffer.set_text('')
        # Saved reports start with a generated title and a model line; the window already says
        # what this is, so lead with the answer.
        body = re.sub(r'^# Local troubleshooting report\s*', '', self.answer_text)
        model = re.match(r'^Model: (.+)\n', body)
        if model:
            name = re.search(r'models--[^/]+--([^/]+)', model.group(1))
            caption = ' · '.join(part for part in ((name.group(1) if name else model.group(1)), self.report_caption) if part)
            buffer.insert_with_tags_by_name(buffer.get_end_iter(), caption + '\n', 'dim')
            body = body[model.end():]
        self.render_markdown(buffer, sort_sections(body.strip()))
        if self.evidence_switch.get_active() and self.evidence_text:
            buffer.insert(buffer.get_end_iter(), '\n')
            self.render_markdown(buffer, self.evidence_text)

    def copy_answer(self, _button):
        self.window.get_clipboard().set(self.answer_text)
        self.notify_user('Diagnosis copied')

    def load_latest_report(self):
        reports = sorted(STATE.glob('*.md'))
        if not reports:
            return
        try:
            self.show_report(reports[-1].read_text()[:200000], reports[-1],
                             report_time(reports[-1]))
        except OSError:
            pass

    def use_suggestion(self, _button, title, performance):
        self.question.set_text(title)
        self.performance.set_active(performance)
        self.on_analyze()

    def notify_user(self, message):
        """Short, self-dismissing confirmation (Granite toast)."""
        if self.toast is not None:
            self.toast.set_title(message)
            self.toast.send_notification()

    # ------------------------------------------------------------------ busy state

    def set_busy(self, busy):
        self.busy = busy
        self.question.set_sensitive(not busy)
        for button in self.tool_buttons:
            button.set_sensitive(not busy)

    def start_ticker(self):
        self.stop_ticker()
        self.started_at = time.monotonic()
        self.tick()
        self.tick_id = GLib.timeout_add_seconds(1, self.tick)

    def stop_ticker(self):
        if self.tick_id:
            GLib.source_remove(self.tick_id)
            self.tick_id = 0

    def tick(self):
        elapsed = int(time.monotonic() - self.started_at)
        self.elapsed.set_text('%d:%02d' % (elapsed // 60, elapsed % 60))
        return True

    def show_stage(self, text):
        self.stage_text = text
        self.stage_title.set_text(text)

    # ------------------------------------------------------------------ analysis

    def on_analyze(self):
        if not self.busy:
            self.run_analysis()

    def cancel_analysis(self):
        self.cancelled = True
        self.cancel.set_sensitive(False)
        self.show_stage('Cancelling…')
        try:
            self.process.terminate()
        except (OSError, AttributeError):
            pass

    def run_analysis(self):
        performance = self.performance.get_active()
        question = self.question.get_text().strip() or (
            'Find native desktop performance bottlenecks and recommend measured, reversible improvements.'
            if performance else 'Why are there recent desktop failures?')
        args = [TROUBLESHOOT, '--start', question]
        if performance:
            args.append('--performance')
        free_after = self.free_after.get_active()
        if free_after:
            args.append('--release-model')
        if self.previous.get_active():
            args.append('--previous-boot')

        self.cancelled = False
        self.set_busy(True)
        self.cancel.set_sensitive(True)
        self.show_stage('Preparing local analysis…')
        self.pages.set_visible_child_name('busy')
        self.start_ticker()

        def work():
            try:
                output_lines = []
                with subprocess.Popen(args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                      text=True, bufsize=1) as process:
                    self.process = process
                    timer = threading.Timer(780, process.kill)
                    timer.start()
                    try:
                        for line in process.stdout:
                            if line.startswith('MSeries-Progress: '):
                                try:
                                    progress = json.loads(line.removeprefix('MSeries-Progress: '))
                                    GLib.idle_add(self.update_stage, progress['detail'])
                                    continue
                                except (ValueError, KeyError, TypeError):
                                    pass
                            output_lines.append(line)
                        success = process.wait() == 0
                    finally:
                        timer.cancel()
                output = ''.join(output_lines)
                if not success and not output.strip():
                    output = 'Local analysis stopped or exceeded the 13 minute time limit.'
            except (OSError, subprocess.SubprocessError) as error:
                output, success = str(error), False
            if self.cancelled and free_after:
                # A terminated run skips its own cleanup, so release the model here.
                try:
                    subprocess.run(['systemctl', '--user', 'stop', 'mseries-troubleshooter-model.service'],
                                   capture_output=True, timeout=25, check=False)
                except (OSError, subprocess.SubprocessError):
                    pass
            GLib.idle_add(self.finished, output, success)
        threading.Thread(target=work, daemon=True).start()

    def update_stage(self, detail):
        if not self.cancelled:
            self.show_stage(detail)
        return False

    def finished(self, output, success):
        self.process = None
        self.stop_ticker()
        self.set_busy(False)
        if self.cancelled:
            self.pages.set_visible_child_name('report' if self.answer_text else 'empty')
            self.notify_user('Analysis cancelled')
            return False
        saved = SAVED_RE.search(output)
        path = Path(saved.group(1).strip()) if saved else None
        if saved:
            output = SAVED_RE.sub('', output).strip()
        if success:
            self.show_report(output, path, report_time(path) if path else 'Just now')
        else:
            self.show_report('## Analysis could not finish\n\n' + output)
        return False

    # ------------------------------------------------------------------ tools

    def stop_model(self):
        self.set_busy(True)
        def work():
            try:
                # Share the same lock as CLI/watcher analyses before unloading.
                STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
                with open(STATE / 'analysis.lock', 'a',
                          opener=lambda path, flags: os.open(path, flags, 0o600)) as lock:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    result = subprocess.run(['systemctl', '--user', 'stop', 'mseries-troubleshooter-model.service'],
                                            capture_output=True, text=True, timeout=25)
                    message = 'Model memory released' if result.returncode == 0 else result.stderr.strip()
            except BlockingIOError:
                message = 'An analysis is running. Release memory after it finishes.'
            except (OSError, subprocess.SubprocessError) as error:
                message = str(error)
            GLib.idle_add(self.tool_finished, message)
        threading.Thread(target=work, daemon=True).start()

    def confirm_repair(self):
        title, detail = 'Restart the panel?', 'The top bar disappears for a few seconds. Open windows are not affected.'
        if Granite is not None:
            dialog = Granite.MessageDialog.with_image_from_icon_name(title, detail, 'view-refresh',
                                                                     Gtk.ButtonsType.CANCEL)
            dialog.set_transient_for(self.window)
            dialog.set_modal(True)
            dialog.add_button('Restart Panel', Gtk.ResponseType.ACCEPT)
            def response(_dialog, response_id):
                _dialog.destroy()
                if response_id == Gtk.ResponseType.ACCEPT:
                    self.repair_panel()
            dialog.connect('response', response)
            dialog.present()
            return
        dialog = Gtk.AlertDialog(message=title, detail=detail)
        dialog.set_buttons(['Cancel', 'Restart Panel'])
        dialog.set_cancel_button(0)
        def done(source, result):
            try:
                if source.choose_finish(result) == 1:
                    self.repair_panel()
            except GLib.Error:
                pass
        dialog.choose(self.window, None, done)

    def repair_panel(self):
        self.set_busy(True)
        self.notify_user('Restarting the panel…')
        def work():
            try:
                result = subprocess.run(['/usr/bin/python3', REPAIR], capture_output=True, text=True, timeout=30)
                output = (result.stdout + result.stderr).strip()
            except (OSError, subprocess.SubprocessError) as error:
                output = str(error)
            GLib.idle_add(self.tool_finished, output)
        threading.Thread(target=work, daemon=True).start()

    def tool_finished(self, message):
        self.set_busy(False)
        self.notify_user(message[:160])
        return False

    def open_folder(self):
        STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
        try:
            Gio.AppInfo.launch_default_for_uri(STATE.as_uri(), None)
        except GLib.Error as error:
            self.notify_user('Could not open the reports folder')

    # ------------------------------------------------------------------ verification checklist

    def refresh_checklist(self):
        """Pending checks from mseries-verify, loaded off the UI thread; failures just hide the button."""
        def work():
            try:
                result = subprocess.run([VERIFY, 'status', '--json'], capture_output=True, text=True, timeout=10)
                items = [item for item in json.loads(result.stdout)['items']
                         if item['state'] in ('ask', 'failed', 'waiting')]
            except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
                items = []
            GLib.idle_add(self.build_checklist, items)
        threading.Thread(target=work, daemon=True).start()

    def build_checklist(self, items):
        self.checks_button.set_visible(bool(items))
        if not items:
            self.checks_popover.popdown()
            return False
        asking = sum(1 for item in items if item['state'] == 'ask')
        self.checks_label.set_text('%d %s' % (len(items), 'check' if len(items) == 1 else 'checks'))

        icons = {'ask': 'dialog-question-symbolic', 'failed': 'dialog-error-symbolic',
                 'waiting': 'preferences-system-time-symbolic'}
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=9,
                      margin_top=12, margin_bottom=12, margin_start=12, margin_end=12)
        heading = Gtk.Label(label='Checks that need you' if asking else 'Checks still open', xalign=0)
        heading.add_css_class('h4')
        box.append(heading)
        for item in items:
            row = Gtk.Box(spacing=9)
            row.append(Gtk.Image(icon_name=icon_name(icons.get(item['state'], 'dialog-question-symbolic'),
                                                     'dialog-question-symbolic')))
            label = Gtk.Label(label=item['title'], xalign=0, hexpand=True, wrap=True, max_width_chars=34,
                              tooltip_text=item.get('detail') or '')
            if item['state'] != 'ask':
                label.add_css_class('dim-label')
            row.append(label)
            if item['state'] == 'ask':
                good = Gtk.Button(label='Looks Good')
                good.connect('clicked', self.answer_check, item['id'], 'yes')
                problem = Gtk.Button(label='Problem')
                problem.connect('clicked', self.answer_check, item['id'], 'no')
                pair = Gtk.Box()
                pair.add_css_class('linked')
                pair.append(good)
                pair.append(problem)
                row.append(pair)
            box.append(row)
        run = Gtk.Button(label='Run Checks Now', halign=Gtk.Align.END)
        run.connect('clicked', self.run_checks)
        box.append(run)
        self.checks_popover.set_child(box)
        return False

    def answer_check(self, button, check_id, answer):
        button.get_parent().set_sensitive(False)
        def work():
            try:
                subprocess.run([VERIFY, 'confirm', check_id, answer], capture_output=True, timeout=10)
            except (OSError, subprocess.SubprocessError):
                pass
            GLib.idle_add(self.refresh_checklist)
        threading.Thread(target=work, daemon=True).start()

    def run_checks(self, button):
        button.set_sensitive(False)
        button.set_label('Running…')
        def work():
            try:
                subprocess.run([VERIFY, 'run', '--quiet'], capture_output=True, timeout=120)
            except (OSError, subprocess.SubprocessError):
                pass
            GLib.idle_add(self.refresh_checklist)
        threading.Thread(target=work, daemon=True).start()


