[Unit]
Description=Voxtype local dictation (F5 hold-to-talk)
After=mseries-aop-mic.service pipewire.service ydotool.service graphical-session.target
Wants=ydotool.service mseries-aop-mic.service

[Service]
Environment=PIPEWIRE_NODE=mseries-builtin-mic
ExecStart=/usr/local/bin/voxtype daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
