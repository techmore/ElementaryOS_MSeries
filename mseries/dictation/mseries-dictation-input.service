[Unit]
Description=Unicode dictation input method
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.techmore.DictationInput
ExecStart=/usr/bin/python3 %h/.local/share/mseries/stream/dictation-input.py
ExecStartPost=/usr/bin/python3 %h/.local/share/mseries/stream/dictation-input-client.py ready
ExecStartPost=/usr/bin/python3 %h/.local/share/mseries/stream/dictation-input-client.py repair-native
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
