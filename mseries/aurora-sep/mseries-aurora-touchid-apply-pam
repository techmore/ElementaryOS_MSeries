#!/usr/bin/env bash
# Wire pam_fprintd into the password prompts (run as root via pkexec).
#
#   mseries-aurora-touchid-apply-pam                        add to sudo and polkit
#   mseries-aurora-touchid-apply-pam --remove               take both back out
#   mseries-aurora-touchid-apply-pam --only sudo            one service (sudo | polkit-1)
#   mseries-aurora-touchid-apply-pam --only polkit-1 --remove
#
# Same lines the upstream aurora-touchid-setup writes, kept here so the Touch ID
# settings page does not need a terminal. Idempotent; timestamped backups; the
# password stays a working fallback in every stack.
set -euo pipefail

log()  { printf '%s\n' "$*"; }
die()  { printf 'error: %s\n' "$*" >&2; exit 1; }

# MSERIES_PAM_DIR lets the test suite run unprivileged against a scratch
# directory. pkexec clears the environment, so it cannot redirect a real run.
pam_dir=${MSERIES_PAM_DIR:-/etc/pam.d}
if [[ -z ${MSERIES_PAM_DIR:-} ]]; then
  [[ $EUID -eq 0 ]] || die "must run as root (the settings page calls this with pkexec)"
fi

add_line='auth      sufficient pam_fprintd.so'
stamp=$(date +%Y%m%d-%H%M%S)

apply() {
  local file=$1
  if grep -q pam_fprintd.so "$file"; then
    log "$file: already has pam_fprintd"
    return
  fi
  cp -a "$file" "$file.pre-touchid.$stamp"
  sed -i "1i $add_line" "$file"
  log "$file: fingerprint unlock added (password still works)"
}

remove() {
  local file=$1
  [[ -f $file ]] || return 0
  if grep -q pam_fprintd.so "$file"; then
    cp -a "$file" "$file.pre-touchid-remove.$stamp"
    sed -i '/pam_fprintd\.so/d' "$file"
    log "$file: fingerprint unlock removed"
  fi
}

add_sudo() { apply "$pam_dir/sudo"; }

add_polkit() {
  if [[ ! -f $pam_dir/polkit-1 ]]; then
    # polkit has no stock PAM file on elementary; give it a full stack.
    cat > "$pam_dir/polkit-1" <<PAM
auth      sufficient pam_fprintd.so
auth      required pam_unix.so

account   required pam_unix.so
password  required pam_unix.so
session   required pam_unix.so
PAM
    log "$pam_dir/polkit-1: created with fingerprint unlock (password still works)"
  else
    apply "$pam_dir/polkit-1"
  fi
}

mode=add
only=
while (( $# )); do
  case $1 in
    --remove) mode=remove ;;
    --only)
      shift
      [[ ${1:-} == sudo || ${1:-} == polkit-1 ]] || die "--only takes sudo or polkit-1"
      only=$1 ;;
    *) die "unknown option: $1 (use --remove, --only sudo|polkit-1)" ;;
  esac
  shift
done

if [[ $mode == remove ]]; then
  [[ -z $only || $only == sudo ]]     && remove "$pam_dir/sudo"
  [[ -z $only || $only == polkit-1 ]] && remove "$pam_dir/polkit-1"
  log "done. Enrolled fingerprints stay; clear with: fprintd-delete \$USER"
else
  [[ -z $only || $only == sudo ]]     && add_sudo
  [[ -z $only || $only == polkit-1 ]] && add_polkit
  log "done. Try: sudo -k; sudo true"
fi
