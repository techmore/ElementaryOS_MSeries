@@ -102,7 +103,7 @@ int dptxport_connect(struct apple_epic_service *service, u8 core, u8 atc,
 {
 	struct dptx_port *dptx = service->cookie;
 	struct dcpdptx_connection_cmd cmd, resp;
-	u32 unk_field = 0x0; // seen as 0x100 under some conditions
+	u32 unk_field = service->ep->dcp->dp_tunnel ? 0x101 : 0;
 	int ret;
 	u32 target = FIELD_PREP(DCPDPTX_REMOTE_PORT_CORE, core) |
 		     FIELD_PREP(DCPDPTX_REMOTE_PORT_ATC, atc) |
@@ -120,9 +121,12 @@ int dptxport_connect(struct apple_epic_service *service, u8 core, u8 atc,
 
