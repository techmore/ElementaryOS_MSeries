diff --git a/drivers/phy/apple/dpin-handshake.h b/drivers/phy/apple/dpin-handshake.h
new file mode 100644
index 0000000..175faad
--- /dev/null
+++ b/drivers/phy/apple/dpin-handshake.h
@@ -0,0 +1,69 @@
+/* SPDX-License-Identifier: GPL-2.0 OR BSD-2-Clause */
+#ifndef APPLE_DPIN_HANDSHAKE_H
+#define APPLE_DPIN_HANDSHAKE_H
+
+#include <linux/errno.h>
+
+#define APPLE_DPIN_HPD 0x00
+#define APPLE_DPIN_IRQ_STATUS 0x04
+#define APPLE_DPIN_IRQ_ENABLE 0x08
+#define APPLE_DPIN_INACTIVE 0x0c
+#define APPLE_DPIN_INACTIVE_ACK 0x10
+#define APPLE_DPIN_HPD_LEVEL (1U << 2)
+
+/* Injectable I/O keeps the production polling/ack algorithm testable offline. */
+struct apple_dpin_io {
+	unsigned int (*read)(void *ctx, unsigned int offset);
+	void (*write)(void *ctx, unsigned int offset, unsigned int value);
+	unsigned long long (*time_us)(void *ctx);
+	void (*sleep)(void *ctx, unsigned int min_us, unsigned int max_us);
+	void *ctx;
+};
+
+static inline int apple_dpin_set_inactive(const struct apple_dpin_io *io,
+					unsigned int inactive)
+{
+	unsigned long long deadline = io->time_us(io->ctx) + 1000000;
+	unsigned int value, waits = 0;
+
+	if (inactive > 1)
+		return -EINVAL;
+	value = io->read(io->ctx, APPLE_DPIN_INACTIVE);
+	io->write(io->ctx, APPLE_DPIN_INACTIVE, (value & ~1U) | inactive);
+	for (;;) {
+		if ((io->read(io->ctx, APPLE_DPIN_INACTIVE_ACK) & 1U) == inactive)
+			return 0;
+		if (!inactive && !(io->read(io->ctx, APPLE_DPIN_HPD) &
+				   APPLE_DPIN_HPD_LEVEL))
+			return -ENOLINK;
+		if (io->time_us(io->ctx) >= deadline)
+			return -ETIMEDOUT;
+		if (waits++ < 5)
+			io->sleep(io->ctx, 1000, 1500);
+		else
+			io->sleep(io->ctx, 5000, 5500);
+	}
+}
+
+/* Acknowledge the same captured values as Apple's handler, after stable reads. */
+static inline int apple_dpin_ack_irq(const struct apple_dpin_io *io,
+				   unsigned int *hpd, unsigned int *status)
+{
+	unsigned int old_status, i;
+
+	for (i = 0; i < 8; i++) {
+		old_status = io->read(io->ctx, APPLE_DPIN_IRQ_STATUS);
+		*hpd = io->read(io->ctx, APPLE_DPIN_HPD);
+		*status = io->read(io->ctx, APPLE_DPIN_IRQ_STATUS);
+		if (old_status != *status)
+			continue;
+		if (!*status)
+			return 0;
+		io->write(io->ctx, APPLE_DPIN_IRQ_STATUS, *status);
+		if (*status & 1U)
+			io->write(io->ctx, APPLE_DPIN_HPD, *hpd);
+		return 1;
+	}
+	return -EAGAIN;
+}
+#endif
diff --git a/drivers/phy/apple/dpin.c b/drivers/phy/apple/dpin.c
new file mode 100644
index 0000000..801551a
--- /dev/null
+++ b/drivers/phy/apple/dpin.c
@@ -0,0 +1,352 @@
+// SPDX-License-Identifier: GPL-2.0 OR BSD-2-Clause
+/* Apple T6000 USB4 DP-IN. Static RE provenance: REA-DPIN-FINDINGS.md. */
+#include <linux/delay.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/ktime.h>
+#include <linux/module.h>
+#include <linux/notifier.h>
+#include <linux/phy/phy-apple-dpin.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/phy/phy.h>
+#include <linux/phy/phy-apple-atc.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+
+#include "dpin-handshake.h"
+
+struct apple_dpin {
+	struct device *dev;
+	void __iomem *regs;
+	struct phy *atcphy;
+	struct mutex lock;
+	struct blocking_notifier_head hpd_notifiers;
+	struct apple_dpin_io io;
+	unsigned int index;
+	unsigned int irq_enable;
+	unsigned int rate;
+	int irq;
+	bool initialized;
+	bool active;
+	bool fault;
+};
+
+static unsigned int dpin_read(void *ctx, unsigned int offset)
+{
+	struct apple_dpin *dpin = ctx;
+
+	return readl(dpin->regs + offset);
+}
+
+static void dpin_write(void *ctx, unsigned int offset, unsigned int value)
+{
+	struct apple_dpin *dpin = ctx;
+
+	writel(value, dpin->regs + offset);
+}
+
+static unsigned long long dpin_time_us(void *ctx)
+{
+	return ktime_to_us(ktime_get());
+}
+
+static void dpin_sleep(void *ctx, unsigned int min_us, unsigned int max_us)
+{
+	usleep_range(min_us, max_us);
+}
+
+static irqreturn_t dpin_irq(int irq, void *data)
+{
+	struct apple_dpin *dpin = data;
+	unsigned int hpd = 0, status = 0;
+	int ret;
+
+	mutex_lock(&dpin->lock);
+	if (!dpin->initialized) {
+		mutex_unlock(&dpin->lock);
+		return IRQ_NONE;
+	}
+	ret = apple_dpin_ack_irq(&dpin->io, &hpd, &status);
+	if (ret < 0) {
+		/* Bounded unstable status: mask this source rather than storm. */
+		dpin_write(dpin, APPLE_DPIN_IRQ_ENABLE,
+			   dpin_read(dpin, APPLE_DPIN_IRQ_ENABLE) & ~3U);
+		dpin->fault = true;
+		dev_err_ratelimited(dpin->dev, "unstable DP-IN interrupt status\n");
+	} else if (ret) {
+		dev_dbg(dpin->dev, "HPD level=%u status=%#x\n",
+			!!(hpd & APPLE_DPIN_HPD_LEVEL), status);
+	}
+	mutex_unlock(&dpin->lock);
+	if (ret < 0)
+		blocking_notifier_call_chain(&dpin->hpd_notifiers,
+					    APPLE_DPIN_HPD_ERROR, NULL);
+	else if (ret > 0)
+		blocking_notifier_call_chain(&dpin->hpd_notifiers,
+					    !!(hpd & APPLE_DPIN_HPD_LEVEL), NULL);
+	return ret ? IRQ_HANDLED : IRQ_NONE;
+}
+
+static int dpin_init(struct phy *phy)
+{
+	struct apple_dpin *dpin = phy_get_drvdata(phy);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(dpin->dev);
+	if (ret < 0)
+		return ret;
+	mutex_lock(&dpin->lock);
+	ret = apple_atcphy_dp_tunnel_get(dpin->atcphy, dpin->index);
+	if (ret)
+		goto out;
+	dpin->fault = false;
+	dpin->initialized = true;
+	dpin->irq_enable = dpin_read(dpin, APPLE_DPIN_IRQ_ENABLE);
+	dpin_write(dpin, APPLE_DPIN_IRQ_ENABLE, dpin->irq_enable | 3U);
+	mutex_unlock(&dpin->lock);
+	enable_irq(dpin->irq);
+	return 0;
+out:
+	mutex_unlock(&dpin->lock);
+	pm_runtime_put(dpin->dev);
+	return ret;
+}
+
+static int dpin_exit(struct phy *phy)
+{
+	struct apple_dpin *dpin = phy_get_drvdata(phy);
+	int ret;
+
+	mutex_lock(&dpin->lock);
+	if (dpin->active) {
+		mutex_unlock(&dpin->lock);
+		return -EBUSY;
+	}
+	if (dpin->fault) {
+		ret = apple_dpin_set_inactive(&dpin->io, 1);
+		if (ret) {
+			mutex_unlock(&dpin->lock);
+			return ret;
+		}
+	}
+	ret = apple_atcphy_dp_tunnel_put(dpin->atcphy, dpin->index);
+	if (ret) {
+		mutex_unlock(&dpin->lock);
+		return ret;
+	}
+	dpin_write(dpin, APPLE_DPIN_IRQ_ENABLE, dpin->irq_enable);
+	dpin->initialized = false;
+	mutex_unlock(&dpin->lock);
+	disable_irq(dpin->irq);
+	pm_runtime_put(dpin->dev);
+	return 0;
+}
+
+static int dpin_power_on(struct phy *phy)
+{
+	struct apple_dpin *dpin = phy_get_drvdata(phy);
+	int ret, rollback;
+
+	mutex_lock(&dpin->lock);
+	if (!dpin->initialized || dpin->fault) {
+		ret = -EIO;
+		goto out;
+	}
+	ret = apple_dpin_set_inactive(&dpin->io, 0);
+	if (ret) {
+		rollback = apple_dpin_set_inactive(&dpin->io, 1);
+		if (rollback) {
+			dpin->fault = true;
+			dev_err(dpin->dev, "DP-IN inactive rollback failed: %d\n", rollback);
+		}
+	} else {
+		dpin->active = true;
+	}
+out:
+	mutex_unlock(&dpin->lock);
+	return ret;
+}
+
+static int dpin_power_off(struct phy *phy)
+{
+	struct apple_dpin *dpin = phy_get_drvdata(phy);
+	int ret;
+
+	mutex_lock(&dpin->lock);
+	if (!dpin->initialized) {
+		mutex_unlock(&dpin->lock);
+		return -EINVAL;
+	}
+	ret = apple_dpin_set_inactive(&dpin->io, 1);
+	if (!ret)
+		ret = apple_atcphy_dp_tunnel_configure(dpin->atcphy, dpin->index, 0);
+	if (!ret) {
+		dpin->active = false;
+		dpin->rate = 0;
+	}
+	mutex_unlock(&dpin->lock);
+	return ret;
+}
+
+static int dpin_validate(struct phy *phy, enum phy_mode mode, int submode,
+			 union phy_configure_opts *opts)
+{
+	if (mode != PHY_MODE_DP || submode)
+		return -EINVAL;
+	opts->dp.lanes = 4;
+	return 0;
+}
+
+static int dpin_configure(struct phy *phy, union phy_configure_opts *opts)
+{
+	struct apple_dpin *dpin = phy_get_drvdata(phy);
+	int ret = 0;
+
+	if (opts->dp.set_voltages)
+		return -EOPNOTSUPP;
+	if (opts->dp.set_lanes && opts->dp.lanes != 0 && opts->dp.lanes != 1 &&
+	    opts->dp.lanes != 2 && opts->dp.lanes != 4)
+		return -EINVAL;
+	mutex_lock(&dpin->lock);
+	if (!dpin->initialized || dpin->fault) {
+		ret = -EIO;
+		goto out;
+	}
+	if (opts->dp.set_rate) {
+		/* Do not remove the clock underneath an active DP-IN handshake. */
+		if (!opts->dp.link_rate && dpin->active) {
+			ret = -EBUSY;
+			goto out;
+		}
+		ret = apple_atcphy_dp_tunnel_configure(dpin->atcphy, dpin->index,
+						     opts->dp.link_rate);
+		if (!ret)
+			dpin->rate = opts->dp.link_rate;
+	}
+out:
+	mutex_unlock(&dpin->lock);
+	return ret;
+}
+
+static const struct phy_ops dpin_ops = {
+	.init = dpin_init,
+	.exit = dpin_exit,
+	.power_on = dpin_power_on,
+	.power_off = dpin_power_off,
+	.validate = dpin_validate,
+	.configure = dpin_configure,
+	.owner = THIS_MODULE,
+};
+
+int apple_dpin_get_hpd(struct phy *phy)
+{
+	struct apple_dpin *dpin;
+	int ret;
+
+	if (!phy || phy->ops != &dpin_ops)
+		return -EINVAL;
+	dpin = phy_get_drvdata(phy);
+	mutex_lock(&dpin->lock);
+	ret = dpin->initialized && !dpin->fault ?
+		!!(dpin_read(dpin, APPLE_DPIN_HPD) & APPLE_DPIN_HPD_LEVEL) : -ENODEV;
+	mutex_unlock(&dpin->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(apple_dpin_get_hpd);
+
+int apple_dpin_register_hpd(struct phy *phy, struct notifier_block *nb)
+{
+	struct apple_dpin *dpin;
+
+	if (!phy || phy->ops != &dpin_ops)
+		return -EINVAL;
+	dpin = phy_get_drvdata(phy);
+	return blocking_notifier_chain_register(&dpin->hpd_notifiers, nb);
+}
+EXPORT_SYMBOL_GPL(apple_dpin_register_hpd);
+
+int apple_dpin_unregister_hpd(struct phy *phy, struct notifier_block *nb)
+{
+	struct apple_dpin *dpin;
+
+	if (!phy || phy->ops != &dpin_ops)
+		return -EINVAL;
+	dpin = phy_get_drvdata(phy);
+	return blocking_notifier_chain_unregister(&dpin->hpd_notifiers, nb);
+}
+EXPORT_SYMBOL_GPL(apple_dpin_unregister_hpd);
+
+static void dpin_pm_disable(void *data)
+{
+	pm_runtime_disable(data);
+}
+
+static int dpin_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct phy_provider *provider;
+	struct apple_dpin *dpin;
+	struct resource *res;
+	struct phy *phy;
+	int ret;
+
+	dpin = devm_kzalloc(dev, sizeof(*dpin), GFP_KERNEL);
+	if (!dpin)
+		return -ENOMEM;
+	dpin->dev = dev;
+	mutex_init(&dpin->lock);
+	BLOCKING_INIT_NOTIFIER_HEAD(&dpin->hpd_notifiers);
+	ret = of_property_read_u32(dev->of_node, "apple,transport-index", &dpin->index);
+	if (ret || dpin->index > 1)
+		return -EINVAL;
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res || resource_size(res) != 0x4000)
+		return -EINVAL;
+	dpin->regs = devm_ioremap_resource(dev, res);
+	if (IS_ERR(dpin->regs))
+		return PTR_ERR(dpin->regs);
+	dpin->atcphy = devm_phy_get(dev, "atc-phy");
+	if (IS_ERR(dpin->atcphy))
+		return dev_err_probe(dev, PTR_ERR(dpin->atcphy), "missing ATC PHY\n");
+	dpin->irq = platform_get_irq(pdev, 0);
+	if (dpin->irq < 0)
+		return dpin->irq;
+	dpin->io = (struct apple_dpin_io) {
+		.read = dpin_read, .write = dpin_write, .time_us = dpin_time_us,
+		.sleep = dpin_sleep, .ctx = dpin,
+	};
+	ret = devm_request_threaded_irq(dev, dpin->irq, NULL, dpin_irq,
+					IRQF_ONESHOT | IRQF_NO_AUTOEN,
+					dev_name(dev), dpin);
+	if (ret)
+		return ret;
+	phy = devm_phy_create(dev, NULL, &dpin_ops);
+	if (IS_ERR(phy))
+		return PTR_ERR(phy);
+	phy_set_drvdata(phy, dpin);
+	pm_runtime_enable(dev);
+	ret = devm_add_action_or_reset(dev, dpin_pm_disable, dev);
+	if (ret)
+		return ret;
+	provider = devm_of_phy_provider_register(dev, of_phy_simple_xlate);
+	return PTR_ERR_OR_ZERO(provider);
+}
+
+static const struct of_device_id dpin_of_match[] = {
+	{ .compatible = "apple,t6000-dpin" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, dpin_of_match);
+
+static struct platform_driver dpin_driver = {
+	.probe = dpin_probe,
+	.driver = {
+		.name = "apple-dpin",
+		.of_match_table = dpin_of_match,
+		.suppress_bind_attrs = true,
+	},
+};
+module_platform_driver(dpin_driver);
+MODULE_DESCRIPTION("Apple T6000 USB4 DisplayPort input PHY");
+MODULE_LICENSE("Dual BSD/GPL");
