 		disable_irq(dcp->hdmi_hpd_irq);
 
@@ -1315,6 +1377,10 @@ static int dcp_platform_suspend(struct device *dev)
 {
 	struct apple_dcp *dcp = dev_get_drvdata(dev);
 
