diff --git a/tools/testing/apple-dpin/README b/tools/testing/apple-dpin/README
new file mode 100644
index 0000000..9de7927
--- /dev/null
+++ b/tools/testing/apple-dpin/README
@@ -0,0 +1,26 @@
+Offline checks for the experimental T6000 DP-IN patch
+====================================================
+Run from the patched kernel source root. Nothing here opens a device,
+loads a module, writes registers or changes the running kernel.
+
+  gcc -std=gnu11 -Wall -Wextra -Werror -fsanitize=undefined \
+      -Idrivers/phy/apple tools/testing/apple-dpin/dpin-offline.c \
+      -o /tmp/apple-dpin-offline
+  /tmp/apple-dpin-offline
+  python3 tools/testing/apple-dpin/test-clock.py .
+  python3 tools/testing/apple-dpin/test-connection.py .
+  python3 tools/testing/apple-dpin/test-dtb.py \
+      /path/to/build/arch/arm64/boot/dts/apple/t6000-j314s.dtb \
+      /path/to/build/arch/arm64/boot/dts/apple/t6001-j314c.dtb
+
+Expected: 11 helper groups, 11 production-clock groups, 7 production-EPIC
+connection groups, and two compiled-board wiring checks.
+
+The C test includes the exact production handshake/IRQ helper. Clock and
+connection tests extract the actual function definitions from the supplied
+source and compile them against fake MMIO/transport. They do not validate
+firmware callback ordering, locking, workqueue races, hardware register
+semantics, real timeouts, runtime PM, EDID, video or suspend. Clock polling
+uses an immediate fake predicate; handshake time uses an injected clock.
+Source extraction deliberately fails if the expected function boundaries
+change. A passing suite is not hardware qualification.
diff --git a/tools/testing/apple-dpin/dpin-offline.c b/tools/testing/apple-dpin/dpin-offline.c
new file mode 100644
index 0000000..521785b
--- /dev/null
+++ b/tools/testing/apple-dpin/dpin-offline.c
@@ -0,0 +1,124 @@
+// SPDX-License-Identifier: GPL-2.0 OR BSD-2-Clause
+#include <assert.h>
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include "dpin-handshake.h"
+#include "atc-dp-tunnel.h"
+
+struct fake {
+	unsigned int regs[5];
+	unsigned long long now;
+	unsigned int sleeps, reads, writes;
+	unsigned int ack_after;
+	unsigned int hpd_after;
+	unsigned int unstable;
+	unsigned int offsets[16], values[16];
+};
+
+static unsigned int rd(void *ctx, unsigned int offset)
+{
+	struct fake *f = ctx;
+
+	f->reads++;
+	if (f->unstable && offset == APPLE_DPIN_IRQ_STATUS)
+		return f->reads;
+	if (offset == APPLE_DPIN_INACTIVE_ACK && f->ack_after &&
+	    f->sleeps >= f->ack_after)
+		return f->regs[APPLE_DPIN_INACTIVE / 4] & 1;
+	if (offset == APPLE_DPIN_HPD && f->hpd_after && f->sleeps >= f->hpd_after)
+		return 0;
+	return f->regs[offset / 4];
+}
+
+static void wr(void *ctx, unsigned int offset, unsigned int value)
+{
+	struct fake *f = ctx;
+
+	assert(f->writes < 16);
+	f->offsets[f->writes] = offset;
+	f->values[f->writes++] = value;
+	f->regs[offset / 4] = value;
+}
+
+static unsigned long long now(void *ctx)
+{
+	return ((struct fake *)ctx)->now;
+}
+
+static void sleep_fake(void *ctx, unsigned int min, unsigned int max)
+{
+	struct fake *f = ctx;
+
+	assert(max >= min);
+	f->now += min;
+	f->sleeps++;
+}
+
+static struct apple_dpin_io io_for(struct fake *f)
+{
+	return (struct apple_dpin_io) { rd, wr, now, sleep_fake, f };
+}
+
+int main(void)
+{
+	struct fake f = { .regs = { 4, 0, 0, 0xa5, 1 }, .ack_after = 3 };
+	struct apple_dpin_io io = io_for(&f);
+	unsigned int hpd, status;
+	int tests = 0;
+
+	/* Activation preserves unrelated bits and waits for a real ACK. */
+	assert(apple_dpin_set_inactive(&io, 0) == 0);
+	assert(f.writes == 1 && f.values[0] == 0xa4 && f.sleeps == 3);
+	tests++;
+	/* No sink during the wait returns ENOLINK, not fabricated success. */
+	f = (struct fake) { .regs = { 0, 0, 0, 1, 1 } };
+	assert(apple_dpin_set_inactive(&io, 0) == -ENOLINK);
+	assert(f.sleeps == 0);
+	tests++;
+	/* HPD disappearing during a pending ACK is bounded too. */
+	f = (struct fake) { .regs = { 4, 0, 0, 1, 1 }, .hpd_after = 2 };
+	assert(apple_dpin_set_inactive(&io, 0) == -ENOLINK);
+	assert(f.sleeps == 2);
+	tests++;
+	f = (struct fake) { .regs = { 4, 0, 0, 1, 1 } };
+	assert(apple_dpin_set_inactive(&io, 0) == -ETIMEDOUT);
+	assert(f.now >= 1000000 && f.now < 1005000 && f.sleeps < 210);
+	tests++;
+	/* Rollback/deactivation ignores HPD low and waits for inactive ACK. */
+	f = (struct fake) { .regs = { 0, 0, 0, 0xa4, 0 }, .ack_after = 2 };
+	assert(apple_dpin_set_inactive(&io, 1) == 0);
+	assert(f.values[0] == 0xa5 && f.sleeps == 2);
+	tests++;
+	f = (struct fake) { 0 };
+	assert(apple_dpin_set_inactive(&io, 2) == -EINVAL && f.writes == 0);
+	tests++;
+	/* Captured-value IRQ acknowledgment, not a made-up constant W1C mask. */
+	f = (struct fake) { .regs = { 7, 3, 0, 0, 0 } };
+	assert(apple_dpin_ack_irq(&io, &hpd, &status) == 1);
+	assert(f.writes == 2 && f.offsets[0] == 4 && f.values[0] == 3);
+	assert(f.offsets[1] == 0 && f.values[1] == 7);
+	tests++;
+	f = (struct fake) { .regs = { 4, 2, 0, 0, 0 } };
+	assert(apple_dpin_ack_irq(&io, &hpd, &status) == 1 && f.writes == 1);
+	tests++;
+	f = (struct fake) { .regs = { 4, 0, 0, 0, 0 } };
+	assert(apple_dpin_ack_irq(&io, &hpd, &status) == 0 && f.writes == 0);
+	tests++;
+	f = (struct fake) { .unstable = 1 };
+	assert(apple_dpin_ack_irq(&io, &hpd, &status) == -EAGAIN);
+	assert(f.writes == 0 && f.reads == 24);
+	tests++;
+	/* Independent facts decoded from Apple's fixed tunnel descriptor/rates. */
+	assert(apple_atc_tunnel_pclk_select(1620) == 4);
+	assert(apple_atc_tunnel_pclk_select(2700) == 3);
+	assert(apple_atc_tunnel_pclk_select(5400) == 1);
+	assert(apple_atc_tunnel_pclk_select(8100) == 0);
+	assert(apple_atc_tunnel_pclk_select(2160) == -EINVAL);
+	assert(APPLE_ATC_TUNNEL_DESC_A == 0x1e0e021cU);
+	assert(APPLE_ATC_TUNNEL_DESC_B == 0U);
+	assert(APPLE_ATC_TUNNEL_DESC_C == 0x00654a00U);
+	tests++;
+	printf("PASS: %d offline production-helper test groups\n", tests);
+	return 0;
+}
diff --git a/tools/testing/apple-dpin/test-clock.py b/tools/testing/apple-dpin/test-clock.py
new file mode 100644
index 0000000..1de922e
--- /dev/null
+++ b/tools/testing/apple-dpin/test-clock.py
@@ -0,0 +1,145 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0 OR BSD-2-Clause
+"""Compile the actual ATC tunnel functions against bounded fake MMIO, then run."""
+import pathlib, re, subprocess, sys, tempfile
+source = pathlib.Path(sys.argv[1]).resolve()
+text = (source / 'drivers/phy/apple/atc.c').read_text()
+start = text.index('static int atcphy_auspll_apb_command(')
+end = text.index('static int atcphy_dp_configure(', start)
+production = text[start:end]
