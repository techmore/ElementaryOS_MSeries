+ assert((mmio[0x2208/4]&0x1f0000)==0x10000); groups++;
+ assert(!apple_atcphy_dp_tunnel_configure(&p,1,2700));
+ assert(a.tunnel_rate[1]==2700 && apb_calls==2);
+ assert((mmio[0x7000/4] & 0x4380)==0x4180); groups++;
+ assert(!apple_atcphy_dp_tunnel_configure(&p,0,8100));
+ assert(apb_calls==2 && (mmio[0x7000/4]&0x70)==0);
+ before=writes;
+ assert(apple_atcphy_dp_tunnel_configure(&p,0,2160)==-EINVAL && writes==before); groups++;
+ assert(!apple_atcphy_dp_tunnel_put(&p,0));
+ assert(apb_calls==2 && a.tunnel_rate[1]==2700);
+ assert((mmio[0x2200/4]&0x54)==0x54); groups++;
+ assert(!apple_atcphy_dp_tunnel_put(&p,1));
+ assert(apb_calls==3 && a.tunnel_users[1]==0 && !a.tunnel_rate[1]);
+ assert((mmio[0x2200/4]&0x54)==0); groups++;
+ reset(&a,&p,&d); assert(!apple_atcphy_dp_tunnel_get(&p,0));
+ fail_lock=true;
