@@ -424,16 +461,32 @@ static void disconnected_hpd_event(struct apple_connector *con)
 
 static int dcp_dptx_disconnect(struct apple_dcp *dcp, u32 port)
 {
-	dev_info(dcp->dev, "%s(port=%d)\n", __func__, port);
+	struct dptx_port *dptx;
+	int ret = 0, cleanup;
 
+	if (port >= dcp->hw.num_dptx_ports || (dcp->dp_tunnel && port))
+		return -EINVAL;
+	dptx = &dcp->dptxport[port];
 	mutex_lock(&dcp->hpd_mutex);
-	if (dcp->dptxport[port].enabled && dcp->dptxport[port].connected) {
-		dptxport_release_display(dcp->dptxport[port].service);
-		dcp->dptxport[port].connected = false;
+	if (dcp->dp_tunnel) {
