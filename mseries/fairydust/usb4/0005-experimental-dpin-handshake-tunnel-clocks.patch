+ assert(!a.tunnel_rate[0] && !a.tunnel_fault && mmio[0x7000/4]==0); groups++;
+ reset(&a,&p,&d); assert(!apple_atcphy_dp_tunnel_get(&p,0));
+ assert(!apple_atcphy_dp_tunnel_configure(&p,0,5400));
