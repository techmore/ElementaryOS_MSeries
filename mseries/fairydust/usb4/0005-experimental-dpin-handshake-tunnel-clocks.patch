+/* SPDX-License-Identifier: GPL-2.0 OR BSD-2-Clause */
+#ifndef APPLE_ATC_DP_TUNNEL_H
+#define APPLE_ATC_DP_TUNNEL_H
+
+/* Shared by the driver and offline tests. Values are PHY Mb/s, not DPCD codes. */
+static inline int apple_atc_tunnel_pclk_select(unsigned int rate)
+{
+	switch (rate) {
+	case 1620: return 4;
+	case 2700: return 3;
+	case 5400: return 1;
+	case 8100: return 0;
+	default: return -EINVAL;
+	}
+}
+
+/* Fixed tunnel AUSPLL descriptor, derived from T6000/13.5, not per-rate DP. */
+#define APPLE_ATC_TUNNEL_DESC_A ((540U) | (8U << 14) | (3U << 18) | \
+				(8U << 22) | (7U << 26))
+#define APPLE_ATC_TUNNEL_DESC_B 0U
+#define APPLE_ATC_TUNNEL_DESC_C ((5U << 9) | (1U << 14) | (5U << 16) | \
+				(2U << 20) | (1U << 22))
+
+#endif
