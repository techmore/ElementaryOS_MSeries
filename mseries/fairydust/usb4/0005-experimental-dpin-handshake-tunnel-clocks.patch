+
+/* Tunnel clocks share AUSPLL, but never use the physical DP lane/AUX path. */
+static bool atcphy_in_cio_mode(struct apple_atcphy *atcphy)
+{
+	return atcphy->mode == APPLE_ATCPHY_MODE_USB4 ||
+	       atcphy->mode == APPLE_ATCPHY_MODE_TBT;
+}
+
+static struct apple_atcphy *atcphy_tunnel_owner(struct phy *phy)
+{
+	struct apple_atcphy *atcphy;
+
+	if (!phy || !phy->dev.parent ||
+	    !of_device_is_compatible(phy->dev.parent->of_node, "apple,t6000-atcphy"))
+		return ERR_PTR(-ENODEV);
+	atcphy = phy_get_drvdata(phy);
+	if (!atcphy || atcphy->phys.dp != phy)
+		return ERR_PTR(-EINVAL);
+	return atcphy;
+}
+
+static void atcphy_tunnel_wake(struct apple_atcphy *atcphy)
+{
+	/* Common/TX wake and unclamp, without lane mux or CIO PLL changes. */
+	core_set32(atcphy, ACIOPHY_CFG0, BIT(2));
+	core_set32(atcphy, ACIOPHY_CFG0, BIT(3));
+	core_set32(atcphy, ACIOPHY_CFG0, BIT(0));
+	core_set32(atcphy, ACIOPHY_CFG0, BIT(1));
+	core_clear32(atcphy, ACIOPHY_CFG0, BIT(4));
+	core_set32(atcphy, ACIOPHY_CFG0, BIT(5));
+	core_set32(atcphy, ACIOPHY_SLEEP_CTRL, GENMASK(5, 4));
+	core_set32(atcphy, ACIOPHY_SLEEP_CTRL, GENMASK(7, 6));
+	core_set32(atcphy, ACIOPHY_SLEEP_CTRL, GENMASK(1, 0));
+	core_set32(atcphy, ACIOPHY_SLEEP_CTRL, GENMASK(3, 2));
+	core_clear32(atcphy, ACIOPHY_SLEEP_CTRL, GENMASK(9, 8));
+	core_set32(atcphy, ACIOPHY_SLEEP_CTRL, GENMASK(11, 10));
+	core_set32(atcphy, ACIOPHY_CFG0, GENMASK(11, 10));
+	core_set32(atcphy, ACIOPHY_CFG0, GENMASK(13, 12));
+	core_set32(atcphy, ACIOPHY_CFG0, GENMASK(7, 6));
+	core_set32(atcphy, ACIOPHY_CFG0, GENMASK(9, 8));
+	core_clear32(atcphy, ACIOPHY_CFG0, GENMASK(15, 14));
+	core_set32(atcphy, ACIOPHY_CFG0, GENMASK(17, 16));
+	core_set32(atcphy, ACIOPHY_LANE_DP_CFG_BLK_TX_DP_CTRL0,
+		   DPTXPHY_PMA_LANE_RESET_N | DPTXPHY_PMA_LANE_RESET_N_OV);
+}
+
+static int atcphy_tunnel_pll_start(struct apple_atcphy *atcphy)
+{
+	u32 reg;
+	int ret;
+
+	core_clear32(atcphy, AUSPLL_FREQ_CFG, AUSPLL_FREQ_REFCLK);
+	writel(APPLE_ATC_TUNNEL_DESC_A, atcphy->regs.core + AUSPLL_FREQ_DESC_A);
+	core_mask32(atcphy, AUSPLL_FREQ_DESC_B,
+		    AUSPLL_FD_FBDIVN_FRAC_DEN | AUSPLL_FD_FBDIVN_FRAC_NUM,
+		    APPLE_ATC_TUNNEL_DESC_B);
+	core_mask32(atcphy, AUSPLL_FREQ_DESC_C, GENMASK(22, 0),
+		    APPLE_ATC_TUNNEL_DESC_C);
+	core_mask32(atcphy, AUSPLL_CLKOUT_DIV, AUSPLL_CLKOUT_PLLA_REFBUFCLK_DI,
+		    FIELD_PREP(AUSPLL_CLKOUT_PLLA_REFBUFCLK_DI, 1));
+	core_set32(atcphy, AUSPLL_CLKOUT_DTC_VREG, AUSPLL_DTC_VREG_BYPASS);
+	core_set32(atcphy, AUSPLL_BGR, AUSPLL_BGR_CTRL_AVAIL);
+	core_set32(atcphy, AUSPLL_CLKOUT_MASTER,
+		   AUSPLL_CLKOUT_MASTER_PCLK_DRVR_EN |
+		   AUSPLL_CLKOUT_MASTER_PCLK2_DRVR_EN |
+		   AUSPLL_CLKOUT_MASTER_REFBUFCLK_DRVR_EN);
+
+	ret = atcphy_auspll_apb_command(atcphy, 0, 500000);
+	if (ret)
+		return ret;
+	ret = readl_poll_timeout(atcphy->regs.core + ACIOPHY_DP_PCLK_STAT,
+				reg, reg & ACIOPHY_AUSPLL_LOCK, 1000, 500000);
+	if (ret)
+		return ret;
+	return atcphy_auspll_apb_command(atcphy, 0x2000, 500000);
+}
+
+static int atcphy_tunnel_pll_stop(struct apple_atcphy *atcphy)
+{
+	core_clear32(atcphy, AUSPLL_CLKOUT_MASTER,
+		     AUSPLL_CLKOUT_MASTER_PCLK_DRVR_EN |
+		     AUSPLL_CLKOUT_MASTER_PCLK2_DRVR_EN |
+		     AUSPLL_CLKOUT_MASTER_REFBUFCLK_DRVR_EN);
+	return atcphy_auspll_apb_command(atcphy, 3, 500000);
+}
+
+/* Caller holds atcphy->lock. Software ownership changes only on success. */
+static int atcphy_tunnel_set_rate(struct apple_atcphy *atcphy,
+				unsigned int index, unsigned int rate)
+{
+	static const unsigned int snapshot_regs[] = {
+		ACIOPHY_CFG0, ACIOPHY_SLEEP_CTRL,
+		ACIOPHY_LANE_DP_CFG_BLK_TX_DP_CTRL0, AUSPLL_FREQ_CFG,
+		AUSPLL_FREQ_DESC_A, AUSPLL_FREQ_DESC_B, AUSPLL_FREQ_DESC_C,
+		AUSPLL_CLKOUT_DIV, AUSPLL_CLKOUT_DTC_VREG,
+		AUSPLL_BGR, AUSPLL_CLKOUT_MASTER,
+	};
+	u32 saved[ARRAY_SIZE(snapshot_regs)], reg;
+	u32 mask = index ? DPTX_PCLK2_SELECT : DPTX_PCLK1_SELECT;
+	u32 enable = index ? DPTX_PCLK2_ENABLE : DPTX_PCLK1_ENABLE;
+	int select, ret, stop_ret;
+	bool first;
+	unsigned int i;
+
+	lockdep_assert_held(&atcphy->lock);
+	if (rate && atcphy->tunnel_fault)
+		return -EIO;
+	if (atcphy->tunnel_rate[index] == rate) {
+		if (rate && !atcphy_in_cio_mode(atcphy))
+			return -ENOLINK;
+		if (!rate && atcphy->tunnel_fault) {
+			if (!atcphy_in_cio_mode(atcphy))
+				return -ENOLINK;
+			ret = atcphy_tunnel_pll_stop(atcphy);
+			if (!ret)
+				atcphy->tunnel_fault = false;
+			return ret;
+		}
+		return 0;
+	}
+	if (!atcphy_in_cio_mode(atcphy))
+		return -ENOLINK;
+	select = rate ? apple_atc_tunnel_pclk_select(rate) : 0;
+	if (select < 0)
+		return select;
+	first = !atcphy->tunnel_rate[0] && !atcphy->tunnel_rate[1];
+	if (rate && first) {
+		ret = readl_poll_timeout(atcphy->regs.core + ACIOPHY_CMN_SHM_STS_REG0,
+					reg, reg & ACIOPHY_CMN_SHM_STS_REG0_CMD_READY,
+					10, 10000);
+		if (ret)
+			return ret;
+	}
+	for (i = 0; i < ARRAY_SIZE(snapshot_regs); i++)
+		saved[i] = readl(atcphy->regs.core + snapshot_regs[i]);
+
+	if (rate) {
+		if (first)
+			atcphy_tunnel_wake(atcphy);
+		/* Enable only this DP-IN clock; never touch DPRX or physical lanes. */
+		core_set32(atcphy, ACIOPHY_LANE_DP_CFG_BLK_TX_DP_CTRL0, enable);
+		core_mask32(atcphy, ACIOPHY_LANE_DP_CFG_BLK_TX_DP_CTRL0, mask,
+			    (u32)select << (index ? 7 : 4));
+		if (first) {
+			ret = atcphy_tunnel_pll_start(atcphy);
+			if (ret) {
+				stop_ret = atcphy_tunnel_pll_stop(atcphy);
+				for (i = 0; i < ARRAY_SIZE(snapshot_regs); i++)
+					writel(saved[i], atcphy->regs.core + snapshot_regs[i]);
+				/* An unacknowledged shutdown has unknown PLL state. */
+				atcphy->tunnel_fault = !!stop_ret;
+				return ret;
+			}
+		}
+	} else {
+		core_clear32(atcphy, ACIOPHY_LANE_DP_CFG_BLK_TX_DP_CTRL0, enable);
+		if (!atcphy->tunnel_rate[index ^ 1]) {
+			ret = atcphy_tunnel_pll_stop(atcphy);
+			if (ret) {
+				atcphy->tunnel_fault = true;
+				return ret;
+			}
+			atcphy->tunnel_fault = false;
+		}
+	}
+	atcphy->tunnel_rate[index] = rate;
+	return 0;
+}
+
+int apple_atcphy_dp_tunnel_get(struct phy *phy, unsigned int index)
+{
+	struct apple_atcphy *atcphy = atcphy_tunnel_owner(phy);
+
+	if (IS_ERR(atcphy))
+		return PTR_ERR(atcphy);
+	if (index > 1)
+		return -EINVAL;
+	guard(mutex)(&atcphy->lock);
+	if (!atcphy_in_cio_mode(atcphy))
+		return -ENOLINK;
+	if (atcphy->tunnel_fault)
+		return -EIO;
+	if (atcphy->tunnel_users[index] == UINT_MAX)
+		return -EOVERFLOW;
+	atcphy->tunnel_users[index]++;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(apple_atcphy_dp_tunnel_get);
+
+int apple_atcphy_dp_tunnel_configure(struct phy *phy, unsigned int index,
+				    unsigned int rate)
+{
+	struct apple_atcphy *atcphy = atcphy_tunnel_owner(phy);
+
+	if (IS_ERR(atcphy))
+		return PTR_ERR(atcphy);
+	if (index > 1)
+		return -EINVAL;
+	guard(mutex)(&atcphy->lock);
+	if (!atcphy->tunnel_users[index])
+		return -EINVAL;
+	return atcphy_tunnel_set_rate(atcphy, index, rate);
+}
+EXPORT_SYMBOL_GPL(apple_atcphy_dp_tunnel_configure);
+
+int apple_atcphy_dp_tunnel_put(struct phy *phy, unsigned int index)
+{
+	struct apple_atcphy *atcphy = atcphy_tunnel_owner(phy);
+	int ret;
+
+	if (IS_ERR(atcphy))
+		return PTR_ERR(atcphy);
+	if (index > 1)
+		return -EINVAL;
+	guard(mutex)(&atcphy->lock);
+	if (!atcphy->tunnel_users[index])
+		return -EINVAL;
+	if (atcphy->tunnel_users[index] == 1) {
+		ret = atcphy_tunnel_set_rate(atcphy, index, 0);
+		if (ret)
+			return ret;
+	}
+	atcphy->tunnel_users[index]--;
 	return 0;
 }
+EXPORT_SYMBOL_GPL(apple_atcphy_dp_tunnel_put);
 
