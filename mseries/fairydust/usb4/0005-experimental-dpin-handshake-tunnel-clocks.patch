@@ -231,6 +235,174 @@ dptxport_call_set_drive_settings(struct apple_epic_service *service,
 	return 0;
 }
 
+/* IRQ callbacks only queue work: never send EPIC requests from the IRQ path. */
+static void dptxport_hpd_work(struct work_struct *work)
+{
+	struct dptx_port *dptx = container_of(work, struct dptx_port, hpd_work);
+	struct phy *phy;
+	int hpd, ret;
+
+	mutex_lock(&dptx->phy_lock);
+	phy = dptx->phy_initialized && !dptx->tearing_down ? dptx->atcphy : NULL;
+	mutex_unlock(&dptx->phy_lock);
+	if (!phy)
+		return;
+	hpd = apple_dpin_get_hpd(phy);
+	if (READ_ONCE(dptx->tearing_down))
+		return;
+	if (hpd < 0) {
+		WRITE_ONCE(dptx->link_error, hpd);
+		complete_all(&dptx->linkcfg_completion);
+		hpd = 0;
+	}
+	ret = dptxport_set_hpd(dptx->service, hpd);
+	if (ret) {
+		WRITE_ONCE(dptx->link_error, ret);
+		complete_all(&dptx->linkcfg_completion);
+	}
+}
+
+static int dptxport_hpd_notify(struct notifier_block *nb,
+			     unsigned long event, void *data)
+{
+	struct dptx_port *dptx = container_of(nb, struct dptx_port, hpd_nb);
+
+	if (!READ_ONCE(dptx->tearing_down)) {
+		if (event == APPLE_DPIN_HPD_ERROR) {
+			WRITE_ONCE(dptx->link_error, -EIO);
+			complete_all(&dptx->linkcfg_completion);
+		}
+		schedule_work(&dptx->hpd_work);
+	}
+	return NOTIFY_OK;
+}
+
+/* Callbacks and disconnect use this lock; never hold it over an AFK call. */
+static int dptxport_tunnel_reply(struct dptx_port *dptx, void *reply,
+				  size_t reply_size, int ret)
+{
+	if (ret) {
+		WRITE_ONCE(dptx->link_error, ret);
+		complete_all(&dptx->linkcfg_completion);
+	}
+	if (reply_size < sizeof(__le32))
+		return -EINVAL;
+	if (!ret && READ_ONCE(dptx->phy_powered) && READ_ONCE(dptx->link_rate) &&
+	    READ_ONCE(dptx->lane_count) && !READ_ONCE(dptx->link_error))
+		complete_all(&dptx->linkcfg_completion);
+	*(__le32 *)reply = cpu_to_le32(ret ? 1 : 0);
+	return 0;
+}
+
+int dptxport_tunnel_cleanup(struct dptx_port *dptx)
+{
+	int ret = 0;
+
+	mutex_lock(&dptx->phy_lock);
+	dptx->tearing_down = true;
+	if (dptx->hpd_registered) {
+		ret = apple_dpin_unregister_hpd(dptx->atcphy, &dptx->hpd_nb);
+		if (ret)
+			goto out;
+		dptx->hpd_registered = false;
+	}
+	mutex_unlock(&dptx->phy_lock);
+	cancel_work_sync(&dptx->hpd_work);
+	mutex_lock(&dptx->phy_lock);
+	if (dptx->phy_powered) {
+		ret = phy_power_off(dptx->atcphy);
+		if (ret)
+			goto out;
+		dptx->phy_powered = false;
+	}
+	if (dptx->phy_initialized) {
+		ret = phy_exit(dptx->atcphy);
+		if (ret)
+			goto out;
+		dptx->phy_initialized = false;
+	}
+	dptx->atcphy = NULL;
+	dptx->link_rate = dptx->pending_link_rate = 0;
+	dptx->lane_count = 0;
+out:
+	mutex_unlock(&dptx->phy_lock);
+	return ret;
+}
+
+static int dptxport_tunnel_rate(struct dptx_port *dptx, unsigned int rate,
+				 unsigned int phy_rate, void *reply, size_t size)
+{
+	union phy_configure_opts opts = { .dp = {
+		.link_rate = phy_rate, .set_rate = 1,
+	} };
+	int ret;
+
+	memset(reply, 0, size);
+	mutex_lock(&dptx->phy_lock);
+	if (!dptx->phy_initialized || dptx->tearing_down)
+		ret = -ESHUTDOWN;
+	else
+		ret = phy_configure(dptx->atcphy, &opts);
+	if (!ret)
+		dptx->link_rate = dptx->pending_link_rate = rate;
+	ret = dptxport_tunnel_reply(dptx, reply, size, ret);
+	mutex_unlock(&dptx->phy_lock);
+	return ret;
+}
+
+static int dptxport_tunnel_lanes(struct dptx_port *dptx, u64 lanes,
+				   void *reply, size_t size)
+{
+	union phy_configure_opts opts = { .dp = { .set_lanes = 1 } };
+	int ret;
+
+	memset(reply, 0, size);
+	mutex_lock(&dptx->phy_lock);
+	if (!dptx->phy_initialized || dptx->tearing_down)
+		ret = -ESHUTDOWN;
+	else if (lanes != 0 && lanes != 1 && lanes != 2 && lanes != 4)
+		ret = -EINVAL;
+	else {
+		opts.dp.lanes = lanes;
+		ret = phy_configure(dptx->atcphy, &opts);
+	}
+	if (!ret)
+		dptx->lane_count = lanes;
+	ret = dptxport_tunnel_reply(dptx, reply, size, ret);
+	mutex_unlock(&dptx->phy_lock);
+	return ret;
+}
+
+static int dptxport_tunnel_power(struct dptx_port *dptx, bool on,
+				   const void *data, size_t data_size,
+				   void *reply, size_t size)
+{
+	int ret = 0;
+
+	if (size < sizeof(__le32))
+		return -EINVAL;
+	memset(reply, 0, size);
+	memcpy(reply, data, min(size, data_size));
+	mutex_lock(&dptx->phy_lock);
+	if (!dptx->phy_initialized || (on && dptx->tearing_down))
+		ret = -ESHUTDOWN;
+	else if (on && !dptx->phy_powered) {
+		ret = phy_power_on(dptx->atcphy);
+		if (!ret)
+			dptx->phy_powered = true;
+	} else if (!on && dptx->phy_powered) {
+		ret = phy_power_off(dptx->atcphy);
+		if (!ret) {
+			dptx->phy_powered = false;
+			dptx->link_rate = dptx->pending_link_rate = 0;
+			dptx->lane_count = 0;
+		}
+	}
+	ret = dptxport_tunnel_reply(dptx, reply, size, ret);
+	mutex_unlock(&dptx->phy_lock);
+	return ret;
+}
+
 static int dptxport_call_get_max_link_rate(struct apple_epic_service *service,
 					   void *reply_, size_t reply_size)
 {
@@ -257,15 +429,9 @@ static int dptxport_call_get_max_lane_count(struct apple_epic_service *service,
 	if (reply_size < sizeof(*reply))
 		return -EINVAL;
 
-	/*
-	 * Experiment 2: a tunnelled connector has no ATC PHY attached (the ACIO
