+ assert(!a.tunnel_rate[0] && !a.tunnel_fault && mmio[0x7000/4]==0);
+ assert(mmio[0x2080/4]==0 && mmio[0x2200/4]==0);
+ assert(!apple_atcphy_dp_tunnel_put(&p,0)); groups++;
+ reset(&a,&p,&d); assert(!apple_atcphy_dp_tunnel_get(&p,0));
+ fail_command=0x2000;
