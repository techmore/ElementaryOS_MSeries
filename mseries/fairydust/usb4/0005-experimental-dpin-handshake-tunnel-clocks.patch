+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0 OR BSD-2-Clause
+"""Check compiled DP-IN wiring and the unaffected control board, without hardware."""
+import pathlib,struct,sys
+
+def parse(path):
+ data=pathlib.Path(path).read_bytes()
+ h=struct.unpack_from('>10I',data);assert h[0]==0xd00dfeed
+ pos=h[2];strings=data[h[3]:h[3]+h[8]];stack=[];nodes={}
+ while True:
+  tok=struct.unpack_from('>I',data,pos)[0];pos+=4
+  if tok==1:
+   end=data.index(b'\0',pos);name=data[pos:end].decode();pos=(end+4)&~3
+   stack.append(name);nodes['/'+ '/'.join(stack[1:])]={}
+  elif tok==2:stack.pop()
+  elif tok==3:
+   size,off=struct.unpack_from('>II',data,pos);pos+=8
+   key=strings[off:strings.index(b'\0',off)].decode()
+   nodes['/'+'/'.join(stack[1:])][key]=data[pos:pos+size];pos=(pos+size+3)&~3
+  elif tok==4:pass
+  elif tok==9:return nodes
+  else:raise ValueError(tok)
+
+def cells(value):return struct.unpack('>'+str(len(value)//4)+'I',value)
+
+def check(path,enabled):
+ n=parse(path);d={p:v for p,v in n.items() if v.get('compatible')==b'apple,t6000-dpin\0'}
+ assert len(d)==2,(path,list(d))
+ for p,v in d.items():
+  i=cells(v['apple,transport-index'])[0];assert i in [0,1]
+  off,size=cells(v['reg']);assert off==0xe50000+i*0x8000 and size==0x4000
+  parent=n[p.rsplit('/',1)[0]];ranges=cells(parent['ranges'])
+  assert ranges[:4]==(0,0xb,0x01000000,0x1000000)
+  assert ((ranges[1]<<32)+ranges[2]+off)==0xb01e50000+i*0x8000
+  assert cells(v['interrupts'])[-2:]==(1354+i,4)
+  assert cells(v['#phy-cells'])==(0,)
+  atc,phytype=cells(v['phys']);assert phytype==6
+  owner=next(w for w in n.values() if w.get('phandle')==struct.pack('>I',atc))
+  assert cells(owner['reg'])[:2]==(0xb,0x03000000)
+  assert v['status']==(b'okay\0' if enabled and i==0 else b'disabled\0')
+ tunneled=[v for v in n.values() if 'apple,dp-tunnel' in v]
+ assert len(tunneled)==int(enabled)
+ if enabled:
+  provider=next(v for v in d.values() if cells(v['apple,transport-index'])==(0,))
+  assert tunneled[0]['phys']==provider['phandle']
+  assert cells(tunneled[0]['mux-controls'])[-1]==1
+ print('PASS: compiled DP-IN wiring',pathlib.Path(path).name,'enabled='+str(enabled))
+check(sys.argv[1],True);check(sys.argv[2],False)
