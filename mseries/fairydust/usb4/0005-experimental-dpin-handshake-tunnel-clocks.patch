 	if (!dptx->atcphy) {
-		dptx->lane_count = 4;
-		reply->retcode = cpu_to_le32(0);
-		reply->lane_count = cpu_to_le64(dptx->lane_count);
+		reply->retcode = cpu_to_le32(1);
+		reply->lane_count = 0;
 		return 0;
 	}
 
@@ -310,6 +476,12 @@ static int dptxport_call_set_active_lane_count(struct apple_epic_service *servic
 
 	u64 lane_count = le64_to_cpu(request->lane_count);
 
+	if (dcp->dp_tunnel) {
+		ret = dptxport_tunnel_lanes(dptx, lane_count, reply, reply_size);
+		reply->lane_count = cpu_to_le64(dptx->lane_count);
