+	}
+
 	if (dptx->lane_count < lane_count)
 		dev_err(dcp->dev, "set_active_lane_count: unexpected lane "
 			"count:%llu phy: %d\n", lane_count, dptx->lane_count);
@@ -433,6 +605,14 @@ static int dptxport_call_set_link_rate(struct apple_epic_service *service,
 		break;
 	}
 
+	if (service->ep->dcp->dp_tunnel) {
+		if (!phy_set_rate)
+			return dptxport_tunnel_reply(dptx, reply, reply_size, -EINVAL);
+		ret = dptxport_tunnel_rate(dptx, link_rate, phy_link_rate, reply, reply_size);
+		reply->link_rate = cpu_to_le32(dptx->link_rate);
+		return ret;
+	}
+
 	if (phy_set_rate) {
 		dptx->phy_ops.dp.link_rate = phy_link_rate;
 		dptx->phy_ops.dp.set_rate = 1;
@@ -464,7 +644,7 @@ static int dptxport_call_get_supports_hpd(struct apple_epic_service *service,
 		return -EINVAL;
 
 	reply->retcode = cpu_to_le32(0);
-	reply->supported = cpu_to_le32(0);
+	reply->supported = cpu_to_le32(service->ep->dcp->dp_tunnel);
 	return 0;
 }
 
@@ -490,6 +670,10 @@ dptxport_call_activate(struct apple_epic_service *service,
 	struct dptx_port *dptx = service->cookie;
 	const struct apple_dcp *dcp = service->ep->dcp;
 
+	if (dcp->dp_tunnel)
+		return dptxport_tunnel_power(dptx, true, data, data_size,
+					    reply, reply_size);
+
 	// TODO: hack, use phy_set_mode to select the correct DCP(EXT) input
 	// for standalone phy (i.e. not atc phy).
 	if (!dcp->typec_mux)
@@ -509,6 +693,10 @@ dptxport_call_deactivate(struct apple_epic_service *service,
 {
 	struct dptx_port *dptx = service->cookie;
 
+	if (service->ep->dcp->dp_tunnel)
+		return dptxport_tunnel_power(dptx, false, data, data_size,
+					    reply, reply_size);
+
 	/* deactivate phy */
 	phy_set_mode_ext(dptx->atcphy, PHY_MODE_INVALID, 0);
 
@@ -526,6 +714,19 @@ static int dptxport_call(struct apple_epic_service *service, u32 idx,
 	struct dptx_port *dptx = service->cookie;
 	trace_dptxport_apcall(dptx, idx, data_size);
 
+	if (service->ep->dcp->dp_tunnel &&
+	    (idx == DPTX_APCALL_DEVICE_NOT_RESPONDING ||
+	     idx == DPTX_APCALL_DEVICE_NOT_STARTED ||
+	     idx == DPTX_APCALL_INACTIVE_SINK_DETECTED))
+		return dptxport_tunnel_reply(dptx, reply, reply_size, -ENOLINK);
+
+	if (service->ep->dcp->dp_tunnel && idx == DPTX_APCALL_FORCE_HOTPLUG_DETECT) {
+		if (!READ_ONCE(dptx->phy_initialized) || READ_ONCE(dptx->tearing_down))
+			return dptxport_tunnel_reply(dptx, reply, reply_size, -ESHUTDOWN);
+		schedule_work(&dptx->hpd_work);
+		return dptxport_tunnel_reply(dptx, reply, reply_size, 0);
