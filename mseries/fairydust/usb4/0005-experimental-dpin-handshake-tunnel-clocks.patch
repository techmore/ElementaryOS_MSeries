+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0 OR BSD-2-Clause
+"""Run the actual EPIC connection command builders with a fake transport."""
+import pathlib,subprocess,sys,tempfile
+s=pathlib.Path(sys.argv[1]).resolve();t=(s/'drivers/gpu/drm/apple/dptxep.c').read_text()
+packet=t[t.index('struct dcpdptx_connection_cmd {'):t.index('struct dcpdptx_hotplug_cmd')]
+func=t[t.index('int dptxport_validate_connection('):t.index('int dptxport_request_display(')]
+pre=r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+#include <errno.h>
+typedef uint8_t u8; typedef uint32_t u32; typedef uint32_t __le32;
+#define GENMASK(h,l) ((~0U >> (31-(h))) & (~0U << (l)))
+#define BIT(n) (1U<<(n))
+#define FIELD_PREP(m,v) (((u32)(v)<<__builtin_ctz(m))&(m))
+#define DCPDPTX_REMOTE_PORT_CORE GENMASK(3,0)
+#define DCPDPTX_REMOTE_PORT_ATC GENMASK(7,4)
+#define DCPDPTX_REMOTE_PORT_DIE GENMASK(11,8)
+#define DCPDPTX_REMOTE_PORT_CONNECTED BIT(15)
+#define cpu_to_le32(x) (x)
+#define le32_to_cpu(x) (x)
+#define trace_dptxport_validate_connection(d,c,a,i) ((void)(d))
+#define trace_dptxport_connect(d,c,a,i) ((void)(d))
+#define dev_notice(...) ((void)0)
+struct dptx_port { int unused; };
+struct dcp { bool dp_tunnel; void *dev; };
+struct ep { struct dcp *dcp; };
+struct apple_epic_service { void *cookie; struct ep *ep; };
+static unsigned int got_low,got_target,got_cmd;
+static int transport_error,corrupt_target,corrupt_low;
+static int afk_service_call(struct apple_epic_service *s,unsigned int group,unsigned int cmd,
+                           void *tx,size_t txlen,unsigned int txoff,
+                           void *rx,size_t rxlen,unsigned int rxoff) {
+ (void)s;assert(group==0 && (cmd==11 || cmd==12));
+ assert(txlen==8 && rxlen==8 && txoff==rxoff);
+ assert(txoff==(cmd==11?24:40));
+ got_cmd=cmd;got_low=((u32 *)tx)[0];got_target=((u32 *)tx)[1];
+ memcpy(rx,tx,8);((u32 *)rx)[0]^=corrupt_low;((u32 *)rx)[1]^=corrupt_target;
+ return transport_error;
+}
+'''
+post=r'''
+int main(void) {
+ struct dcp d={.dp_tunnel=true};struct ep ep={&d};struct dptx_port p={0};
+ struct apple_epic_service s={&p,&ep};int groups=0;
+ assert(!dptxport_connect(&s,0,1,0));
+ assert(got_cmd==11 && got_low==0x101 && got_target==0x8010);groups++;
+ assert(!dptxport_validate_connection(&s,0,1,0));
+ assert(got_cmd==12 && got_low==0x101);groups++;
+ d.dp_tunnel=false;assert(!dptxport_connect(&s,0,1,0) && got_low==0);
+ assert(!dptxport_validate_connection(&s,0,1,0) && got_low==0x100);groups++;
+ d.dp_tunnel=true;transport_error=-EIO;
+ assert(dptxport_connect(&s,0,1,0)==-EIO);transport_error=0;groups++;
+ corrupt_target=1;assert(dptxport_connect(&s,0,1,0)==-EINVAL);
+ assert(dptxport_validate_connection(&s,0,1,0)==-EINVAL);corrupt_target=0;groups++;
+ corrupt_low=1;assert(dptxport_connect(&s,0,1,0)==-EPROTO);
+ assert(dptxport_validate_connection(&s,0,1,0)==-EINVAL);corrupt_low=0;groups++;
+ assert(!dptxport_connect(&s,2,3,1) && got_target==0x8132);groups++;
+ printf("PASS: %d offline production-EPIC test groups\n",groups);return 0;
+}
+'''
+with tempfile.TemporaryDirectory(prefix='apple-dpin-epic-') as tmp:
+ c=pathlib.Path(tmp)/'test.c';exe=pathlib.Path(tmp)/'test';c.write_text(pre+packet+func+post)
+ subprocess.run(['gcc','-std=c11','-Wall','-Wextra','-Werror','-fsanitize=undefined',str(c),'-o',str(exe)],check=True)
+ subprocess.run([str(exe)],check=True)
