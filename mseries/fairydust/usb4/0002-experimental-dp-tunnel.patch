 };
diff -ruN a/drivers/gpu/drm/apple/connector.c b/drivers/gpu/drm/apple/connector.c
--- a/drivers/gpu/drm/apple/connector.c	2026-10-15 13:06:14.536816499 -0400
+++ b/drivers/gpu/drm/apple/connector.c	2026-10-15 13:06:38.072061535 -0400
@@ -15,6 +15,26 @@
 #include <drm/drm_managed.h>
 
 #include "dcp-internal.h"
+#include "dcp.h"
+
+/*
+ * Experimental: force the display controller's DPTX endpoint for this connector
+ * to start/stop driving its link, bypassing the usual Type-C alt-mode or DCP
+ * hot-plug trigger. Needed to drive the ACIO DP IN adapter for the USB4 DP
+ * tunnel experiment (see mseries/fairydust/usb4/DP-TUNNEL-RE.md).
+ *
+ *   echo 1 > .../force_link   # dcp_dptx_connect_oob()
+ *   echo 0 > .../force_link   # dcp_dptx_disconnect_oob()
+ */
+static int dcp_force_link_set(void *data, u64 val)
+{
+	struct apple_connector *apple_con = data;
+
+	if (val)
+		return dcp_dptx_connect_oob(apple_con->dcp, 0);
+	return dcp_dptx_disconnect_oob(apple_con->dcp, 0);
+}
+DEFINE_DEBUGFS_ATTRIBUTE(dcp_force_link_fops, NULL, dcp_force_link_set, "%llu\n");
 
 enum dcp_chunk_type {
 	DCP_CHUNK_COLOR_ELEMENTS,
