diff -ruN a/drivers/thunderbolt/quirks.c b/drivers/thunderbolt/quirks.c
--- a/drivers/thunderbolt/quirks.c	2026-10-15 14:43:37.137701820 -0400
+++ b/drivers/thunderbolt/quirks.c	2026-10-15 14:43:40.545920894 -0400
@@ -7,6 +7,22 @@
 
 #include "tb.h"
 
+/*
+ * Experimental knob for Apple Silicon USB4 DP tunneling.
+ *
+ * On Apple host routers the DP IN adapters are only fed once the display
+ * controller drives them through the display crossbar
+ * (see mseries/fairydust/usb4/DP-TUNNEL-RE.md). Until that is wired up the
+ * default quirk below skips DP tunneling entirely, which avoids ~300 DPRX
+ * read timeouts per tunnel attempt. Set allow_dp_tunnel=1 (or boot with
+ * thunderbolt.allow_dp_tunnel=1) to leave DP tunneling enabled so the
+ * experiment can run.
+ */
+static bool allow_dp_tunnel;
+module_param(allow_dp_tunnel, bool, 0644);
+MODULE_PARM_DESC(allow_dp_tunnel,
+	"leave DP tunneling enabled on Apple host routers (experimental)");
+
 static void quirk_force_power_link(struct tb_switch *sw)
 {
 	sw->quirks |= QUIRK_FORCE_POWER_LINK_CONTROLLER;
@@ -54,6 +70,10 @@
 
 static void quirk_no_dp_tunnel(struct tb_switch *sw)
 {
+	if (allow_dp_tunnel) {
+		tb_sw_dbg(sw, "leaving DP tunneling enabled\n");
+		return;
+	}
 	sw->quirks |= QUIRK_NO_DP_TUNNEL;
 	tb_sw_dbg(sw, "disabling DP tunneling\n");
 }
