+/*
+ * NHI source workers call these without the TB domain lock. device_lock
+ * serializes against platform remove; component readiness is checked below.
+ */
+int apple_dcp_dp_source_start(struct device_node *node)
+{
+	struct platform_device *pdev;
+	struct apple_dcp *dcp;
+	struct dptx_port *dptx;
+	int ret;
+
+	pdev = of_find_device_by_node(node);
+	if (!pdev)
+		return -EPROBE_DEFER;
+	device_lock(&pdev->dev);
+	dcp = platform_get_drvdata(pdev);
+	if (!device_is_bound(&pdev->dev) || !dcp) {
+		ret = -EAGAIN;
+		goto out_device;
+	}
+	mutex_lock(&dcp->dp_source_lock);
+	if (dcp->dp_source_removing || !dcp->connector || !dcp->active ||
+	    !dcp->dptxep || !dcp->dptxport[0].enabled) {
+		ret = -EAGAIN;
+		goto out;
+	}
+	if (dcp->crashed) {
+		ret = -ENODEV;
+		goto out;
+	}
+	if (!dcp->dp_tunnel || !dcp->phy) {
+		ret = -EINVAL;
+		goto out;
+	}
+	ret = dcp_dptx_connect_source(dcp, 0, true);
+	if (ret)
+		goto out;
+	dptx = &dcp->dptxport[0];
+	mutex_lock(&dptx->phy_lock);
+	ret = READ_ONCE(dptx->link_error);
+	if (!ret && (!dptx->phy_initialized || !dptx->phy_powered ||
+		     !dptx->link_rate || !dptx->lane_count))
+		ret = -EINPROGRESS;
+	mutex_unlock(&dptx->phy_lock);
+out:
+	mutex_unlock(&dcp->dp_source_lock);
+out_device:
+	device_unlock(&pdev->dev);
+	put_device(&pdev->dev);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(apple_dcp_dp_source_start);
+
+int apple_dcp_dp_source_stop(struct device_node *node)
+{
+	struct platform_device *pdev;
+	struct apple_dcp *dcp;
+	int ret = 0;
+
+	pdev = of_find_device_by_node(node);
+	if (!pdev)
+		return 0;
+	device_lock(&pdev->dev);
+	dcp = platform_get_drvdata(pdev);
+	/* Unbind already tears down the tunnel before stopping its endpoint. */
+	if (device_is_bound(&pdev->dev) && dcp) {
+		mutex_lock(&dcp->dp_source_lock);
+		if (!dcp->dp_source_removing && dcp->connector &&
+		    dcp->dp_tunnel && dcp->dptxep)
+			ret = dcp_dptx_disconnect_oob(pdev, 0);
+		else if (READ_ONCE(dcp->dptxport[0].phy_initialized))
+			ret = -EBUSY;
+		mutex_unlock(&dcp->dp_source_lock);
+	}
+	device_unlock(&pdev->dev);
+	put_device(&pdev->dev);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(apple_dcp_dp_source_stop);
