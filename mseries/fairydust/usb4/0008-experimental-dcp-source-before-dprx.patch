+struct apple_nhi { struct device *dev; struct tb_nhi nhi; struct apple_dp_source dp_source; };
+#define nhi_to_anhi(p) container_of(p,struct apple_nhi,nhi)
+struct tb { struct tb_nhi *nhi; struct workqueue_struct *wq; struct mutex lock; };
+struct tb_switch { unsigned int route; int refs; };
+struct ida { int dummy; };
