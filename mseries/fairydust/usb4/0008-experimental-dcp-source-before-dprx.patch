+#include <string.h>
+typedef uint8_t u8; typedef uint32_t u32; typedef long long ktime_t;
+#define EPROBE_DEFER 517
+#define container_of(p,t,m) ((t *)((char *)(p)-offsetof(t,m)))
+struct work_struct { int dummy; };
+struct delayed_work { struct work_struct work; };
+#define to_delayed_work(p) container_of(p,struct delayed_work,work)
+struct mutex { int depth; };
+static void mutex_lock(struct mutex *m) { assert(!m->depth); m->depth++; }
+static void mutex_unlock(struct mutex *m) { assert(m->depth==1); m->depth--; }
+struct device_node { int dummy; }; struct device { int dummy; };
+struct workqueue_struct { int dummy; };
+struct tb_nhi;
+struct tb_nhi_ops {
+ int (*dp_source_get)(struct tb_nhi *,u8,bool);
+ int (*dp_source_status)(struct tb_nhi *,u8);
+ void (*dp_source_put)(struct tb_nhi *,u8);
+};
+struct tb_nhi { const struct tb_nhi_ops *ops; };
