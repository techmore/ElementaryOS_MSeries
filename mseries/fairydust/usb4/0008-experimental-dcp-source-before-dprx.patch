+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only OR MIT
+"""Run actual NHI source worker/hooks and DPRX gate with deterministic stubs."""
+import pathlib, subprocess, sys, tempfile
+root = pathlib.Path(sys.argv[1]).resolve()
+a = (root/'drivers/thunderbolt/apple.c').read_text()
+t = (root/'drivers/thunderbolt/tunnel.c').read_text()
+dprx_worker=t[t.index('static void tb_dp_dprx_work(struct work_struct *work)\n{'):t.index('static int tb_dp_dprx_start(')]
+sw=(root/'drivers/thunderbolt/switch.c').read_text()
+hopid=sw[sw.index('static int tb_port_alloc_hopid('):sw.index('static inline bool tb_switch_is_reachable(')]
+start_dprx = t[t.index('static int tb_dp_dprx_start('):t.index('static void tb_dp_dprx_stop(')]
+worker = a[a.index('static void apple_dp_source_work('):a.index('/* Called after domain removal,', a.index('static void apple_dp_source_work('))]
+state = a[a.index('struct apple_dp_source {'):a.index('};', a.index('struct apple_dp_source {'))+2]
+gate = t[t.index('static int tb_dp_wait_dprx('):t.index('static void tb_dp_dprx_work(',t.index('static int tb_dp_wait_dprx('))]
+activate = t[t.index('static int tb_dp_activate('):t.index('/**',t.index('static int tb_dp_activate('))]
+cm = (root/'drivers/thunderbolt/tb.c').read_text()
+destroy = cm[cm.index('static void tb_dp_tunnel_destroy(struct tb_tunnel *tunnel)\n{'):cm.index('static void tb_dp_tunnel_active(struct tb_tunnel *tunnel, void *data)\n{')]
+active_callback = cm[cm.index('static void tb_dp_tunnel_active(struct tb_tunnel *tunnel, void *data)\n{'):cm.index('static void tb_tunnel_one_dp(')]
+assert 'tb_domain_put(' not in active_callback
+assert active_callback.index('if (tunnel->dprx_canceled)') < active_callback.index('if (tb_tunnel_is_active(')
+alloc = cm[cm.index('static void tb_tunnel_one_dp('):cm.index('static void tb_tunnel_dp(')]
+assert 'tunnel->destroy = tb_dp_tunnel_destroy;' in alloc
+assert 'tb_domain_put(' not in alloc[alloc.index('err_reclaim_usb:'):]
+
+# Guard the DCP-specific preparation order as well as compiling it in-kernel.
+d = (root/'drivers/gpu/drm/apple/dcp.c').read_text()
