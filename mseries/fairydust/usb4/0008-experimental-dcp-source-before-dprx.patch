 static inline bool tb_switch_is_reachable(const struct tb_switch *parent,
diff --git a/drivers/thunderbolt/tb.c b/drivers/thunderbolt/tb.c
index d39d51d..53bb602 100644
--- a/drivers/thunderbolt/tb.c
+++ b/drivers/thunderbolt/tb.c
@@ -374,6 +374,9 @@ static int tb_enable_tmu(struct tb_switch *sw)
 	return tb_switch_tmu_enable(sw);
 }
 
+static void tb_dp_tunnel_destroy(struct tb_tunnel *tunnel);
+static void tb_dp_tunnel_active(struct tb_tunnel *tunnel, void *data);
+
 static void tb_switch_discover_tunnels(struct tb_switch *sw,
 				       struct list_head *list,
 				       bool alloc_hopids)
@@ -402,6 +405,21 @@ static void tb_switch_discover_tunnels(struct tb_switch *sw,
 			break;
 		}
 
+		if (tunnel && tb_tunnel_is_dp(tunnel)) {
+			struct tb *ref = tb_domain_get(tb);
+			int ret = tb_tunnel_start_dp_source(tunnel, tb_dp_tunnel_active, ref);
