+static void ida_free(struct ida *i,int id) { (void)i;assert(id>=0);freed_hopids++; }
+struct tb_hop { int in_hop_index,next_hop_index; };
+struct tb_path { struct tb_hop *hops; int path_length; };
+struct tb_tunnel {
+ struct tb *tb; struct tb_port *src_port,*dst_port;
+ struct tb_path **paths; void (*callback)(struct tb_tunnel *,void *);
+ bool dp_source_requested; ktime_t dprx_timeout; void *callback_data;
+ int state, refs; bool dprx_started,dprx_canceled; struct delayed_work dprx_work;
+};
+#define TB_TUNNEL_ACTIVATING 1
+#define TB_DPRX_WAIT_TIMEOUT 25
+#define TB_DPRX_POLL_DELAY 50
+static int active_changes,callback_count;
+static void tb_tunnel_put(struct tb_tunnel *t) { assert(t->refs>0);t->refs--; }
+static void tb_tunnel_set_active(struct tb_tunnel *t,bool v) { t->state=v?2:0;active_changes++; }
+static int dprx_timeout=12000;
+static bool busy;
+static int work_busy(struct work_struct *w) { (void)w;return busy; }
+static void tb_tunnel_get(struct tb_tunnel *t) { t->refs++; }
