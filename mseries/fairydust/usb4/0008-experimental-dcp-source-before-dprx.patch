 	bitmap_zero(dcp->iomfb_surfaces, DCP_MAX_PLANES);
 	if (!of_property_present(dev->of_node, "apple,iomfb-surfaces"))
diff --git a/drivers/thunderbolt/apple.c b/drivers/thunderbolt/apple.c
index f4b16f6..a2b4ff5 100644
--- a/drivers/thunderbolt/apple.c
+++ b/drivers/thunderbolt/apple.c
@@ -91,6 +91,7 @@
 #include <linux/property.h>
 #include <linux/reset.h>
 #include <linux/soc/apple/rtkit.h>
+#include <linux/soc/apple/dp-source.h>
 #include <linux/soc/apple/tunable.h>
 #include <linux/spinlock.h>
 #include <linux/types.h>
@@ -197,6 +198,22 @@ struct apple_cio {
 	struct apple_cio_altmode usb4_altmode;
 };
 
+struct apple_dp_source {
+	struct device_node *node;
+	struct workqueue_struct *wq;
+	struct delayed_work work;
+	struct mutex lock;
+	u32 port;
+	unsigned int users;
+	unsigned int generation;
+	unsigned long deadline;
+	int status;
+	bool attempted;
+	bool ready;
+	bool stop_pending;
+	bool failed;
+};
+
 /**
  * struct apple_nhi - Apple Native Host Interface
  * @dev: NHI device
@@ -211,6 +228,7 @@ struct apple_cio {
  * @rx_irqs: Receive ring interrupts indexed by HopID
  * @tx_irq_names: Names of the transmit ring interrupts
  * @rx_irq_names: Names of the receive ring interrupts
+ * @dp_source: Optional explicitly mapped host DisplayPort source
  * @nrings: Number of rings in each direction
  */
 struct apple_nhi {
@@ -226,6 +244,7 @@ struct apple_nhi {
 	int *rx_irqs;
 	const char **tx_irq_names;
 	const char **rx_irq_names;
+	struct apple_dp_source dp_source;
 	size_t nrings;
 };
 
@@ -516,6 +535,208 @@ static bool apple_nhi_add_links(struct tb_nhi *nhi)
 	return !!link;
 }
 
+/* Never call DCP/AFK with the TB lock or this state mutex held. */
+static void apple_dp_source_work(struct work_struct *work)
+{
+	struct apple_nhi *anhi = container_of(to_delayed_work(work),
+					    struct apple_nhi, dp_source.work);
+	struct apple_dp_source *source = &anhi->dp_source;
+	unsigned int generation;
+	int ret;
+
+	for (;;) {
+		mutex_lock(&source->lock);
+		if (source->stop_pending) {
+			if (source->attempted) {
+				mutex_unlock(&source->lock);
+				ret = apple_dcp_dp_source_stop(source->node);
+				mutex_lock(&source->lock);
+				if (ret) {
+					source->status = ret;
+					source->failed = true;
+					mutex_unlock(&source->lock);
+					dev_err(anhi->dev, "DP source stop failed: %d\n", ret);
+					return;
+				}
+			}
+			source->attempted = false;
+			source->ready = false;
+			source->stop_pending = false;
+		}
+		if (!source->users || source->failed || source->ready) {
+			mutex_unlock(&source->lock);
+			return;
+		}
+		generation = source->generation;
+		source->attempted = true;
+		mutex_unlock(&source->lock);
+
+		ret = apple_dcp_dp_source_start(source->node);
+
+		mutex_lock(&source->lock);
+		if (generation != source->generation || source->stop_pending) {
+			mutex_unlock(&source->lock);
+			continue;
+		}
+		if ((ret == -EAGAIN || ret == -EPROBE_DEFER || ret == -EINPROGRESS) &&
+		    time_before(jiffies, source->deadline)) {
+			source->status = -EINPROGRESS;
+			mutex_unlock(&source->lock);
+			queue_delayed_work(source->wq, &source->work, msecs_to_jiffies(50));
+			return;
+		}
+		if (ret) {
+			source->status = ret == -EAGAIN || ret == -EPROBE_DEFER ||
+					 ret == -EINPROGRESS ? -ETIMEDOUT : ret;
+			source->failed = true;
+			source->stop_pending = true;
+			mutex_unlock(&source->lock);
+			dev_err(anhi->dev, "DP source preparation failed: %d\n", ret);
+			continue;
+		}
+		source->ready = true;
+		source->status = 0;
+		mutex_unlock(&source->lock);
+		dev_info(anhi->dev, "DP source ready for host port %u before DPRX\n",
+			 source->port);
+		return;
+	}
+}
+
+static int apple_nhi_dp_source_get(struct tb_nhi *nhi, u8 port, bool async)
+{
+	struct apple_dp_source *source = &nhi_to_anhi(nhi)->dp_source;
+	int ret = 1;
+
+	if (!source->node)
+		return 0;
+	if (port != source->port)
+		return 0;
+	if (!async)
+		return -EOPNOTSUPP;
+	mutex_lock(&source->lock);
+	if (source->users == UINT_MAX) {
+		ret = -EOVERFLOW;
+	} else if (!source->users++) {
+		source->generation++;
+		source->status = -EINPROGRESS;
+		source->failed = false;
+		source->deadline = jiffies + msecs_to_jiffies(5000);
+		mod_delayed_work(source->wq, &source->work, 0);
+	}
+	mutex_unlock(&source->lock);
+	return ret;
+}
+
+static int apple_nhi_dp_source_status(struct tb_nhi *nhi, u8 port)
+{
+	struct apple_dp_source *source = &nhi_to_anhi(nhi)->dp_source;
+	int ret;
+
+	if (!source->node)
+		return 0;
+	if (port != source->port)
+		return -EOPNOTSUPP;
+	mutex_lock(&source->lock);
+	ret = source->users ? source->status : -ENOLINK;
+	mutex_unlock(&source->lock);
+	return ret;
+}
+
+static void apple_nhi_dp_source_put(struct tb_nhi *nhi, u8 port)
+{
+	struct apple_dp_source *source = &nhi_to_anhi(nhi)->dp_source;
+
+	if (!source->node || port != source->port)
+		return;
+	mutex_lock(&source->lock);
+	if (WARN_ON(!source->users))
+		goto out;
+	if (!--source->users) {
+		source->generation++;
+		source->status = -ENOLINK;
+		source->stop_pending = true;
+		mod_delayed_work(source->wq, &source->work, 0);
+	}
+out:
+	mutex_unlock(&source->lock);
+}
+
+/* Called after domain removal, outside tb->lock, before ACIO powers off. */
+static void apple_dp_source_shutdown(void *data)
+{
+	struct apple_nhi *anhi = data;
+	struct apple_dp_source *source = &anhi->dp_source;
+
+	if (!source->wq)
+		return;
+	mutex_lock(&source->lock);
+	source->users = 0;
+	source->generation++;
+	source->stop_pending = true;
+	mutex_unlock(&source->lock);
+	mod_delayed_work(source->wq, &source->work, 0);
+	flush_delayed_work(&source->work);
+	cancel_delayed_work_sync(&source->work);
+	destroy_workqueue(source->wq);
+	source->wq = NULL;
+	of_node_put(source->node);
+	source->node = NULL;
+}
+
+static int apple_dp_source_init(struct apple_nhi *anhi)
+{
+	struct apple_dp_source *source = &anhi->dp_source;
+	struct device_node *phy, *parent;
+	u32 index;
+	int ret;
+
+	if (!of_property_present(anhi->np, "apple,dp-source"))
+		return of_property_present(anhi->np, "apple,dp-in-port") ? -EINVAL : 0;
+	if (!of_property_present(anhi->np, "apple,dp-in-port"))
+		return -EINVAL;
+	source->node = of_parse_phandle(anhi->np, "apple,dp-source", 0);
+	if (!source->node) {
+		ret = -EINVAL;
+		goto put_source;
+	}
+	ret = of_property_read_u32(anhi->np, "apple,dp-in-port", &source->port);
+	if (ret || !source->port || source->port > U8_MAX ||
+	    !of_device_is_available(source->node) ||
+	    !of_property_read_bool(source->node, "apple,dp-tunnel")) {
+		ret = -EINVAL;
+		goto put_source;
+	}
+	/* The declared source must consume this ACIO's enabled DP-IN provider. */
+	phy = of_parse_phandle(source->node, "phys", 0);
+	parent = of_get_parent(phy);
+	ret = !phy || !of_device_is_compatible(phy, "apple,t6000-dpin") ||
+	      !of_device_is_available(phy) || parent != anhi->acio->np ||
+	      of_property_read_u32(phy, "apple,transport-index", &index) || index > 1 ||
+	      source->port != 5 + index ?
+	      -EINVAL : 0;
+	of_node_put(parent);
+	of_node_put(phy);
+	if (ret)
+		goto put_source;
+	mutex_init(&source->lock);
+	INIT_DELAYED_WORK(&source->work, apple_dp_source_work);
+	source->status = -ENOLINK;
+	source->wq = alloc_ordered_workqueue("apple-dp-source", WQ_FREEZABLE | WQ_MEM_RECLAIM);
+	if (!source->wq) {
+		ret = -ENOMEM;
+		goto put_source;
+	}
+	ret = devm_add_action_or_reset(anhi->dev, apple_dp_source_shutdown, anhi);
+	if (!ret)
+		return 0;
+put_source:
+	dev_warn(anhi->dev, "DP source disabled (%d); retaining USB4 data support\n", ret);
+	of_node_put(source->node);
+	source->node = NULL;
+	return 0;
+}
+
 static const struct tb_nhi_ops apple_nhi_ops = {
 	.request_ring_irq = apple_nhi_request_irq,
 	.release_ring_irq = apple_nhi_release_irq,
@@ -525,6 +746,9 @@ static const struct tb_nhi_ops apple_nhi_ops = {
 	.ring_interrupt_mask = apple_nhi_ring_interrupt_mask,
 	.ring_configure = apple_nhi_ring_configure,
 	.add_links = apple_nhi_add_links,
+	.dp_source_get = apple_nhi_dp_source_get,
+	.dp_source_status = apple_nhi_dp_source_status,
+	.dp_source_put = apple_nhi_dp_source_put,
 };
 
 static int apple_nhi_probe(struct platform_device *pdev)
@@ -546,6 +770,9 @@ static int apple_nhi_probe(struct platform_device *pdev)
 	anhi->np = pdev->dev.of_node;
 	anhi->acio = acio;
 	platform_set_drvdata(pdev, anhi);
+	ret = apple_dp_source_init(anhi);
+	if (ret)
+		goto err;
 
 	/*
 	 * Only 42 bits seem to be wired up for the IOVA space but this may be further
@@ -667,6 +894,7 @@ static void apple_nhi_remove(struct platform_device *pdev)
 
 	tb_domain_remove(anhi->tb);
 	wait_for_completion(&anhi->nhi.domain_released);
+	apple_dp_source_shutdown(anhi);
 }
 
 static const struct of_device_id apple_nhi_match[] = {
