 }
 
 static const struct component_ops dcp_comp_ops = {
@@ -1249,13 +1349,16 @@ static int dcp_platform_probe(struct platform_device *pdev)
 	dcp->dev = dev;
 	dcp->hw = *(struct apple_dcp_hw_data *)of_device_get_match_data(dev);
 
