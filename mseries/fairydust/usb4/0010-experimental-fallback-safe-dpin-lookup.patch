@@ -94,8 +94,10 @@ properties:
     $ref: /schemas/types.yaml#/definitions/phandle
     description: |
       Experimental display controller feeding the host DP-IN adapter selected
-      by apple,dp-in-port. Its phys must reference an enabled DP-IN provider
