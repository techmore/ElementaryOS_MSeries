diff --git a/drivers/phy/apple/dpin.c b/drivers/phy/apple/dpin.c
index 801551a..fd76df3 100644
--- a/drivers/phy/apple/dpin.c
+++ b/drivers/phy/apple/dpin.c
@@ -9,10 +9,12 @@
 #include <linux/phy/phy-apple-dpin.h>
 #include <linux/mutex.h>
 #include <linux/of.h>
+#include <linux/of_platform.h>
 #include <linux/phy/phy.h>
 #include <linux/phy/phy-apple-atc.h>
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
+#include <linux/slab.h>
 
 #include "dpin-handshake.h"
 
@@ -20,6 +22,7 @@ struct apple_dpin {
 	struct device *dev;
 	void __iomem *regs;
 	struct phy *atcphy;
+	struct phy *phy;
 	struct mutex lock;
 	struct blocking_notifier_head hpd_notifiers;
 	struct apple_dpin_io io;
@@ -239,6 +242,78 @@ static const struct phy_ops dpin_ops = {
 	.owner = THIS_MODULE,
 };
 
+struct apple_dpin_consumer {
+	struct device *dev;
+	struct phy *phy;
+};
+
+static void apple_dpin_consumer_release(void *data)
+{
+	struct apple_dpin_consumer *consumer = data;
+
+	phy_put(consumer->dev, consumer->phy);
+	kfree(consumer);
+}
+
+/* Preserve the ordinary "phys" wiring for kernels without DP-IN support. */
+struct phy *devm_apple_dpin_phy_get(struct device *dev, struct device_node *node)
+{
+	struct apple_dpin_consumer *consumer;
+	struct platform_device *pdev;
+	struct apple_dpin *dpin;
+	struct phy *phy;
+	int ret;
+
+	if (!node || !of_device_is_available(node) ||
+	    !of_device_is_compatible(node, "apple,t6000-dpin"))
+		return ERR_PTR(-EINVAL);
+
+	consumer = kzalloc(sizeof(*consumer), GFP_KERNEL);
+	if (!consumer)
+		return ERR_PTR(-ENOMEM);
+	pdev = of_find_device_by_node(node);
+	if (!pdev) {
+		ret = -EPROBE_DEFER;
+		goto free_consumer;
+	}
+
+	/* Do not race an incomplete probe or provider removal. */
+	device_lock(&pdev->dev);
+	dpin = platform_get_drvdata(pdev);
+	if (!device_is_bound(&pdev->dev) || !dpin || !dpin->phy) {
+		ret = -EPROBE_DEFER;
+		goto unlock_provider;
+	}
+	phy = dpin->phy;
+	if (!try_module_get(phy->ops->owner)) {
+		ret = -EPROBE_DEFER;
+		goto unlock_provider;
+	}
+	get_device(&phy->dev);
+	device_unlock(&pdev->dev);
+	put_device(&pdev->dev);
+
+	consumer->dev = dev;
+	consumer->phy = phy;
+	if (!device_link_add(dev, &phy->dev, DL_FLAG_STATELESS)) {
+		of_phy_put(phy);
+		ret = -ENOMEM;
+		goto free_consumer;
+	}
+	ret = devm_add_action_or_reset(dev, apple_dpin_consumer_release, consumer);
+	if (ret)
+		return ERR_PTR(ret);
+	return phy;
+
+unlock_provider:
+	device_unlock(&pdev->dev);
+	put_device(&pdev->dev);
+free_consumer:
+	kfree(consumer);
+	return ERR_PTR(ret);
+}
+EXPORT_SYMBOL_GPL(devm_apple_dpin_phy_get);
+
 int apple_dpin_get_hpd(struct phy *phy)
 {
 	struct apple_dpin *dpin;
@@ -330,7 +405,11 @@ static int dpin_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 	provider = devm_of_phy_provider_register(dev, of_phy_simple_xlate);
-	return PTR_ERR_OR_ZERO(provider);
+	if (IS_ERR(provider))
+		return PTR_ERR(provider);
+	dpin->phy = phy;
+	platform_set_drvdata(pdev, dpin);
+	return 0;
 }
 
 static const struct of_device_id dpin_of_match[] = {
