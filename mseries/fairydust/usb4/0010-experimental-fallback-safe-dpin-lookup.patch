diff --git a/tools/testing/apple-dpin/test-lookup.py b/tools/testing/apple-dpin/test-lookup.py
new file mode 100644
index 0000000..98e27d9
--- /dev/null
+++ b/tools/testing/apple-dpin/test-lookup.py
@@ -0,0 +1,122 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0 OR BSD-2-Clause
+"""Exercise the actual managed DP-IN getter with provider/refcount faults."""
+import pathlib
+import subprocess
+import sys
+import tempfile
+
+source = pathlib.Path(sys.argv[1]).resolve()
+text = (source / "drivers/phy/apple/dpin.c").read_text()
+production = text[text.index("struct apple_dpin_consumer {"):
+                  text.index("EXPORT_SYMBOL_GPL(devm_apple_dpin_phy_get);")]
+preamble = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#include <errno.h>
+#define EPROBE_DEFER 517
+#define GFP_KERNEL 0
+#define DL_FLAG_STATELESS 1
+#define ERR_PTR(v) ((void *)(intptr_t)(v))
+#define PTR_ERR(v) ((int)(intptr_t)(v))
+#define IS_ERR(v) ((uintptr_t)(v) >= (uintptr_t)-4095)
+struct device { bool locked, bound; int refs; };
+struct device_node { bool available, compatible; };
+struct phy_ops { void *owner; };
+struct phy { struct device dev; const struct phy_ops *ops; };
+struct apple_dpin { struct phy *phy; };
+struct platform_device { struct device dev; struct apple_dpin *data; };
+static struct device consumer_dev;
+static struct device_node node;
+static struct phy_ops ops;
+static struct phy provider_phy;
+static struct apple_dpin dpin;
+static struct platform_device pdev;
+static bool absent_provider, fail_alloc, fail_module, fail_link, fail_action;
+static int allocations, module_refs, links;
+static void (*release_action)(void *);
+static void *release_data;
+static bool of_device_is_available(struct device_node *n) { return n->available; }
+static bool of_device_is_compatible(struct device_node *n, const char *s)
+{ assert(!strcmp(s, "apple,t6000-dpin")); return n->compatible; }
+static void *kzalloc(size_t size, int flags)
+{ (void)flags; if (fail_alloc) return NULL; allocations++; return calloc(1, size); }
+static void kfree(void *p) { assert(p && allocations > 0); allocations--; free(p); }
+static struct platform_device *of_find_device_by_node(struct device_node *n)
+{ assert(n == &node); if (absent_provider) return NULL; pdev.dev.refs++; return &pdev; }
+static void device_lock(struct device *d) { assert(!d->locked); d->locked = true; }
+static void device_unlock(struct device *d) { assert(d->locked); d->locked = false; }
+static bool device_is_bound(struct device *d) { assert(d->locked); return d->bound; }
+static struct apple_dpin *platform_get_drvdata(struct platform_device *p)
+{ assert(p->dev.locked); return p->data; }
+static bool try_module_get(void *owner)
+{ assert(pdev.dev.locked && owner == &ops); if (fail_module) return false;
+  module_refs++; return true; }
+static void get_device(struct device *d)
+{ assert(pdev.dev.locked && d == &provider_phy.dev); d->refs++; }
+static void put_device(struct device *d) { assert(d->refs > 0); d->refs--; }
+static void *device_link_add(struct device *dev, struct device *provider, int flags)
+{ assert(dev == &consumer_dev && provider == &provider_phy.dev);
+  assert(flags == DL_FLAG_STATELESS && !pdev.dev.locked);
+  if (fail_link) return NULL;
+  links++; return &links; }
+static void of_phy_put(struct phy *p)
+{ assert(p == &provider_phy && module_refs > 0); module_refs--; put_device(&p->dev); }
+static void phy_put(struct device *dev, struct phy *p)
+{ assert(dev == &consumer_dev && links == 1); links--; of_phy_put(p); }
+static int devm_add_action_or_reset(struct device *dev, void (*action)(void *), void *data)
+{ assert(dev == &consumer_dev && !release_action);
+  if (fail_action) { action(data); return -ENOMEM; }
+  release_action = action; release_data = data; return 0; }
+'''
+tests = r'''
+static void balanced(void)
+{
+ assert(!allocations && !module_refs && !links && !provider_phy.dev.refs);
+ assert(!pdev.dev.refs && !pdev.dev.locked && !release_action);
+}
+static void reset(void)
+{
+ balanced(); memset(&pdev, 0, sizeof(pdev)); memset(&provider_phy, 0, sizeof(provider_phy));
+ node.available = node.compatible = pdev.dev.bound = true;
+ ops.owner = &ops; provider_phy.ops = &ops; dpin.phy = &provider_phy; pdev.data = &dpin;
+ absent_provider = fail_alloc = fail_module = fail_link = fail_action = false;
+}
+static void fails(int error)
+{
+ struct phy *p = devm_apple_dpin_phy_get(&consumer_dev, &node);
+ assert(IS_ERR(p) && PTR_ERR(p) == error); balanced();
+}
+int main(void)
+{
+ int groups = 0; struct phy *p;
+ reset(); p = devm_apple_dpin_phy_get(&consumer_dev, &node);
+ assert(p == &provider_phy && allocations == 1 && module_refs == 1 && links == 1);
+ assert(provider_phy.dev.refs == 1 && !pdev.dev.refs && !pdev.dev.locked);
+ assert(release_action); release_action(release_data); release_action = NULL;
+ balanced(); groups++;
+ reset(); assert(PTR_ERR(devm_apple_dpin_phy_get(&consumer_dev, NULL)) == -EINVAL);
+ balanced(); node.available = false; fails(-EINVAL); groups++;
+ reset(); node.compatible = false; fails(-EINVAL); groups++;
+ reset(); fail_alloc = true; fails(-ENOMEM); groups++;
+ reset(); absent_provider = true; fails(-EPROBE_DEFER); groups++;
+ reset(); pdev.dev.bound = false; fails(-EPROBE_DEFER); groups++;
+ reset(); pdev.data = NULL; fails(-EPROBE_DEFER); groups++;
+ reset(); dpin.phy = NULL; fails(-EPROBE_DEFER); groups++;
+ reset(); fail_module = true; fails(-EPROBE_DEFER); groups++;
+ reset(); fail_link = true; fails(-ENOMEM); groups++;
+ reset(); fail_action = true; fails(-ENOMEM); groups++;
+ printf("PASS: %d production managed-PHY lookup groups\n", groups); return 0;
+}
+'''
+with tempfile.TemporaryDirectory(prefix="apple-dpin-lookup-") as tmp:
+    c = pathlib.Path(tmp) / "test.c"
+    exe = pathlib.Path(tmp) / "test"
+    c.write_text(preamble + production + tests)
+    subprocess.run(["gcc", "-std=c11", "-Wall", "-Wextra", "-Werror",
+                    "-fsanitize=undefined", str(c), "-o", str(exe)], check=True)
+    subprocess.run([str(exe)], check=True)
