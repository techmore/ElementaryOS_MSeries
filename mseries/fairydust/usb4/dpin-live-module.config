# Merge into /proc/config.gz for this kernel's C-module build only.
# Keep BTF_MODULES: it affects struct module layout even if BTF data is skipped.
CONFIG_USB4=m
CONFIG_USB4_APPLE_SOC=m
CONFIG_DRM_APPLE=m
CONFIG_PHY_APPLE_ATC=m
CONFIG_PHY_APPLE_DPIN=m
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
# CONFIG_RUST is not set
# CONFIG_LOCALVERSION_AUTO is not set
