# Fairydust kernel for Apple Silicon, packaged for Asahi ALARM.
# Adapted from Grzegorz Smajdor's kit (GPL-2.0); builds the Asahi
# `fairydust` branch snapshot directly (no patch), coexisting with stock
# linux-asahi. Target: apple,j314s (M1 Pro 14"), Asahi 7.1.13-3.
# See ../USB-C-DOCK-DP-ALT-MODE.md and ./README.md.

pkgbase=linux-asahi-fairydust
pkgname=("$pkgbase")
pkgver=7.1.13.fairydust
pkgrel=1
pkgdesc="Asahi Linux kernel with experimental Fairydust USB-C DisplayPort support"
arch=('aarch64')
url="https://github.com/AsahiLinux/linux/tree/fairydust"
license=('GPL2')

makedepends=(
  base-devel bc dtc kmod libelf pahole cpio perl rustup rust-bindgen
  tar xz xmlto python
)
depends=(coreutils kmod initramfs 'm1n1')
optdepends=(
  'crda: set the wireless regulatory domain'
  'linux-firmware: firmware for additional devices'
)
provides=(WIREGUARD-MODULE 'linux=7.1.13')
options=('!strip' '!debug')

_srcname=linux-fairydust
source=(
  'https://github.com/AsahiLinux/linux/archive/refs/heads/fairydust.tar.gz'
  config
)
sha256sums=('SKIP' 'SKIP')

export KBUILD_BUILD_HOST=archlinux
export KBUILD_BUILD_USER=$pkgbase
export KBUILD_BUILD_TIMESTAMP="$(date -Ru${SOURCE_DATE_EPOCH:+d @$SOURCE_DATE_EPOCH})"

prepare() {
  cd "$_srcname"
  # Keep this kernel alongside stock linux-asahi with a distinct release.
  echo '-1-1-fairydust' > localversion.10-pkgrel

  mkdir -p build/base
  cp ../config build/base/.config

  scripts/config --file build/base/.config --module TYPEC_DP_ALTMODE
  scripts/config --file build/base/.config --module TYPEC_NVIDIA_ALTMODE
  scripts/config --file build/base/.config --module TYPEC_TBT_ALTMODE

  make olddefconfig prepare O="$PWD/build/base"
  make -s kernelrelease O="$PWD/build/base" > build/base/version
  printf 'Prepared %s version %s\n' "$pkgbase" "$(<build/base/version)"
}

build() {
  cd "$_srcname"
  make all O="$PWD/build/base" -j "$(nproc)"
}

package() {
  cd "$_srcname"
  local output="$PWD/build/base"
  local kernver
  kernver="$(<"$output/version")"
  local modulesdir="$pkgdir/usr/lib/modules/$kernver"

  install -Dm644 "$output/arch/arm64/boot/Image" "$modulesdir/vmlinuz"
  printf '%s\n' "$pkgbase" | install -Dm644 /dev/stdin "$modulesdir/pkgbase"

  make O="$output" INSTALL_MOD_PATH="$pkgdir/usr" \
    INSTALL_MOD_STRIP=1 modules_install

  install -Dt "$modulesdir/dtbs" "$output"/arch/arm64/boot/dts/apple/*.dtb
  rm -f "$modulesdir/source" "$modulesdir/build"
}

# vim:set ts=8 sts=2 sw=2 et:
