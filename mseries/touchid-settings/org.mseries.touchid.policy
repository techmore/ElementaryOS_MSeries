<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>ElementaryOS_MSeries</vendor>
  <action id="org.mseries.touchid.apply-pam">
    <description>Change which prompts accept a fingerprint</description>
    <message>Authentication is required to change which prompts accept Touch ID</message>
    <icon_name>fingerprint</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/mseries-aurora-touchid-apply-pam</annotate>
  </action>
</policyconfig>
